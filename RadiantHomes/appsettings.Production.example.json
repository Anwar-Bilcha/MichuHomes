// Production settings template (Michu Homes on MonsterASP, michuhomes.runasp.net). Not used by the app itself.
//
// Preferred: set these as environment variables in the hosting panel; they survive every deployment. A double
// underscore stands for a nested setting, e.g. ConnectionStrings__DefaultConnection, Authentication__Google__ClientId.
//
// Otherwise: copy this file to appsettings.Production.json in the site root on the server (next to RadiantHomes.dll),
// fill it in and remove these comments' placeholders. That file is git-ignored and is not part of the published files,
// so deployments don't overwrite it. Never commit real values.
//
// Only the connection string is required. Any feature whose keys are left empty is simply off (no Google/Facebook
// button, no SMS, no payments, no video calls); the startup log (Logs/log-YYYYMMDD.txt) lists what is off.
{
  "ConnectionStrings": {
    // From the hosting panel (Databases): SQL login, not Windows login.
    "DefaultConnection": "Server=<db server>;Database=<db name>;User Id=<db user>;Password=<db password>;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Authentication": {
    // Redirect URLs to register: https://michuhomes.runasp.net/signin-google and https://michuhomes.runasp.net/signin-facebook
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Facebook": {
      "AppId": "",
      "AppSecret": ""
    }
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "FromPhoneNumber": ""
  },
  "Chapa": {
    "PublicKey": "",
    "SecretKey": "",
    "EncryptionKey": ""
  },
  "Jaas": {
    // Video calls with agents (https://jaas.8x8.vc). PrivateKey is the PEM text (line breaks may be written as \n),
    // or upload the downloaded .pk file to App_Data and set PrivateKeyPath to "App_Data/<file>.pk".
    "AppId": "",
    "ApiKeyId": "",
    "PrivateKey": "",
    "PrivateKeyPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
