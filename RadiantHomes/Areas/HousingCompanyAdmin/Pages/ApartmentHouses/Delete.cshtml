@page
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.ApartmentHouses.DeleteModel

@{
    ViewData["Title"] = "Delete apartment";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<div class="card mh-confirm">
    <div class="card-header">
        <h2 class="mh-section-title text-reset"><i class="bi bi-exclamation-triangle text-reset" aria-hidden="true"></i> Are you sure you want to delete this apartment?</h2>
    </div>
    <div class="card-body">
        <p class="text-muted">This permanently removes the record below. It can't be undone.</p>
        <dl class="mh-dl">
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.Title)</dt>
            <dd>@Html.DisplayFor(model => model.ApartmentHouse.Title)</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.HouseNumber)</dt>
            <dd>@Html.DisplayFor(model => model.ApartmentHouse.HouseNumber)</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.Description)</dt>
            <dd>@Html.DisplayFor(model => model.ApartmentHouse.Description)</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.SalePrice)</dt>
            <dd>@Html.DisplayFor(model => model.ApartmentHouse.SalePrice)</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.HouseCategory)</dt>
            <dd>@(Model.ApartmentHouse.HouseCategory?.Name ?? "—")</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.AvailableFor)</dt>
            <dd>@Html.DisplayFor(model => model.ApartmentHouse.AvailableFor)</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.HouseAddress)</dt>
            <dd>@(Model.ApartmentHouse.HouseAddress?.FormattedAddressCompact ?? "—")</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.Status)</dt>
            <dd>@Html.DisplayFor(model => model.ApartmentHouse.Status)</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.HouseType)</dt>
            <dd>@(Enum.TryParse<HouseTypesCateg>(Model.ApartmentHouse.HouseType, out var houseType) ? houseType.GetDisplayName() : Model.ApartmentHouse.HouseType)</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.FloorNumber)</dt>
            <dd>@Html.DisplayFor(model => model.ApartmentHouse.FloorNumber)</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.Building)</dt>
            <dd>@(Model.ApartmentHouse.Building?.BuildingName ?? "—")</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.Project)</dt>
            <dd>@(Model.ApartmentHouse.Project?.ProjectName ?? "—")</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.HousingCompany)</dt>
            <dd>@(Model.ApartmentHouse.HousingCompany?.Name ?? "—")</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.CreatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.ApartmentHouse.CreatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.CreatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.ApartmentHouse.CreatedOn)</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.UpdatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.ApartmentHouse.UpdatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.ApartmentHouse.UpdatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.ApartmentHouse.UpdatedOn)</dd>
        </dl>

        <form method="post" class="mh-form-actions">
            <input type="hidden" asp-for="ApartmentHouse.Id" />
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash" aria-hidden="true"></i> Delete apartment</button>
        </form>
    </div>
</div>
