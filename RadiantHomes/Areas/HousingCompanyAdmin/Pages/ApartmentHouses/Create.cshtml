@page
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.ApartmentHouses.CreateModel

@{
    ViewData["Title"] = "New apartment";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<form method="post" enctype="multipart/form-data" class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Basic information</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="ApartmentHouse.Title" class="form-label">Title</label>
                    <input asp-for="ApartmentHouse.Title" class="form-control" placeholder="e.g., Luxury Condo in Bole" />
                    <span asp-validation-for="ApartmentHouse.Title" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ApartmentHouse.HouseNumber" class="form-label">House number</label>
                    <input asp-for="ApartmentHouse.HouseNumber" class="form-control" placeholder="e.g., APT-204" />
                    <span asp-validation-for="ApartmentHouse.HouseNumber" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="ApartmentHouse.Description" class="form-label">Description</label>
                    <textarea asp-for="ApartmentHouse.Description" class="form-control" placeholder="Describe the apartment..." rows="3"></textarea>
                    <span asp-validation-for="ApartmentHouse.Description" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ApartmentHouse.SalePrice" class="form-label">Sale price</label>
                    <input asp-for="ApartmentHouse.SalePrice" class="form-control" placeholder="e.g., 2500000" />
                    <span asp-validation-for="ApartmentHouse.SalePrice" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ApartmentHouse.HouseType" class="form-label">House type</label>
                    <input asp-for="ApartmentHouse.HouseType" class="form-control" placeholder="e.g., Condominium, Studio" />
                    <span asp-validation-for="ApartmentHouse.HouseType" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ApartmentHouse.FloorNumber" class="form-label">Floor number</label>
                    <input asp-for="ApartmentHouse.FloorNumber" class="form-control" placeholder="e.g., 3" />
                    <span asp-validation-for="ApartmentHouse.FloorNumber" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ApartmentHouse.AvailableFor" class="form-label">Available for</label>
                    <input asp-for="ApartmentHouse.AvailableFor" class="form-control" placeholder="e.g., Sale or Rent" />
                    <span asp-validation-for="ApartmentHouse.AvailableFor" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Ownership &amp; category</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="ApartmentHouse.HouseCategoryId" class="form-label">House category</label>
                    <select asp-for="ApartmentHouse.HouseCategoryId" class="form-select" asp-items="ViewBag.HouseCategoryId">
                        <option value="">Select House Category</option>
                    </select>
                    <span asp-validation-for="ApartmentHouse.HouseCategoryId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ApartmentHouse.AddressId" class="form-label">Address</label>
                    <select asp-for="ApartmentHouse.AddressId" class="form-select" asp-items="ViewBag.AddressId">
                        <option value="">Select Address</option>
                    </select>
                    <span asp-validation-for="ApartmentHouse.AddressId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ApartmentHouse.BuildingId" class="form-label">Building</label>
                    <select asp-for="ApartmentHouse.BuildingId" class="form-select" asp-items="ViewBag.BuildingId">
                        <option value="">Select Building</option>
                    </select>
                    <span asp-validation-for="ApartmentHouse.BuildingId" class="text-danger"></span>
                </div>
            </div>
        </div>

        <partial name="~/Pages/ApartmentHouses/_ApartmentModelField.cshtml" model="new RadiantHomes.Pages.ApartmentHouses.ApartmentModel3D.Field(null)" />

        <div class="mh-form-actions">
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save apartment</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
