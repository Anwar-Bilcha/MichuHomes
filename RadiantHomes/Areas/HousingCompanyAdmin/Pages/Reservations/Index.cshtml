@page
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.Reservations.IndexModel
@using RadiantHomes.Models.HousingCompanies
@using RadiantHomes.Pages.ApartmentHouses
@using RadiantHomes.Services.CustomerPortal
@{
    ViewData["Title"] = "Reservations";
    ViewData["Subtitle"] = "Customers who reserved your apartments. Approve or decline a reservation, record the sale (price, agent, payment), or cancel an approved one. The customer is notified each time.";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
    var tabs = new (string Key, string Label, int? Count)[]
    {
        ("pending", "Waiting", Model.Count(HouseReserveStatuses.Pending)),
        ("approved", "Approved", Model.Count(HouseReserveStatuses.Approved)),
        ("completed", "Sold", Model.Count(HouseReserveStatuses.Completed)),
        ("reversed", "Reversed", Model.Count(HouseReserveStatuses.Reversed)),
        ("declined", "Declined", Model.Count(HouseReserveStatuses.Rejected)),
        ("expired", "Expired", Model.Count(HouseReserveStatuses.Expired)),
        ("cancelled", "Cancelled", Model.Count(HouseReserveStatuses.Cancelled)),
        ("all", "All", null),
    };
    var current = Model.Filter switch
    {
        HouseReserveStatuses.Approved => "approved",
        HouseReserveStatuses.Completed => "completed",
        HouseReserveStatuses.Rejected => "declined",
        HouseReserveStatuses.Expired => "expired",
        HouseReserveStatuses.Cancelled => "cancelled",
        HouseReserveStatuses.Reversed => "reversed",
        null => "all",
        _ => "pending",
    };
}

<nav class="mh-segmented mb-3" aria-label="Reservation status">
    @foreach (var (key, label, count) in tabs)
    {
        <a class="@(current == key ? "active" : null)" asp-page="./Index" asp-route-status="@key" aria-current="@(current == key ? "page" : null)">
            @label @if (count is int n) { <span class="badge rounded-pill text-bg-light ms-1">@n</span> }
        </a>
    }
</nav>

@if (!Model.Items.Any())
{
    <div class="card">
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-calendar-check"></i></span>
            <h2>No reservations here</h2>
            <p>When customers reserve your apartments, they appear here.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Reservation</th>
                        <th scope="col">Apartment</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Items)
                    {
                        var a = t.ApartmentHouse;
                        var customer = t.Receiver;
                        var title = a?.Title ?? string.Empty;
                        var lastReason = t.History.OrderByDescending(h => h.ChangedOn).FirstOrDefault(h => !string.IsNullOrWhiteSpace(h.Reason))?.Reason;
                        <tr>
                            <td>
                                <div class="fw-semibold" translate="no">@t.Reference</div>
                                <div class="small text-muted">@t.TransactionDate.ToString("d MMM yyyy HH:mm")</div>
                                @if (t.Status == HouseReserveStatuses.Pending && t.ExpiresAt is DateTime exp)
                                {
                                    <div class="small @(exp < DateTime.UtcNow.AddHours(12) ? "text-danger" : "text-warning-emphasis")"><i class="bi bi-alarm" aria-hidden="true"></i> Answer by @exp.ToLocalTime().ToString("d MMM HH:mm")</div>
                                }
                            </td>
                            <td>
                                <a asp-area="" asp-page="/ApartmentHouses/Details" asp-route-id="@t.ApartmentHouseId" class="fw-semibold">@title</a>
                                <div class="small text-muted">@(string.Join(" · ", new[] { a?.Building?.Project?.ProjectName, a?.Building?.Project?.Company?.Name }.Where(s => !string.IsNullOrWhiteSpace(s))))</div>
                                <div class="small">@(a is { SalePrice: > 0 } ? ApartmentHouseForm.Price(a.SalePrice, a.Currency) : "Price not listed")</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@($"{customer?.FirstName} {customer?.LastName}".Trim())</div>
                                @if (!string.IsNullOrWhiteSpace(customer?.PhoneNumber)) { <a class="small d-block" href="tel:@customer.PhoneNumber">@customer.PhoneNumber</a> }
                                @if (!string.IsNullOrWhiteSpace(customer?.Email)) { <a class="small d-block" href="mailto:@customer.Email">@customer.Email</a> }
                                @if (!string.IsNullOrWhiteSpace(t.Notes)) { <div class="small text-muted mt-1"><i class="bi bi-chat-left-quote" aria-hidden="true"></i> @t.Notes</div> }
                            </td>
                            <td>
                                <span class="badge @ReservationService.Badge(t.Status)">@ReservationService.Label(t.Status)</span>
                                @if (lastReason is not null && t.Status is HouseReserveStatuses.Rejected or HouseReserveStatuses.Cancelled or HouseReserveStatuses.Expired) { <div class="small text-muted mt-1">@lastReason</div> }
                                @if (t.History.Count > 0)
                                {
                                    <details class="small mt-1"><summary class="text-muted">History</summary>
                                        <ol class="list-unstyled mb-0 mt-1">
                                            @foreach (var h in t.History.OrderBy(h => h.ChangedOn))
                                            {
                                                <li>@h.ChangedOn.ToLocalTime().ToString("d MMM HH:mm") · @ReservationService.Label(h.ToStatus) · @(h.ChangedByName ?? "—")</li>
                                            }
                                        </ol>
                                    </details>
                                }
                            </td>
                            <td class="text-end">
                                @if (t.Status is HouseReserveStatuses.Pending or HouseReserveStatuses.Approved)
                                {
                                    <form mh-permission="reservations.manage" method="post" asp-route-id="@t.Id" asp-route-status="@current" class="d-inline-flex flex-column align-items-end gap-1">
                                        <input class="form-control form-control-sm" style="min-width:12rem" name="Reason" maxlength="1000" placeholder="Reason (to decline or cancel)" aria-label="Reason for @t.Reference" />
                                        <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                            @if (t.Status == HouseReserveStatuses.Pending)
                                            {
                                                <button type="submit" class="btn btn-sm btn-primary" asp-page-handler="Approve" asp-route-id="@t.Id" asp-route-status="@current"><i class="bi bi-check2" aria-hidden="true"></i> Approve</button>
                                                <button type="submit" class="btn btn-sm btn-outline-danger" asp-page-handler="Reject" asp-route-id="@t.Id" asp-route-status="@current"><i class="bi bi-x-circle" aria-hidden="true"></i> Decline</button>
                                            }
                                            <a mh-permission="sales.record" class="btn btn-sm btn-success" asp-area="" asp-page="/Staff/Sales/Record" asp-route-id="@t.Id"><i class="bi bi-key" aria-hidden="true"></i> Record sale</a>
                                            @if (t.Status == HouseReserveStatuses.Approved)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger" asp-page-handler="Cancel" asp-route-id="@t.Id" asp-route-status="@current"><i class="bi bi-x-circle" aria-hidden="true"></i> Cancel</button>
                                            }
                                        </div>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
