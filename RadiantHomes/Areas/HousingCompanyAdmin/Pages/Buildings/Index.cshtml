@page
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.Buildings.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Building[0].BuildingName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Building[0].NumberOfFloors)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Building[0].BuildingType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Building[0].ConstructionStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Building[0].Project)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Building[0].CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Building[0].CreatedOn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Building[0].UpdatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Building[0].UpdatedOn)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Building) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.BuildingName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NumberOfFloors)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BuildingType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ConstructionStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Project.ProjectId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedOn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedOn)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
