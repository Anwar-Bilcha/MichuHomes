@page
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.Buildings.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-x..." crossorigin="anonymous" />

<div class="container mt-5 mb-5">
    <div class="card shadow-lg rounded-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fas fa-edit me-2"></i>Edit Building</h4>
            <a asp-page="./Index" class="btn btn-light btn-sm"><i class="fas fa-arrow-left me-1"></i>Back</a>
        </div>
        <div class="card-body">
            <div class="text-end">
                <a asp-page="/ApartmentHouses/Create" asp-route-id="@Model.Building.Id">Register Houses For this Building</a>
            </div>
            <form method="post" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Building.Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Building.ProjectId" class="form-label"><i class="fas fa-project-diagram me-1"></i>Project</label>
                        <select asp-for="Building.ProjectId" class="form-select" asp-items="ViewBag.ProjectId"></select>
                        <span asp-validation-for="Building.ProjectId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Building.BuildingName" class="form-label"><i class="fas fa-building me-1"></i>Building Name</label>
                        <input asp-for="Building.BuildingName" class="form-control" />
                        <span asp-validation-for="Building.BuildingName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Building.NumberOfFloors" class="form-label"><i class="fas fa-layer-group me-1"></i>Floors</label>
                        <input asp-for="Building.NumberOfFloors" class="form-control" type="number" min="1" />
                        <span asp-validation-for="Building.NumberOfFloors" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Building.BuildingType" class="form-label"><i class="fas fa-warehouse me-1"></i>Type</label>
                        <input asp-for="Building.BuildingType" class="form-control" />
                        <span asp-validation-for="Building.BuildingType" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Building.ConstructionStatus" class="form-label"><i class="fas fa-tools me-1"></i>Status</label>
                        <input asp-for="Building.ConstructionStatus" class="form-control" />
                        <span asp-validation-for="Building.ConstructionStatus" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Building.CreatedBy" class="form-label"><i class="fas fa-user me-1"></i>Created By</label>
                        <input asp-for="Building.CreatedBy" class="form-control" />
                        <span asp-validation-for="Building.CreatedBy" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Building.CreatedOn" class="form-label"><i class="fas fa-calendar-plus me-1"></i>Created On</label>
                        <input asp-for="Building.CreatedOn" class="form-control" type="datetime-local" />
                        <span asp-validation-for="Building.CreatedOn" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Building.UpdatedBy" class="form-label"><i class="fas fa-user-edit me-1"></i>Updated By</label>
                        <input asp-for="Building.UpdatedBy" class="form-control" />
                        <span asp-validation-for="Building.UpdatedBy" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Building.UpdatedOn" class="form-label"><i class="fas fa-calendar-alt me-1"></i>Updated On</label>
                        <input asp-for="Building.UpdatedOn" class="form-control" type="datetime-local" />
                        <span asp-validation-for="Building.UpdatedOn" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

