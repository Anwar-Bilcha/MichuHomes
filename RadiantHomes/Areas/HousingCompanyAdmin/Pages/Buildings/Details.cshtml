@page
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.Buildings.DetailsModel

@{
    ViewData["Title"] = "Building details";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

@section PageActions {
    <a class="btn btn-secondary" asp-page="./Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list</a>
    <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.Building.Id"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</a>
}

<div class="card">
    <div class="card-body">
        <dl class="mh-dl">
            <dt>@Html.DisplayNameFor(model => model.Building.BuildingName)</dt>
            <dd>@Html.DisplayFor(model => model.Building.BuildingName)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.NumberOfFloors)</dt>
            <dd>@Html.DisplayFor(model => model.Building.NumberOfFloors)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.BuildingType)</dt>
            <dd>@(Enum.TryParse<BuildingTypes>(Model.Building.BuildingType, out var buildingType) ? buildingType.GetDisplayName() : Model.Building.BuildingType)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.ConstructionStatus)</dt>
            <dd>@(Enum.TryParse<ConstructionStatuses>(Model.Building.ConstructionStatus, out var constructionStatus) ? constructionStatus.GetDisplayName() : Model.Building.ConstructionStatus)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.Project)</dt>
            <dd>@(Model.Building.Project?.ProjectName ?? "—")</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.Project.Company)</dt>
            <dd>@(Model.Building.Project?.Company?.Name ?? "—")</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.Address)</dt>
            <dd>@(Model.Building.Address?.FormattedAddressCompact ?? "—")</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.CreatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.Building.CreatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.CreatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.Building.CreatedOn)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.UpdatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.Building.UpdatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.UpdatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.Building.UpdatedOn)</dd>
        </dl>
    </div>
</div>
