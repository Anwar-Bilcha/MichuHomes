@page
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.Financial.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].BankName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].AccountNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].TaxId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].AnnualRevenue)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].IsPrimary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].TinNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].VatRegistrationNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].hasAuditedFinancialStatement)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].AuditedFinancialStatementUrl)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].Company)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].CreatedOn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].UpdatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].UpdatedOn)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.CompanyFinancialDetail) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.BankName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AccountNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TaxId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AnnualRevenue)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsPrimary)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TinNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VatRegistrationNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.hasAuditedFinancialStatement)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AuditedFinancialStatementUrl)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Company.CompanyId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedOn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedOn)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
