@page
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.Financial.IndexModel

@{
    ViewData["Title"] = "Financial details";
    ViewData["Subtitle"] = "Bank, tax and audit details recorded for housing companies.";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
    var hasRows = Model.CompanyFinancialDetail is not null && Model.CompanyFinancialDetail.Any();
}

@section PageActions {
    <a class="btn btn-primary" asp-page="Create">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> New financial detail
    </a>
}

<div class="card">
    @if (Model.NoCompany)
    {
        <partial name="~/Areas/HousingCompanyAdmin/Pages/_NoCompanyNotice.cshtml" />
    }
    else if (!hasRows)
    {
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-bank"></i></span>
            <h2>No financial details yet</h2>
            <p>Bank accounts and tax details appear here once they are added for a company.</p>
            <a class="btn btn-primary" asp-page="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> New financial detail</a>
        </div>
    }
    else
    {
        <div class="table-responsive position-relative">
            <table class="table table-hover align-middle mb-0 text-nowrap">
                <thead>
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].BankName)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].AccountNumber)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].TaxId)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].AnnualRevenue)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].IsPrimary)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].TinNumber)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].VatRegistrationNumber)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].hasAuditedFinancialStatement)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].AuditedFinancialStatementUrl)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].Company)</th>
                        <th scope="col" class="d-none d-xl-table-cell">@Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].CreatedBy)</th>
                        <th scope="col" class="d-none d-xl-table-cell">@Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].CreatedOn)</th>
                        <th scope="col" class="d-none d-xl-table-cell">@Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].UpdatedBy)</th>
                        <th scope="col" class="d-none d-xl-table-cell">@Html.DisplayNameFor(model => model.CompanyFinancialDetail[0].UpdatedOn)</th>
                        <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CompanyFinancialDetail!)
                    {
                        <tr>
                            <td class="fw-semibold">@Html.DisplayFor(modelItem => item.BankName)</td>
                            <td>@Html.DisplayFor(modelItem => item.AccountNumber)</td>
                            <td>@Html.DisplayFor(modelItem => item.TaxId)</td>
                            <td>@Html.DisplayFor(modelItem => item.AnnualRevenue)</td>
                            <td>@Html.DisplayFor(modelItem => item.IsPrimary)</td>
                            <td>@Html.DisplayFor(modelItem => item.TinNumber)</td>
                            <td>@Html.DisplayFor(modelItem => item.VatRegistrationNumber)</td>
                            <td>@Html.DisplayFor(modelItem => item.hasAuditedFinancialStatement)</td>
                            <td>@Html.DisplayFor(modelItem => item.AuditedFinancialStatementUrl)</td>
                            <td>@Html.DisplayFor(modelItem => item.Company.Name)</td>
                            <td class="d-none d-xl-table-cell">@Html.DisplayFor(modelItem => item.CreatedBy)</td>
                            <td class="d-none d-xl-table-cell">@Html.DisplayFor(modelItem => item.CreatedOn)</td>
                            <td class="d-none d-xl-table-cell">@Html.DisplayFor(modelItem => item.UpdatedBy)</td>
                            <td class="d-none d-xl-table-cell">@Html.DisplayFor(modelItem => item.UpdatedOn)</td>
                            <td class="text-end">
                                <div class="mh-row-actions">
                                    <a class="btn btn-sm btn-outline-secondary btn-icon" asp-page="./Details" asp-route-id="@item.Id" title="View details" aria-label="View details"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                    <a class="btn btn-sm btn-outline-primary btn-icon" asp-page="./Edit" asp-route-id="@item.Id" title="Edit" aria-label="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                    <a class="btn btn-sm btn-outline-danger btn-icon" asp-page="./Delete" asp-route-id="@item.Id" title="Delete" aria-label="Delete"><i class="bi bi-trash" aria-hidden="true"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
