@page
@using RadiantHomes.DAL
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.Financial.CreateModel

@{
    ViewData["Title"] = "New financial detail";
    ViewData["Subtitle"] = "Bank account, tax and audit details for a housing company.";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<form method="post" class="card needs-validation" id="financialDetailForm">
    <div class="card-body">
        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <div class="mh-fieldset">
            @if (User.IsInRole(MichuHomesRoles.MichuAdmin) && Model.SelectedCompanyId == Guid.Empty)
            {
                <h2 class="mh-fieldset-title">Select Target Company</h2>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="CompanyFinancialDetail.CompanyId" class="form-label">Company Name</label>
                        <select asp-for="CompanyFinancialDetail.CompanyId" class="form-select" asp-items="Model.CompanySelectList">
                            <option value="">-- Choose Company --</option>
                        </select>
                        <span asp-validation-for="CompanyFinancialDetail.CompanyId" class="text-danger d-block"></span>
                    </div>
                </div>
            }
            else
            {
                <h2 class="mh-fieldset-title">Company</h2>
                <p class="fw-semibold mb-0">@Model.CompanyName</p>
                <input type="hidden" asp-for="SelectedCompanyId" />
                <input type="hidden" asp-for="CompanyFinancialDetail.CompanyId" />
            }
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Bank Account Details</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CompanyFinancialDetail.BankName" class="form-label"></label>
                    <input asp-for="CompanyFinancialDetail.BankName" class="form-control" placeholder="e.g., Commercial Bank of Ethiopia" />
                    <span asp-validation-for="CompanyFinancialDetail.BankName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CompanyFinancialDetail.AccountNumber" class="form-label"></label>
                    <input asp-for="CompanyFinancialDetail.AccountNumber" class="form-control" placeholder="e.g., 1000123456789" />
                    <span asp-validation-for="CompanyFinancialDetail.AccountNumber" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="CompanyFinancialDetail.IsPrimary" id="isPrimaryCheckbox" />
                        <label class="form-check-label fw-semibold" asp-for="CompanyFinancialDetail.IsPrimary"></label>
                        <div class="form-text mt-0">Mark as the primary bank account for transactions</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Tax &amp; VAT Information</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CompanyFinancialDetail.TinNumber" class="form-label"></label>
                    <input asp-for="CompanyFinancialDetail.TinNumber" class="form-control" placeholder="e.g., 0012345678" />
                    <span asp-validation-for="CompanyFinancialDetail.TinNumber" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CompanyFinancialDetail.TaxId" class="form-label"></label>
                    <input asp-for="CompanyFinancialDetail.TaxId" class="form-control" placeholder="e.g., ABCDE12345" />
                    <span asp-validation-for="CompanyFinancialDetail.TaxId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CompanyFinancialDetail.VatRegistrationNumber" class="form-label"></label>
                    <input asp-for="CompanyFinancialDetail.VatRegistrationNumber" class="form-control" placeholder="e.g., VAT123456789" />
                    <span asp-validation-for="CompanyFinancialDetail.VatRegistrationNumber" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Annual Financial Details</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CompanyFinancialDetail.BudgetYear" class="form-label"></label>
                    <input asp-for="CompanyFinancialDetail.BudgetYear" class="form-control" placeholder="e.g., 2025" />
                    <span asp-validation-for="CompanyFinancialDetail.BudgetYear" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CompanyFinancialDetail.AnnualRevenue" class="form-label"></label>
                    <input asp-for="CompanyFinancialDetail.AnnualRevenue" class="form-control" placeholder="e.g., 5,000,000 ETB" />
                    <span asp-validation-for="CompanyFinancialDetail.AnnualRevenue" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Audit Information</h2>
            <div class="row g-3">
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="CompanyFinancialDetail.hasAuditedFinancialStatement" id="hasAuditedFinancialStatementCheckbox" />
                        <label class="form-check-label fw-semibold" asp-for="CompanyFinancialDetail.hasAuditedFinancialStatement"></label>
                        <div class="form-text mt-0">Check if an audited financial statement is available</div>
                    </div>
                </div>
                <div class="col-12" id="auditedStatementUrlContainer">
                    <label asp-for="CompanyFinancialDetail.AuditedFinancialStatementUrl" class="form-label"></label>
                    <input asp-for="CompanyFinancialDetail.AuditedFinancialStatementUrl" class="form-control" placeholder="Provide URL or Path to Audited Statement" />
                    <span asp-validation-for="CompanyFinancialDetail.AuditedFinancialStatementUrl" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mh-form-actions">
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg" aria-hidden="true"></i> Save Financial Details
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const hasAuditedCheckbox = document.getElementById('hasAuditedFinancialStatementCheckbox');
            const auditedUrlContainer = document.getElementById('auditedStatementUrlContainer');
            const auditedUrlInput = document.getElementById('@Html.IdFor(m => m.CompanyFinancialDetail.AuditedFinancialStatementUrl)');

            function toggleAuditedUrlField() {
                if (hasAuditedCheckbox.checked) {
                    auditedUrlContainer.style.display = 'block';
                    auditedUrlInput.removeAttribute('disabled'); // Ensure it's enabled when visible
                } else {
                    auditedUrlContainer.style.display = 'none';
                    auditedUrlInput.setAttribute('disabled', 'disabled'); // Disable when hidden to prevent submission
                    auditedUrlInput.value = ''; // Clear value when hidden
                }
            }

            // Initial state
            toggleAuditedUrlField();

            // Listen for changes
            hasAuditedCheckbox.addEventListener('change', toggleAuditedUrlField);
        });
    </script>
}
