@page
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.Financial.DetailsModel

@{
    ViewData["Title"] = "Financial details";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

@section PageActions {
    <a class="btn btn-secondary" asp-page="./Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list</a>
    <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.CompanyFinancialDetail.Id"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</a>
}

<div class="card">
    <div class="card-header">
        <h2 class="mh-section-title"><i class="bi bi-bank" aria-hidden="true"></i> Company Financial Detail</h2>
    </div>
    <div class="card-body">
        <dl class="mh-dl">
            <dt>Bank Name</dt>
            <dd>@Html.DisplayFor(m => m.CompanyFinancialDetail.BankName)</dd>

            <dt>Account Number</dt>
            <dd>@Html.DisplayFor(m => m.CompanyFinancialDetail.AccountNumber)</dd>

            <dt>Tax ID</dt>
            <dd>@Html.DisplayFor(m => m.CompanyFinancialDetail.TaxId)</dd>

            <dt>Annual Revenue</dt>
            <dd>@Html.DisplayFor(m => m.CompanyFinancialDetail.AnnualRevenue)</dd>

            <dt>Budget Year</dt>
            <dd>@Html.DisplayFor(m => m.CompanyFinancialDetail.BudgetYear)</dd>

            <dt>Is Primary Account</dt>
            <dd>@Html.DisplayFor(m => m.CompanyFinancialDetail.IsPrimary)</dd>

            <dt>TIN Number</dt>
            <dd>@Html.DisplayFor(m => m.CompanyFinancialDetail.TinNumber)</dd>

            <dt>VAT Registration No.</dt>
            <dd>@Html.DisplayFor(m => m.CompanyFinancialDetail.VatRegistrationNumber)</dd>

            <dt>Has Audited Financial Statement?</dt>
            <dd>@Html.DisplayFor(m => m.CompanyFinancialDetail.hasAuditedFinancialStatement)</dd>

            <dt>Audited Financial URL</dt>
            <dd>
                @if (!string.IsNullOrEmpty(Model.CompanyFinancialDetail.AuditedFinancialStatementUrl))
                {
                    <a href="@Model.CompanyFinancialDetail.AuditedFinancialStatementUrl" target="_blank" rel="noopener">View Document <i class="bi bi-box-arrow-up-right ms-1" aria-hidden="true"></i></a>
                }
                else
                {
                    <span class="text-muted">N/A</span>
                }
            </dd>

            <dt>Company</dt>
            <dd>
                @if (Model.CompanyFinancialDetail.Company != null)
                {
                    <a asp-page="/Details" asp-route-id="@Model.CompanyFinancialDetail.CompanyId">@Model.CompanyFinancialDetail.Company.Name</a>
                }
                else
                {
                    <span class="text-muted">N/A</span>
                }
            </dd>

            <dt>Created By</dt>
            <dd>@Html.DisplayFor(m => m.CompanyFinancialDetail.CreatedBy)</dd>

            <dt>Created On</dt>
            <dd>@Html.DisplayFor(m => m.CompanyFinancialDetail.CreatedOn)</dd>

            <dt>Updated By</dt>
            <dd>@Html.DisplayFor(m => m.CompanyFinancialDetail.UpdatedBy)</dd>

            <dt>Updated On</dt>
            <dd>@Html.DisplayFor(m => m.CompanyFinancialDetail.UpdatedOn)</dd>
        </dl>
    </div>
</div>
