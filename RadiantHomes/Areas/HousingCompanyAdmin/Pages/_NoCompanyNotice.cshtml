    <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-building-exclamation"></i></span>
    <h2>No housing company linked</h2>
    <p>@RadiantHomes.Services.AdminServices.CompanyScope.NoCompanyMessage</p>
</div>
