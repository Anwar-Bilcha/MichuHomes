@page
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.Projects.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.HouseProject[0].Company)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseProject[0].ProjectName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseProject[0].Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseProject[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseProject[0].StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseProject[0].EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseProject[0].TotalArea)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseProject[0].CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseProject[0].CreatedOn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseProject[0].UpdatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseProject[0].UpdatedOn)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.HouseProject) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Company.CompanyId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProjectName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalArea)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedOn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedOn)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.ProjectId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.ProjectId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.ProjectId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
