@page
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.Projects.EditModel

@{
    ViewData["Title"] = "Edit project";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<form method="post" class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="HouseProject.ProjectId" />

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Project</h2>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="HouseProject.HousingCompanyId" class="form-label"></label>
                    <select asp-for="HouseProject.HousingCompanyId" class="form-select" asp-items="ViewBag.HousingCompanyId"></select>
                    <span asp-validation-for="HouseProject.HousingCompanyId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="HouseProject.AddressId" class="form-label"></label>
                    <select asp-for="HouseProject.AddressId" class="form-select" asp-items="ViewBag.AddressId"></select>
                    <span asp-validation-for="HouseProject.AddressId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseProject.ProjectName" class="form-label"></label>
                    <input asp-for="HouseProject.ProjectName" class="form-control" />
                    <span asp-validation-for="HouseProject.ProjectName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseProject.Location" class="form-label"></label>
                    <input asp-for="HouseProject.Location" class="form-control" />
                    <span asp-validation-for="HouseProject.Location" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="HouseProject.Description" class="form-label"></label>
                    <input asp-for="HouseProject.Description" class="form-control" />
                    <span asp-validation-for="HouseProject.Description" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="HouseProject.StartDate" class="form-label"></label>
                    <input asp-for="HouseProject.StartDate" class="form-control" />
                    <span asp-validation-for="HouseProject.StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="HouseProject.EndDate" class="form-label"></label>
                    <input asp-for="HouseProject.EndDate" class="form-control" />
                    <span asp-validation-for="HouseProject.EndDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="HouseProject.TotalArea" class="form-label"></label>
                    <input asp-for="HouseProject.TotalArea" class="form-control" />
                    <span asp-validation-for="HouseProject.TotalArea" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mh-form-actions">
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save changes</button>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
