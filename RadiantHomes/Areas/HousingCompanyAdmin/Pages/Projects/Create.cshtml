@page "{companyId:guid?}"
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.Projects.CreateModel
@{
    ViewData["Title"] = "New project";
    if (Model.Company != null)
    {
        ViewData["Subtitle"] = $"Create a new project for {Model.Company.Name}.";
    }
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<form method="post" class="card needs-validation">
    <div class="card-body">
        @* Display validation summary for general errors (like "No addresses available" or server-side binding issues) *@
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Company</h2>
            @* Conditional display of company selection based on user role *@
            @if (Model.ShowCompanyDropdown)
            {
                <label asp-for="HouseProject.HousingCompanyId" class="form-label">Select Housing Company</label>
                <select asp-for="HouseProject.HousingCompanyId" class="form-select" asp-items="Model.AvailableHousingCompanies" required>
                    <option value="">-- Select Company --</option>
                </select>
                <span asp-validation-for="HouseProject.HousingCompanyId" class="text-danger"></span>
            }
            else
            {
                @* For Real Estate Admin, display the fixed company name and pass the ID via hidden field *@
                @if (Model.Company != null)
                {
                    <label class="form-label">Associated Company</label>
                    <input type="text" class="form-control" value="@Model.Company.Name" readonly aria-label="Associated Company Name" />
                    @* Crucial hidden fields to ensure CompanyId and HouseProject.HousingCompanyId are posted back *@
                    <input type="hidden" asp-for="CompanyId" />
                    <input type="hidden" asp-for="HouseProject.HousingCompanyId" />
                }
                else
                {
                    <div class="alert alert-warning">Your profile is not linked to a housing company. Please contact support.</div>
                    @* If no company, disable form submission or provide alternative action *@
                    <button type="submit" class="btn btn-primary" disabled>Create Project</button>
                }
            }
        </div>

        @* Common House Project fields - these apply to both roles *@
        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Project</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="HouseProject.ProjectName" class="form-label">Project Name</label>
                    <input asp-for="HouseProject.ProjectName" class="form-control" placeholder="e.g., Sunrise Apartments" required />
                    <span asp-validation-for="HouseProject.ProjectName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseProject.Location" class="form-label">Location</label>
                    <input asp-for="HouseProject.Location" class="form-control" placeholder="Specific location details" />
                    <span asp-validation-for="HouseProject.Location" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="HouseProject.Description" class="form-label">Description</label>
                    <textarea asp-for="HouseProject.Description" class="form-control" rows="3" placeholder="Project details..."></textarea>
                    <span asp-validation-for="HouseProject.Description" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseProject.StartDate" class="form-label">Start Date</label>
                    <input asp-for="HouseProject.StartDate" type="date" class="form-control" required />
                    <span asp-validation-for="HouseProject.StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseProject.EndDate" class="form-label">End Date</label>
                    <input asp-for="HouseProject.EndDate" type="date" class="form-control" />
                    <span asp-validation-for="HouseProject.EndDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseProject.TotalArea" class="form-label">Total Area (sqm)</label>
                    <input asp-for="HouseProject.TotalArea" type="number" step="0.01" class="form-control" placeholder="e.g., 1500.50" required />
                    <span asp-validation-for="HouseProject.TotalArea" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseProject.AddressId" class="form-label">
                        <i class="bi bi-geo-alt" aria-hidden="true"></i> @Html.DisplayNameFor(m => m.HouseProject.AddressId)
                    </label>
                    <select asp-for="HouseProject.AddressId" class="form-select" asp-items="Model.Addresses" required>
                        <option value="">-- Select Address --</option>
                    </select>
                    <span asp-validation-for="HouseProject.AddressId" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mh-form-actions">
            <a asp-page="./Index" asp-route-companyId="@Model.CompanyId" class="btn btn-secondary">Back</a>
            @if (Model.Company != null || Model.ShowCompanyDropdown) @* Only show submit if a company is associated or can be selected *@
            {
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Create Project</button>
            }
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <partial name="_Select2" />
    <script>
        $(document).ready(function () {
            // Initialize Select2 for the Address dropdown
            $('#HouseProject_AddressId').select2({
                placeholder: (window.MichuI18n ? MichuI18n.t : (s => s))("-- Select Address --"),
                allowClear: true
            });

            // Initialize Select2 for the Housing Company dropdown IF IT EXISTS
            // Check if the element exists in the DOM before initializing
            if ($('#HouseProject_HousingCompanyId').length) {
                $('#HouseProject_HousingCompanyId').select2({
                    placeholder: (window.MichuI18n ? MichuI18n.t : (s => s))("-- Select Company --"),
                    allowClear: true
                });
            }
        });
    </script>
}
