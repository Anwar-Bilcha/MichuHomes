@page
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.DetailsModel

@{
    ViewData["Title"] = "Housing company details";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

@section PageActions {
    <a class="btn btn-secondary" asp-page="./Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list</a>
    <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.HousingCompany.CompanyId"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</a>
}

<div class="card mb-4">
    <div class="card-header">
        <h2 class="mh-section-title"><i class="bi bi-building" aria-hidden="true"></i> Housing Company Overview</h2>
    </div>
    <div class="card-body">
        <dl class="mh-dl">
            <dt>Name</dt>
            <dd>@Model.HousingCompany.Name</dd>
            <dt>License Number</dt>
            <dd>@Model.HousingCompany.LicenseNumber</dd>
            <dt>Established Date</dt>
            <dd>@Model.HousingCompany.EstablishedDate.ToShortDateString()</dd>
            <dt>Status</dt>
            <dd><span class="mh-chip">@Model.HousingCompany.Status</span></dd>
            <dt>Company Category</dt>
            <dd>@Model.HousingCompany.CompanyCategory.GetDisplayName()</dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h2 class="mh-section-title"><i class="bi bi-geo-alt" aria-hidden="true"></i> Contact &amp; Address</h2>
    </div>
    <div class="card-body">
        <dl class="mh-dl">
            <dt>Email</dt>
            <dd>
                <i class="bi bi-envelope me-1 text-muted" aria-hidden="true"></i>
                <a href="mailto:@Model.HousingCompany.Email">@Model.HousingCompany.Email</a>
            </dd>
            <dt>Phone</dt>
            <dd>
                <i class="bi bi-telephone me-1 text-muted" aria-hidden="true"></i>
                <a href="tel:@Model.HousingCompany.PhoneNumber">@Model.HousingCompany.PhoneNumber</a>
            </dd>
            <dt>Website</dt>
            <dd>
                @if (!string.IsNullOrEmpty(Model.HousingCompany.Website))
                {
                    <a href="@Model.HousingCompany.Website" target="_blank" rel="noopener noreferrer">
                        @Model.HousingCompany.Website <i class="bi bi-box-arrow-up-right ms-1" aria-hidden="true"></i>
                    </a>
                }
            </dd>
            <dt>Address</dt>
            <dd>
                @if (Model.HousingCompany.Address != null)
                {
                    <div>
                        <i class="bi bi-geo-alt me-1 text-muted" aria-hidden="true"></i>
                        @Model.HousingCompany.Address.FormattedAddressCompact
                    </div>
                }
                else
                {
                    <span class="text-muted">No Address Information</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h2 class="mh-section-title"><i class="bi bi-image" aria-hidden="true"></i> Logo</h2>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.HousingCompany.LogoUrl))
        {
            <img src="@Model.HousingCompany.LogoUrl" alt="Company Logo" class="img-thumbnail" style="max-width: 220px;">
        }
        else
        {
            <span class="text-muted">No Logo Uploaded</span>
        }
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="mh-section-title"><i class="bi bi-clock-history" aria-hidden="true"></i> Metadata</h2>
    </div>
    <div class="card-body">
        <dl class="mh-dl">
            <dt>Created By</dt>
            <dd>@Model.HousingCompany.CreatedBy</dd>
            <dt>Created On</dt>
            <dd>@Model.HousingCompany.CreatedOn</dd>
            <dt>Updated By</dt>
            <dd>@Model.HousingCompany.UpdatedBy</dd>
            <dt>Updated On</dt>
            <dd>@Model.HousingCompany.UpdatedOn</dd>
        </dl>
    </div>
</div>
