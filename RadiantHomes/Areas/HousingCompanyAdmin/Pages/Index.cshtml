@page
@using RadiantHomes.Services.NotificationService
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.IndexModel
@{
    ViewData["Title"] = "Housing company admin";
    ViewData["Subtitle"] = "Manage your company profile, projects and buildings.";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}
@inject INotificationService NotificationService

<div class="row g-4">
    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <span class="mh-stat-icon mb-3" aria-hidden="true"><i class="bi bi-building"></i></span>
                <h2 class="h5 card-title">Manage company profile</h2>
                <p class="text-muted small">View and edit your company's details, including name, license, and contacts.</p>
                <div class="d-flex flex-wrap gap-2 mt-auto">
                    @if (Model.CompanyId != null)
                    {
                        <a asp-page="./Edit" asp-route-id="@Model.CompanyId" class="btn btn-primary"><i class="bi bi-pencil" aria-hidden="true"></i> Edit profile</a>
                    }
                    @if (Model.CanCreateCompany)
                    {
                        <a asp-page="./Create" target="_blank" class="btn btn-outline-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Create profile</a>
                    }
                    <button type="button" onclick="location.href='@Url.Page("/Account/AdminRegister", new { area = "Identity" })'" class="btn btn-outline-primary">
                        <i class="bi bi-person-plus" aria-hidden="true"></i> Register admin
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <span class="mh-stat-icon mb-3" aria-hidden="true"><i class="bi bi-kanban"></i></span>
                <h2 class="h5 card-title">Manage projects</h2>
                <p class="text-muted small">Create and manage your housing development projects.</p>
                <div class="d-flex flex-wrap gap-2 mt-auto">
                    <a asp-page="./Projects/Index" class="btn btn-primary">View projects</a>
                    <a asp-page="./Projects/Create" class="btn btn-outline-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> New project</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <span class="mh-stat-icon mb-3" aria-hidden="true"><i class="bi bi-buildings"></i></span>
                <h2 class="h5 card-title">Manage buildings</h2>
                <p class="text-muted small">Create and manage your housing development project buildings.</p>
                <div class="d-flex flex-wrap gap-2 mt-auto">
                    <a asp-page="./Buildings/Index" class="btn btn-primary">View buildings</a>
                    <a asp-page="./Buildings/Create" class="btn btn-outline-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> New building</a>
                </div>
            </div>
        </div>
    </div>
</div>
