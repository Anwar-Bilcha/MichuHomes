@page
@using RadiantHomes.Services.NotificationService
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.IndexModel
@{
    ViewData["Title"] = "Housing Company Admin Dashboard";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}
@inject INotificationService NotificationService

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://unpkg.com/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    #sidebar {
        transition: all 0.3s ease;
        width: 250px;
    }

        #sidebar.collapsed {
            margin-left: -250px;
        }

    #main-content {
        transition: margin-left 0.3s ease;
        margin-left: 250px;
    }

    

    .dropdown-menu-end {
        right: 0;
        left: auto;
    }
</style>

<div class="d-flex flex-column flex-lg-row vh-100">
    <!-- Main Content -->
    <div class="flex-grow-1 p-4 overflow-auto">
        <h2 class="mb-4" style="color:#666">@ViewData["Title"]</h2>

       
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title"><i class="bi bi-building me-2"></i> Manage Company Profile</h5>
                            <p class="text-muted small">View and edit your company's details, including name, license, and contacts.</p>
                        </div>
                        <a asp-page="./Profile/Edit" class="btn btn-primary mt-2">Edit Profile</a>
                        <a href="./Create" target="_blank" class="btn btn-success mt-2"><i class="icon-new"></i> Create Profile</a>
                    </div>
                    <button onclick="location.href='@Url.Page("/Account/AdminRegister", new { area = "Identity" })'" class="btn btn-primary">
                        Register Admin
                    </button>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title"><i class="bi bi-briefcase me-2"></i> Manage Projects</h5>
                            <p class="text-muted small">Create and manage your housing development projects.</p>
                        </div>
                        <div class="d-flex flex-column flex-md-row gap-2 mt-2">
                            <a asp-page="./Projects/Index" class="btn btn-primary">View Projects</a>
                            <a asp-page="./Projects/Create" class="btn btn-success">Create New</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title"><i class="bi bi-house me-2"></i> Manage Buildings</h5>
                            <p class="text-muted small">Create and manage your housing development project buildings.</p>
                        </div>
                        <div class="d-flex flex-column flex-md-row gap-2 mt-2">
                            <a asp-page="./Buildings/Index" class="btn btn-primary">View Buildings</a>
                            <a asp-page="./Buildings/Create" class="btn btn-success">Create New</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Add similar cards for Apartments, Testimonials, etc. -->
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-kQtW33rZJAHjgefvhyyzcGF3Cl1gF2+Pa2smWjQ4YJ+op7ptHcNghhP4S1S0Eexk" crossorigin="anonymous"></script>
