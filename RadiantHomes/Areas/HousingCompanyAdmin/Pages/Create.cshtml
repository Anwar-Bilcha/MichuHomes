@page
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.CreateModel
@{
    ViewData["Title"] = "Create Housing Company";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}


<div class="container-fluid py-4">
    <!-- Navigation Bar -->
    <nav class="nav nav-pills mb-4 bg-light rounded p-2">
        <a class="nav-link" asp-page="./Index"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
        <a class="nav-link active bg-primary text-white" asp-page="./Create"><i class="bi bi-plus-circle me-1"></i> Create Company</a>
        <a class="nav-link" asp-page="./Projects/Index"><i class="bi bi-briefcase me-1"></i> Projects</a>
        <a class="nav-link" asp-page="./Buildings/Index"><i class="bi bi-buildings me-1"></i> Buildings</a>
        <a class="nav-link" asp-page="./ApartmentHouses/Index"><i class="bi bi-house-door me-1"></i> Apartments</a>
        <a class="nav-link" asp-page="./Testimonials/Index"><i class="bi bi-chat-right-text me-1"></i> Testimonials</a>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white rounded-top">
                    <h5 class="mb-0"><i class="bi bi-building me-2"></i> Create Housing Company</h5>
                </div>
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken();
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Company Name -->
                        <div class="mb-3">
                            <label asp-for="HousingCompany.Name" class="form-label fw-semibold">Company Name</label>
                            <input asp-for="HousingCompany.Name" class="form-control" placeholder="Enter company name" />
                            <span asp-validation-for="HousingCompany.Name" class="text-danger small"></span>
                        </div>

                        <!-- License and Established Date -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="HousingCompany.LicenseNumber" class="form-label fw-semibold">License Number</label>
                                <input asp-for="HousingCompany.LicenseNumber" class="form-control" placeholder="Enter license number" />
                                <span asp-validation-for="HousingCompany.LicenseNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="HousingCompany.EstablishedDate" class="form-label fw-semibold">Established Date</label>
                                <input asp-for="HousingCompany.EstablishedDate" class="form-control" type="date" />
                                <span asp-validation-for="HousingCompany.EstablishedDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Address -->
                        <div class="mt-3">
                            <label asp-for="HousingCompany.AddressId" class="form-label fw-semibold">Select Address</label>
                            <select asp-for="HousingCompany.AddressId" class="form-select select2" id="addressSelect">
                                @foreach (var address in Model.AddressList)
                                {
                                    <option value="@address.Value">@address.Text</option>
                                }
                                <option value="new">-- Add New Address --</option>
                            </select>
                            <span asp-validation-for="HousingCompany.AddressId" class="text-danger small"></span>
                        </div>

                       @*  <div id="newAddressForm" style="display: none;" class="mt-3 border p-3 rounded">
                            <h6 class="fw-bold">Enter New Address</h6>
                            <div class="mb-2">
                                <label class="form-label">Street</label>
                                <input name="NewAddress.Street" class="form-control" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">City</label>
                                <input name="NewAddress.City" class="form-control" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Region</label>
                                <input name="NewAddress.Region" class="form-control" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Country</label>
                                <input name="NewAddress.Country" class="form-control" />
                            </div>
                        </div> *@
                        <script>
                            $(document).ready(function () {
                                $('#addressSelect').select2({
                                    placeholder: "Select or search an address",
                                    allowClear: true,
                                    width: '100%' // Makes it fit nicely
                                });

                                $('#addressSelect').on('change', function () {
                                    var newAddressForm = document.getElementById('newAddressForm');
                                    if (this.value === 'new') {
                                        newAddressForm.style.display = 'block';
                                    } else {
                                        newAddressForm.style.display = 'none';
                                    }
                                });
                            });
                        </script>
                         <script>
                            document.getElementById('addressSelect').addEventListener('change', function () {
                                var newAddressForm = document.getElementById('newAddressForm');
                                if (this.value === 'new') {
                                    newAddressForm.style.display = 'block';
                                } else {
                                    newAddressForm.style.display = 'none';
                                }
                            });
                        </script>
                        



                        <!-- Email and Phone Number -->
                        <div class="row g-3 mt-3">
                            <div class="col-md-6">
                                <label asp-for="HousingCompany.Email" class="form-label fw-semibold">Email</label>
                                <input asp-for="HousingCompany.Email" class="form-control" type="email" placeholder="example@company.com" />
                                <span asp-validation-for="HousingCompany.Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="HousingCompany.PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                                <input asp-for="HousingCompany.PhoneNumber" class="form-control" type="tel" placeholder="+251 911 234567" />
                                <span asp-validation-for="HousingCompany.PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Website -->
                        <div class="mt-3">
                            <label asp-for="HousingCompany.Website" class="form-label fw-semibold">Website</label>
                            <input asp-for="HousingCompany.Website" class="form-control" placeholder="https://example.com" />
                            <span asp-validation-for="HousingCompany.Website" class="text-danger small"></span>
                        </div>

                        <!-- Logo Upload -->
                        <div class="mt-3">
                            <label class="form-label fw-semibold">Company Logo</label>
                            <input type="file" asp-for="LogoUrl" class="form-control" />
                            <span asp-validation-for="LogoUrl" class="text-danger small"></span>
                        </div>

                        <!-- Status and Category -->
                        <div class="row g-3 mt-3">
                            <div class="col-md-6">
                                <label asp-for="HousingCompany.Status" class="form-label fw-semibold">Company Status</label>
                                <select asp-for="HousingCompany.Status" class="form-select">
                                    <option value="">-- Select Status --</option>
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                    <option value="Pending">Pending</option>
                                </select>
                                <span asp-validation-for="HousingCompany.Status" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="HousingCompany.CompanyCategory" class="form-label fw-semibold">Company Category</label>
                                <select asp-for="HousingCompany.CompanyCategory" class="form-select">
                                    <option value="">-- Select Category --</option>
                                    <option value="Real Estate Developer">Real Estate Developer</option>
                                    <option value="Construction Company">Construction Company</option>
                                    <option value="Management Firm">Management Firm</option>
                                </select>
                                <span asp-validation-for="HousingCompany.CompanyCategory" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="mt-4 d-flex justify-content-between">
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i> Create Company
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    };
}
