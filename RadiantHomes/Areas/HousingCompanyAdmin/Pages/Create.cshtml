@page
@model RadiantHomes.Areas.HousingCompanyAdmin.Pages.CreateModel
@{
    ViewData["Title"] = "New housing company";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<form method="post" enctype="multipart/form-data" class="card">
    <div class="card-body">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Company</h2>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="HousingCompany.Name" class="form-label">Company Name</label>
                    <input asp-for="HousingCompany.Name" class="form-control" placeholder="Enter company name" />
                    <span asp-validation-for="HousingCompany.Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HousingCompany.LicenseNumber" class="form-label">License Number</label>
                    <input asp-for="HousingCompany.LicenseNumber" class="form-control" placeholder="Enter license number" />
                    <span asp-validation-for="HousingCompany.LicenseNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HousingCompany.EstablishedDate" class="form-label">Established Date</label>
                    <input asp-for="HousingCompany.EstablishedDate" class="form-control" type="date" />
                    <span asp-validation-for="HousingCompany.EstablishedDate" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Address</h2>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="HousingCompany.AddressId" class="form-label">Select Address</label>
                    <select asp-for="HousingCompany.AddressId" class="form-select" id="addressSelect" asp-items="Model.AddressList">
                        <option value="">-- Select Address --</option>
                    </select>
                    <span asp-validation-for="HousingCompany.AddressId" class="text-danger small"></span>
                </div>
            </div>

            @*  <div id="newAddressForm" style="display: none;" class="mt-3 border p-3 rounded">
                <h6 class="fw-bold">Enter New Address</h6>
                <div class="mb-2">
                    <label class="form-label">Street</label>
                    <input name="NewAddress.Street" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label">City</label>
                    <input name="NewAddress.City" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Region</label>
                    <input name="NewAddress.Region" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Country</label>
                    <input name="NewAddress.Country" class="form-control" />
                </div>
            </div> *@
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Contact</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="HousingCompany.Email" class="form-label">Email</label>
                    <input asp-for="HousingCompany.Email" class="form-control" type="email" placeholder="example@company.com" />
                    <span asp-validation-for="HousingCompany.Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HousingCompany.PhoneNumber" class="form-label">Phone Number</label>
                    <input asp-for="HousingCompany.PhoneNumber" class="form-control" type="tel" placeholder="+251 911 234567" />
                    <span asp-validation-for="HousingCompany.PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="HousingCompany.Website" class="form-label">Website</label>
                    <input asp-for="HousingCompany.Website" class="form-control" placeholder="https://example.com" />
                    <span asp-validation-for="HousingCompany.Website" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Profile</h2>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="LogoUrl" class="form-label">Company Logo</label>
                    <input type="file" asp-for="LogoUrl" class="form-control" accept="image/*" />
                    <span asp-validation-for="LogoUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-4">\n                    <span class="form-label d-block">Approval status</span>\n                    <div class="form-text mt-0">New companies wait for Michu Homes approval before their administrators can manage listings.</div>\n                </div>
                <div class="col-md-6">
                    <label asp-for="HousingCompany.CompanyCategory" class="form-label">Company Category</label>
                    <select asp-for="HousingCompany.CompanyCategory" class="form-select">
                        @foreach (var category in Enum.GetValues<HousingCompany.CompanyType>())
                        {
                            <option value="@category">@category.GetDisplayName()</option>
                        }
                    </select>
                    <span asp-validation-for="HousingCompany.CompanyCategory" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="mh-form-actions">
            <a asp-page="./Index" class="btn btn-secondary">Back to list</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Create company</button>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_Select2" />
    <script>
        $(function () {
            $('#addressSelect').select2({
                placeholder: (window.MichuI18n ? MichuI18n.t : (s => s))("Select or search an address"),
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}
