@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
    ViewData["PageWidth"] = "narrow";
}

@section PageActions {
    @* ChangePassword sends accounts without a local password on to SetPassword. *@
    <a asp-page="./ChangePassword" class="btn btn-secondary"><i class="bi bi-key" aria-hidden="true"></i> Password</a>
}

@* StatusMessage ("Your profile has been updated", …) is shown as a toast by _FlashMessages. *@
<form id="profile-form" method="post" class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" placeholder="Please choose your username." disabled />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Please enter your phone number." />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
        </div>

        <div class="mh-form-actions">
            <button id="update-profile-button" type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
