@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    ViewData["PageHeader"] = false;
}

<div class="mh-auth py-md-4">
    <div class="card">
        <div class="card-body">
            <div class="text-center mb-4">
                <a asp-area="" asp-page="/Index" class="d-inline-block mb-3" style="width: 180px" aria-label="Michu Homes — home">
                    <partial name="_BrandLogo" model="@("color")" />
                </a>
                <h1 class="h3 mb-1">Create a new account</h1>
            </div>

            @if (!string.IsNullOrEmpty(Model.InvitedBy))
            {
                <div class="alert alert-info d-flex gap-2 align-items-start" role="note">
                    <i class="bi bi-gift" aria-hidden="true"></i>
                    <span>@($"{Model.InvitedBy} invited you to Michu Homes. Create your account to get started.")</span>
                </div>
            }

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="CustomerId" />
                <input type="hidden" asp-for="CompanyId" />
                <input type="hidden" asp-for="Ref" />
                @if (!string.IsNullOrEmpty(Model.Success))
                {
                    <div class="alert alert-success"><label class="mb-0" asp-for="Success">@Model.Success</label></div>
                }

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="form-check mb-4">
                    <input asp-for="Input.IsEmployee" class="form-check-input" autocomplete="off" />
                    <label asp-for="Input.IsEmployee" class="form-check-label">Are you Employee?</label>
                    <span asp-validation-for="Input.IsEmployee" class="text-danger"></span>
                </div>
                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
            </form>

            <section>
                <h2 class="visually-hidden">Use another service to register.</h2>
                @{
                    if ((Model.ExternalLogins?.Count ?? 0) == 0)
                    {
                        <p class="small text-muted text-center mt-4 mb-0">
                            There are no external authentication services configured. See this <a href="https://go.microsoft.com/fwlink/?LinkID=532715">article
                            about setting up this ASP.NET application to support logging in via external services</a>.
                        </p>
                    }
                    else
                    {
                        <div class="mh-auth-divider">or continue with</div>
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-grid gap-2">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                            }
                        </form>
                    }
                }
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
