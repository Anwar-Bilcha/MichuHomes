@page
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "Check your email";
    ViewData["PageHeader"] = false;
}

<div class="mh-auth py-md-4">
    <div class="card">
        <div class="card-body text-center">
            <span class="mh-empty-icon d-inline-flex mb-3" aria-hidden="true"><i class="bi bi-envelope-check"></i></span>
            <h1 class="h3 mb-2">@ViewData["Title"]</h1>
            <p class="text-muted">If an account uses that address, we've sent it a link to choose a new password. The link works for a limited time.</p>
            <a class="btn btn-primary" asp-page="./Login">Back to sign in</a>
        </div>
    </div>
</div>
