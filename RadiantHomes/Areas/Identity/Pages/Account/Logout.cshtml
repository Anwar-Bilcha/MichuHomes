@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
    ViewData["PageHeader"] = false;
}

<div class="mh-auth py-md-4">
    <div class="card">
        <div class="card-body text-center">
            <a asp-area="" asp-page="/Index" class="d-inline-block mb-3" style="width: 180px" aria-label="Michu Homes — home">
                <partial name="_BrandLogo" model="@("color")" />
            </a>
            <h1 class="h3 mb-3">@ViewData["Title"]</h1>
            @{
                if (User.Identity?.IsAuthenticated ?? false)
                {
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Log out</button>
                    </form>
                }
                else
                {
                    <p class="text-muted">You have successfully logged out of the application.</p>
                    <a asp-area="" asp-page="/Index" class="btn btn-primary"><i class="bi bi-house" aria-hidden="true"></i> Back to Home</a>
                }
            }
        </div>
    </div>
</div>
