@page
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "Password changed";
    ViewData["PageHeader"] = false;
}

<div class="mh-auth py-md-4">
    <div class="card">
        <div class="card-body text-center">
            <span class="mh-empty-icon d-inline-flex mb-3" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
            <h1 class="h3 mb-2">@ViewData["Title"]</h1>
            <p class="text-muted">Your password was saved. You can sign in with it now.</p>
            <a class="btn btn-primary" asp-page="./Login">Sign in</a>
        </div>
    </div>
</div>
