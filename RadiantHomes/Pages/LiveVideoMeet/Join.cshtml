@page
@model RadiantHomes.Pages.LiveVideoMeet.JoinModel
@{
    // Agents work in the admin area; the call fills the screen below its top bar.
    Layout = "_HousingCompanyAdminLayout";
    ViewData["Title"] = "Video call";
    ViewData["PageHeader"] = Model.CallView is null;
    ViewData["PageWidth"] = Model.CallView is null ? "narrow" : "full";
}

@section Scripts {
    @if (Model.CallView is not null)
    {
        <script src="~/js/video-call.js" asp-append-version="true"></script>
    }
}

@* Wide screens: the call with the caller's details beside it; smaller screens: the details as a strip above it. *@
<div class="@(Model.CallView is null ? null : "mh-call-agent")">
    @if (Model.Log is not null || Model.Ticket is not null)
    {
        var name = Model.Log?.CustomerName ?? Model.Ticket!.Name;
        var phone = Model.Log?.CustomerPhone ?? Model.Ticket?.Phone;
        var apartmentId = Model.Log?.ApartmentHouseId ?? Model.Ticket?.ApartmentId;
        var topic = Model.Log?.Topic ?? Model.Ticket?.Topic;
        var asked = Model.Log?.RequestedOn ?? Model.Ticket!.CreatedUtc;
        <dl class="mh-call-caller" aria-label="Caller">
            <div>
                <dt>Customer</dt>
                <dd>@name</dd>
            </div>
            <div>
                <dt>Phone</dt>
                <dd>
                    @if (string.IsNullOrWhiteSpace(phone))
                    {
                        <span class="text-muted">Not given</span>
                    }
                    else
                    {
                        <a href="tel:@phone" translate="no">@phone</a>
                    }
                </dd>
            </div>
            <div>
                <dt>Regarding</dt>
                <dd>
                    @if (apartmentId is Guid homeId)
                    {
                        <a href="/ApartmentHouses/Details?id=@homeId" target="_blank" rel="noopener">The home <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                    }
                    else
                    {
                        <span>General question about homes.</span>
                    }
                </dd>
            </div>
            <div>
                <dt>Asked</dt>
                <dd>@asked.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(topic))
            {
                <div class="mh-call-caller-wide">
                    <dt>Topic</dt>
                    <dd>@topic</dd>
                </div>
            }
        </dl>
    }

    @if (Model.CallView is { } call)
    {
        <partial name="_CallFrame" model="call" />
    }
    else
    {
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-camera-video-off"></i></span>
            <h2>The call can't be opened</h2>
            <p>@Model.Problem</p>
            <a class="btn btn-secondary" asp-page="/Staff/Calls/Index">Back to calls</a>
        </div>
    }
</div>
