@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
    ViewData["PageWidth"] = "narrow";
}

<div class="card">
    <div class="mh-empty">
        <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-shield-lock"></i></span>
        <p>
            Dear Customer, the resource you are attempting to access is protected.
            You do not have the necessary permissions to view this page.
        </p>
        <a href="/" class="btn btn-primary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Home</a>
    </div>
</div>
