@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div style="display: flex; align-items: center; justify-content: center; height: 80vh;">
    <div style="text-align: center; max-width: 500px; padding: 2rem; border-radius: 12px; box-shadow: 0 5px 20px rgba(0,0,0,0.1); background: #fff;">
        <img src="https://cdn-icons-png.flaticon.com/512/564/564619.png" alt="Access Denied" style="width: 100px; margin-bottom: 1rem;" />
        <h1 style="color: #d9534f;">Access Denied</h1>
        <p style="font-size: 1.1rem; color: #555;">
            Dear Customer, the resource you are attempting to access is prorected.
            You do not have the necessary permissions to view this page.
        </p>
        <a href="/" style="margin-top: 1rem; display: inline-block; padding: 0.5rem 1.5rem; background-color: #007bff; color: white; text-decoration: none; border-radius: 6px;">
            ⬅ Back to Home
        </a>
    </div>
</div>
