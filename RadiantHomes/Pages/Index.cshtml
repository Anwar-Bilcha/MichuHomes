    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Count-up Script
            const counters = document.querySelectorAll('.count');
            const speed = 100; // lower is faster

            const runCountUp = () => {
                counters.forEach(counter => {
                    const updateCount = () => {
                        const target = +counter.getAttribute('data-target');
                        const count = +counter.innerText.replace(/[^0-9]/g, ''); // Remove non-numeric for 'ETB'
                        const increment = Math.ceil(target / speed);

                        if (count < target) {
                            counter.innerText = count + increment;
                            setTimeout(updateCount, 30);
                        } else {
                            counter.innerText = target;
                        }
                    };
                    updateCount();
                });
            };

            let hasRunCountUp = false;
            const observer = new IntersectionObserver(entries => {
                if (entries[0].isIntersecting && !hasRunCountUp) {
                    runCountUp();
                    hasRunCountUp = true;
                }
            }, { threshold: 0.5 }); // Trigger when 50% of the section is visible

            const whyChooseUsSection = document.querySelector('#why-choose-us');
            if (whyChooseUsSection) {
                observer.observe(whyChooseUsSection);
            }

            // Property Search Script (Improved for unique IDs and specific tab content if needed)
            const buySearchInput = document.getElementById('buySearchInput');
            const rentSearchInput = document.getElementById('rentSearchInput');
            const commercialSearchInput = document.getElementById('commercialSearchInput');

            // Generic search function for featured properties below the hero
            const filterPropertyCards = (searchInputId, targetContainerId) => {
                const searchInput = document.getElementById(searchInputId);
                if (!searchInput) return; // Exit if input not found

                searchInput.addEventListener('keyup', function() {
                    const search = this.value.toLowerCase();
                    // Select only cards within the active property tab content (e.g., #apartment, #house, #condo)
                    // This assumes the search in the hero section filters the *displayed* featured homes.
                    document.querySelectorAll(`#${targetContainerId} [data-name]`).forEach(card => {
                        if (card.getAttribute('data-name').includes(search)) {
                            card.closest('.col-md-3, .col-md-4').style.display = 'block'; // Show the parent column
                        } else {
                            card.closest('.col-md-3, .col-md-4').style.display = 'none'; // Hide the parent column
                        }
                    });
                });
            };

            // Initialize search for the active tab (assuming apartment is default active)
            filterPropertyCards('buySearchInput', 'apartment'); // Default to apartment tab content

            // Add event listeners to tab buttons to update which content to filter
            const searchTabButtons = document.querySelectorAll('#searchTab button');
            searchTabButtons.forEach(button => {
                button.addEventListener('shown.bs.tab', function (event) {
                    const targetTabId = event.target.getAttribute('data-bs-target').substring(1); // e.g., 'buy', 'rent', 'commercial'
                    let currentSearchInputId;
                    let currentPropertyContainerId;

                    // Map hero search tabs to property section categories (adjust as per your exact needs)
                    if (targetTabId === 'buy') {
                        currentSearchInputId = 'buySearchInput';
                        currentPropertyContainerId = 'apartment'; // Assuming 'buy' primarily relates to 'Apartment' category
                    } else if (targetTabId === 'rent') {
                        currentSearchInputId = 'rentSearchInput';
                        currentPropertyContainerId = 'condo'; // Example: 'rent' relates to 'Condo'
                    } else if (targetTabId === 'commercial') {
                        currentSearchInputId = 'commercialSearchInput';
                        currentPropertyContainerId = 'commercial'; // Example: 'commercial' relates to 'Commercial'
                    }

                    // Reset filtering for previously active tab's cards
                    document.querySelectorAll('#propertyTabContent [data-name]').forEach(card => {
                        card.closest('.col-md-3, .col-md-4').style.display = 'block';
                    });

                    // Re-attach or apply filter for the newly active tab
                    if (currentSearchInputId && currentPropertyContainerId) {
                         // Re-trigger the filtering with the current value if any
                         const currentInput = document.getElementById(currentSearchInputId);
                         if (currentInput && currentInput.value) {
                             const searchEvent = new KeyboardEvent('keyup', { bubbles: true, cancelable: true });
                             currentInput.dispatchEvent(searchEvent);
                         }
                    }
                });
            });
        });
    </script>
