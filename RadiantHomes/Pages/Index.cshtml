@page
@model RadiantHomes.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<head>
    <style>
        :root {
            --primary-color: #007bff; /* Bootstrap primary blue */
            --text-color: #666;
            --font-size-base: 16px;
        }

        .hero {
            margin: 40px 0; /* Apply margin from top/bottom */
        }

        .hero-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
        }

            .hero-bg img {
                object-fit: cover;
                width: 100%;
                height: 100%;
            }

        .hero-overlay {
            z-index: 0;
        }

        .hero-content {
            z-index: 1;
            width: 90%; /* Ensure content is responsive */
            max-width: 960px; /* Limit content width on large screens */
        }

        .search-box {
            border-radius: 0.75rem; /* More pronounced rounded corners */
        }

        .search-tabs .nav-link {
            color: var(--text-color);
            font-size: var(--font-size-base);
            font-weight: 600;
        }

            .search-tabs .nav-link.active {
                color: var(--primary-color);
                border-color: var(--primary-color) var(--primary-color) transparent;
            }

        .search-input-group .form-control {
            color: var(--text-color);
            font-size: var(--font-size-base);
        }

        .search-input-group .fa-location-dot {
            font-size: 2.2rem; /* Maintain icon size */
            color: var(--text-color);
            padding-right: 0.5rem; /* Space between icon and input */
            display: flex;
            align-items: center; /* Vertically align icon */
        }

        .video-intro-container {
            width: fit-content;
            padding: 1rem 1.5rem; /* Responsive padding */
        }

        /* Property tabs */
        .property-tabs .nav-link {
            color: var(--text-color);
            font-size: var(--font-size-base);
            font-weight: 600;
        }

            .property-tabs .nav-link.active {
                color: var(--primary-color);
                border-color: var(--primary-color) var(--primary-color) transparent;
            }

        /* Glassmorphism effect */
        .glass-card, .glass-bg {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px); /* For Safari */
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 0.75rem;
        }

        .advice-section {
            background-image: url('/images/advice-bg.png'); /* Example background image */
            background-size: cover;
            background-position: center;
        }

        .advice-card {
            background: rgba(255, 255, 255, 0.85); /* Slightly less opaque for better contrast */
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-radius: 1.5rem; /* More rounded */
            padding: 3rem !important;
        }

        .blur-circle {
            animation: pulse 4s infinite alternate; /* Simple animation */
        }

            

        /* Testimonial card improvements */
        .testimonial-card {
            border-radius: 1rem;
        }

            .testimonial-card img {
                object-fit: cover;
            }

        /* Carousel controls custom styling for readability */
        #heroCarousel .carousel-control-prev-icon,
        #heroCarousel .carousel-control-next-icon {
            background-color: rgba(0, 0, 0, 0.6); /* Darker background for visibility */
            border-radius: 50%;
            padding: 1.5rem; /* Larger touch target */
        }

        #houseCarousel .carousel-control-prev-icon,
        #houseCarousel .carousel-control-next-icon {
            filter: invert(100%); /* Make default dark icons visible on light background */
        }


        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .hero-content

        {
            padding: 0 1rem; /* Add horizontal padding for smaller screens */
        }

        .display-4 {
            font-size: 2rem; /* Smaller title on mobile */
        }

        .lead {
            font-size: 1rem; /* Smaller lead text on mobile */
        }

        .search-box {
            padding: 1rem;
        }

        .advice-card {
            padding: 2rem !important;
        }

        }
    </style>
</head>

<body>
    <section class="hero position-relative text-white">
        <div class="hero-bg">
            <img src="~/images/Villa2.jpg" class="img-fluid" alt="Hero background">
            <div class="hero-overlay position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-50"></div>
        </div>

        <div class="hero-content position-absolute top-50 start-50 translate-middle text-center">
            <span class="display-4 fw-bold mb-2" data-translate="HomePage.FirstCoursel.Title">Find Your Dream Home</span>
            <p class="lead mb-4" data-translate="HomePage.FirstCoursel.Text">Explore the best houses across Ethiopia tailored to your needs</p>

            <div class="search-box bg-white text-dark rounded-3 shadow-lg p-3 mx-auto">
                <ul class="nav nav-tabs justify-content-center mb-5 search-tabs" id="searchTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="buy-tab" data-bs-toggle="tab" data-bs-target="#buy" type="button" role="tab" aria-controls="buy" aria-selected="true">Apartments</button>
                    </li>
                    <li class="nav-item fw-bold" role="presentation">
                        <button class="nav-link fw-bold" id="rent-tab" data-bs-toggle="tab" data-bs-target="#rent" type="button" role="tab" aria-controls="rent" aria-selected="false">Condos</button>
                    </li>
                    <li class="nav-item fw-bold" role="presentation">
                        <button class="nav-link" id="commercial-tab" data-bs-toggle="tab" data-bs-target="#commercial" type="button" role="tab" aria-controls="commercial" aria-selected="false">Commercial</button>
                    </li>
                </ul>

                <div class="tab-content" id="searchTabContent">
                    <div class="tab-pane fade show active" id="buy" role="tabpanel" aria-labelledby="buy-tab">
                        <div class="input-group search-input-group">
                            <span class="input-group-text"><i class="fa-solid fa-location-dot"></i></span>
                            <input type="text" id="buySearchInput" class="form-control" placeholder="Search by city, area or house type">
                            <button class="btn btn-secondary px-4">Search</button>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="rent" role="tabpanel" aria-labelledby="rent-tab">
                        <div class="input-group search-input-group">
                            <span class="input-group-text"><i class="fa-solid fa-location-dot"></i></span>
                            <input type="text" id="rentSearchInput" class="form-control" placeholder="Find houses for rent">
                            <button class="btn btn-primary px-4">Search</button>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="commercial" role="tabpanel" aria-labelledby="commercial-tab">
                        <div class="input-group search-input-group">
                            <span class="input-group-text"><i class="fa-solid fa-location-dot"></i></span>
                            <input type="text" id="commercialSearchInput" class="form-control" placeholder="Search commercial properties">
                            <button class="btn btn-primary px-4">Search</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container my-5 border border-white rounded-2 video-intro-container d-flex justify-content-center align-items-center">
                <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" style="text-decoration:none" target="_blank" title="MichuHomes Intro Video">
                    <h5 class="text-center text-white mb-0">
                        <i class="fa-solid fa-circle-play text-white me-2"></i>
                        Explore the Journey
                    </h5>
                </a>
            </div>
            <div class="lead">
                <a asp-page="/LiveVideoMeet" asp-route-roomId="">Join Live Class</a>
            </div>
        </div>
    </section>

    <section id="properties" class="py-5">
        <div class="container">
            <h2 class="text-center mb-4 fw-bold" data-translate="HomePage.FeatureHomes.Section.SaleTitle">Featured Sale Homes</h2>

            <ul class="nav nav-tabs justify-content-center mb-4 property-tabs" id="propertyTabs" role="tablist">
                @foreach (var category in Model.HouseCategories)
                {
                    var categoryId = category.ToLower();
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(category == Model.HouseCategories[0] ? "active" : "")"
                                id="@categoryId-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#@categoryId"
                                type="button"
                                role="tab" aria-controls="@categoryId" aria-selected="@(category == Model.HouseCategories[0] ? "true" : "false")">
                            @category
                        </button>
                    </li>
                }
            </ul>

            <div class="tab-content" id="propertyTabContent">
                @foreach (var category in Model.HouseCategories)
                {
                    var categoryId = category.ToLower();
                    var isActive = category == Model.HouseCategories[0] ? "show active" : "";

                    <div class="tab-pane fade @isActive" id="@categoryId" role="tabpanel" aria-labelledby="@categoryId-tab">
                        <div class="row">
                            @if (category.Equals("Apartment", StringComparison.OrdinalIgnoreCase))
                            {
                                var apartments = Model.ApartmentHouses
                                .Where(h => h.HouseCategory.Name.Equals("Apartment", StringComparison.OrdinalIgnoreCase))
                                .Take(30)
                                .ToList();

                                @if (apartments.Any())
                                {
                                    <div id="houseCarousel" class="carousel slide" data-bs-ride="carousel">
                                        <div class="carousel-inner">
                                            @{
                                                int chunkSize = 4;
                                                var chunkedApts = apartments.Select((apt, index) => new { apt, index })
                                                .GroupBy(x => x.index / chunkSize)
                                                .Select(g => g.Select(x => x.apt).ToList())
                                                .ToList();
                                            }

                                            @for (int i = 0; i < chunkedApts.Count; i++)
                                            {
                                                var group = chunkedApts[i];
                                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                                    <div class="row">
                                                        @foreach (var apt in group)
                                                        {
                                                            <div class="col-md-3 mb-4">
                                                                <div class="card glass-card shadow-sm" data-name="@apt.Title.ToLower()">
                                                                    <img src="/images/Villa2.jpg" class="card-img-top" alt="Apartment @apt.Title">
                                                                    <div class="card-body">
                                                                        <h5 class="card-title">@apt.Title</h5>
                                                                        <p class="card-text">
                                                                            <i class="fa-solid fa-bed"></i> @apt.Bedrooms Beds |
                                                                            <i class="fa-solid fa-house"></i> @apt.TotalRooms Rooms |
                                                                            <i class="fa-solid fa-dollar-sign"></i> @apt.SalePrice
                                                                        </p>
                                                                        <a href="/ApartmentHouses/Details?id=@apt.Id" class="text-center btn btn-outline-primary w-50">View Details</a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                        <div class="col-12 text-center mt-4">
                                                            <a href="/ApartmentHouses" class="btn btn-outline-primary fw-bold">View All Apartment Houses </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <button class="carousel-control-prev" type="button" data-bs-target="#houseCarousel" data-bs-slide="prev">
                                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                            <span class="visually-hidden">Previous</span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target="#houseCarousel" data-bs-slide="next">
                                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                            <span class="visually-hidden">Next</span>
                                        </button>
                                    </div>

                                }
                                else
                                {
                                    <div class="col-12 text-center text-muted">
                                        <p>No Apartment properties found.</p>
                                    </div>
                                }
                            }
                            else
                            {
                                var housesInCategory = Model.FeaturedSalesHomes
                                .Where(h => h.HouseCategory.Name.Equals(category, StringComparison.OrdinalIgnoreCase))
                                .ToList();

                                @if (housesInCategory.Any())
                                {
                                    @foreach (var house in housesInCategory)
                                    {
                                        <div class="col-md-4 mb-4">
                                            <div class="card glass-card shadow-sm" data-name="@house.Title.ToLower()">
                                                <img src="@(string.IsNullOrEmpty(house.MainPhotoUrl) ? "/images/placeholder.jpg" : house.MainPhotoUrl)" class="card-img-top" alt="House @house.Title">
                                                <div class="card-body">
                                                    <h5 class="card-title">@house.Title</h5>
                                                    <p class="card-text">
                                                        <i class="fa-solid fa-bed"></i> @house.TotalBedRooms Beds |
                                                        <i class="fa-solid fa-house"></i> @house.TotalRooms Total Rooms |
                                                        <i class="fa-solid fa-maximize"></i> @house.TotalArea m²
                                                    </p>
                                                    <p class="fw-bold"><i class="fa-solid fa-dollar-sign"></i> @house.Price</p>
                                                    <a href="/Houses/Details?id=@house.Id" class="btn btn-outline-primary w-100">View Details</a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12 text-center text-muted">
                                        <p>No @category properties found.</p>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section id="real-estates" class="py-5">
        <div class="container">
            <h2 class="mb-4 fw-bold text-center" data-translate="HomePage.FeatureHomes.Section.RealEstates">Featured Real Estates</h2>
            <div class="row">
                @foreach (var realestate in Model.RealEstates)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card glass-card shadow-sm" data-name="@realestate.Name.ToLower()">
                            <img src="@(string.IsNullOrEmpty(realestate.LogoUrl) ? "/images/company-placeholder.jpg" : realestate.LogoUrl)" class="card-img-top" alt="Logo of @realestate.Name" style="max-height: 200px; object-fit: contain;"> @* Added max-height and object-fit for logos *@
                            <div class="card-body">
                                <h5 class="card-title">@realestate.Name</h5>
                                <p class="card-text">
                                    <i class="fa-solid fa-calendar-alt"></i> Since @realestate.EstablishedDate.Year |
                                    <i class="fa-solid fa-circle-info"></i> @realestate.Status
                                </p>
                                @{
                                    var Address = Model.Addresses.Where(a => a.AddressID == realestate.AddressId).FirstOrDefault()?.LocationMain;
                                    if (!string.IsNullOrEmpty(Address))
                                    {
                                        <p class="fw-bold"><i class="fa-solid fa-map-marker-alt"></i> @Address</p>
                                    }
                                }
                                <a href="/Realestates/Details?id=@realestate.CompanyId" class="btn btn-outline-primary w-100">View Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="py-5 bg-white" id="why-choose-us">
        <div class="container">
            <h2 class="text-center mb-5 fw-bold">Why Choose <span class="text-primary">RadiantHomes</span>?</h2>

            <div class="row text-center mb-5 justify-content-center">
                <div class="col-md-3 col-6 mb-4">
                    <div class="border rounded p-3 shadow-sm">
                        <h3 class="text-primary fw-bold mb-0"><span class="count" data-target="120">0</span>+</h3>
                        <small class="text-muted">Real Estates</small>
                    </div>
                </div>
                <div class="col-md-3 col-6 mb-4">
                    <div class="border rounded p-3 shadow-sm">
                        <h3 class="text-primary fw-bold mb-0"><span class="count" data-target="5000">0</span>+</h3>
                        <small class="text-muted">Houses Listed</small>
                    </div>
                </div>
                <div class="col-md-3 col-6 mb-4">
                    <div class="border rounded p-3 shadow-sm">
                        <h3 class="text-primary fw-bold mb-0"><span class="count" data-target="1200">0</span>+</h3>
                        <small class="text-muted">Sold / Rented</small>
                    </div>
                </div>
                <div class="col-md-3 col-6 mb-4">
                    <div class="border rounded p-3 shadow-sm">
                        <h3 class="text-primary fw-bold mb-0">ETB <span class="count" data-target="150">0</span>M+</h3>
                        <small class="text-muted">Total Volume</small>
                    </div>
                </div>
            </div>

            <div class="row align-items-center">
                <div class="col-md-6">
                    <ul class="list-group list-group-flush fs-6">
                        <li class="list-group-item">✅ Cheaper Commission Rates</li>
                        <li class="list-group-item">✅ 24/7 Customer Service</li>
                        <li class="list-group-item">✅ Four Languages Support</li>
                        <li class="list-group-item">✅ Strict Property & Document Checks</li>
                    </ul>
                </div>
                <div class="col-md-6 text-center d-none d-md-block">
                    <img src="~/images/why-youchooseus2.png" alt="Why Choose Us" class="img-fluid" style="max-height: 300px;">
                </div>
            </div>
        </div>
    </section>

    <div class="container-fluid p-0">
        <div id="heroCarousel" class="carousel slide carousel-dark" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/images/banner1.jpg" class="d-block w-100 img-fluid" alt="banner1">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded-3 p-3">
                        <h3 class="fw-bold" data-translate="HomePage.FirstCoursel.Title">Find Your Dream Home</h3>
                        <h5 class="text-white" data-translate="HomePage.FirstCoursel.Text">Explore the best houses across Ethiopia that are tailored to your needs</h5>
                    </div>
                </div>

                <div class="carousel-item">
                    <img src="~/images/banner2.jpg" class="d-block w-100 img-fluid" alt="banner2">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded-3 p-3">
                        <h3 class="fw-bold" data-translate="HomePage.SecondCoursel.Title">Buy, Sell or Rent</h3>
                        <h5 class="text-white" data-translate="HomePage.SecondCoursel.Text">All in one platform for Housing solutions</h5>
                    </div>
                </div>

                <div class="carousel-item">
                    <img src="~/images/banner3.jpg" class="d-block w-100 img-fluid" alt="banner3">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded-3 p-3">
                        <h3 class="fw-bold text-white" data-translate="HomePage.ThirdCoursel.Title">Your Trusted Housing Partner</h3>
                        <h5 class="text-white" data-translate="HomePage.ThirdCoursel.Text">Secure deals, expert guidance, smooth transactions</h5>
                    </div>
                </div>

                <div class="carousel-item">
                    <img src="~/images/Villa1.jpg" class="d-block w-100 img-fluid" alt="Villa">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded-3 p-3">
                        <h3 class="fw-bold" data-translate="HomePage.FourthCoursel.Title">Grow Your Business</h3>
                        <h5 class="text-white" data-translate="HomePage.FourthCoursel.Text">If you registered as a Broker we have special discount package.</h5>
                    </div>
                </div>
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>

    <section class="justify-content-between text-center py-5 mb-5">
        <div class="container">
            <h2 class="text-center mb-5 text-uppercase fw-bold" data-translate="HomePage.WhatToDo.Title">
                What are you looking to do?
            </h2>

            <div class="row row-cols-1 row-cols-md-3 g-4">
                <div class="col">
                    <div class="card glass-card h-100 text-center">
                        <div class="card-body">
                            <i class="bi bi-house-door-fill fs-1 text-primary mb-3"></i>
                            <h5 class="card-title" data-translate="HomePage.WhatTodo.Choice1.Title">Buy a House</h5>
                            <p data-translate="HomePage.WhatTodo.Choice1.Text">Browse our listings to find the home of your dreams.</p>
                            <a href="#properties" class="btn btn-outline-primary" data-translate="HomePage.WhatTodo.Choice1.Title">
                                Buy a House
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card glass-card h-100 text-center">
                        <div class="card-body">
                            <i class="bi bi-cash-coin fs-1 text-success mb-3"></i>
                            <h5 class="card-title" data-translate="HomePage.WhatTodo.Choice2.Title">Sell a House</h5>
                            <p data-translate="HomePage.WhatTodo.Choice2.Text">List your house with us and get top value quickly.</p>
                            <a href="#contact" class="btn btn-outline-success" data-translate="HomePage.WhatTodo.Choice2.Title">
                                Sell a House
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card glass-card h-100 text-center">
                        <div class="card-body">
                            <i class="bi bi-door-open-fill fs-1 text-warning mb-3"></i>
                            <h5 class="card-title" data-translate="HomePage.WhatTodo.Choice3.Title">Rent a House</h5>
                            <p data-translate="HomePage.WhatTodo.Choice3.Text">Find a comfortable house to call home temporarily.</p>
                            <a href="#properties" class="btn btn-outline-warning" data-translate="HomePage.WhatTodo.Choice3.Title">
                                Rent a House
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="advice-section text-center my-5 py-5 position-relative overflow-hidden">
        <div class="container position-relative z-1">
            <div class="row justify-content-center">
                <div class="col-md-10 col-lg-8">
                    <div class="advice-card p-5 rounded-4 bg-white bg-opacity-75 shadow-md animate__animated animate__fadeInUp">
                        <div class="mb-4">
                            <i class="bi bi-lightbulb-fill display-3 text-primary"></i>
                        </div>
                        <h2 class="mb-3 fw-semibold text-primary">Seeking Expert Guidance?</h2>
                        <p class="lead mb-4 text-secondary">
                            Our experienced team is ready to assist you through every step of your real estate journey.
                        </p>
                        <a href="/Contact" class="btn btn-outline-primary btn-lg px-5 rounded-pill shadow-sm">
                            <i class="bi bi-chat-dots me-2"></i> Connect with Us
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="blur-circle position-absolute bg-primary opacity-15 rounded-circle" style="width: 180px; height: 180px; top: 20px; left: 20px;"></div>
        <div class="blur-circle position-absolute bg-warning opacity-15 rounded-circle" style="width: 120px; height: 120px; bottom: 10px; right: 10%;"></div>
    </section>

    <section class="py-5 bg-light">
        <div class="container">
            <h2 class="text-center mb-5">What Our Clients Say</h2>
            <div class="row text-center">
                <div class="col-md-4 mb-4">
                    <div class="card h-100 border-0 shadow-lg p-4 glass-bg testimonial-card">
                        <img src="~/images/testimonial1.jpg" class="rounded-circle mx-auto mb-3" width="80" height="80" alt="Client Sarah W.">
                        <blockquote class="blockquote">
                            <p>"RadiantHomes made the buying process so smooth and enjoyable!"</p>
                        </blockquote>
                        <footer class="blockquote-footer">Sarah W., <cite title="Source Title">First-time buyer</cite></footer>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card h-100 border-0 shadow-lg p-4 glass-bg testimonial-card">
                        <img src="~/images/testimonial2.jpg" class="rounded-circle mx-auto mb-3" width="80" height="80" alt="Client James K.">
                        <blockquote class="blockquote">
