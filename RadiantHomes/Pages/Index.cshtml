@section Scripts {
    <script>
        // "Why Choose Michu Homes?" counters: count up from 0 to the server-rendered value when visible.
        (function () {
            var counters = document.querySelectorAll('.count[data-target]');
            var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!counters.length || reduceMotion || !('IntersectionObserver' in window)) return; // keep the final numbers

            var format = new Intl.NumberFormat('en-US');
            function animate(el) {
                var target = parseInt(el.getAttribute('data-target'), 10) || 0;
                var duration = 1200, start = null;
                function step(now) {
                    if (start === null) start = now;
                    var progress = Math.min((now - start) / duration, 1);
                    var eased = 1 - Math.pow(1 - progress, 3);
                    el.textContent = format.format(Math.round(target * eased));
                    if (progress < 1) requestAnimationFrame(step);
                }
                requestAnimationFrame(step);
            }

            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;
                    observer.unobserve(entry.target);
                    animate(entry.target);
                });
            }, { threshold: 0.5 });
            counters.forEach(function (el) { el.textContent = '0'; observer.observe(el); });
        })();

        // "Live chat" opens the Tawk.to widget the layout loads; the button stays hidden until it is ready.
        (function () {
            var button = document.getElementById('openLiveChat');
            if (!button || typeof Tawk_API === 'undefined') return;
            var previousOnLoad = Tawk_API.onLoad;
            Tawk_API.onLoad = function () {
                if (typeof previousOnLoad === 'function') previousOnLoad();
                button.hidden = false;
            };
            button.addEventListener('click', function () {
                if (typeof Tawk_API.maximize === 'function') Tawk_API.maximize();
            });
        })();
    </script>
}
