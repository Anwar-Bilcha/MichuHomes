@page
@model RadiantHomes.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["PageHeader"] = false;
    ViewData["PageWidth"] = "full";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    const string companyLogoFallback = "/images/brand/michu-homes-mark.svg";
}

@section Styles {
    <style>
        /* Hero: base look (.hero, .hero-content, overlay) comes from site.css */
        .mh-home-hero { height: auto; min-height: 84vh; padding: 4rem 0; }
        .mh-home-hero .search-box { max-width: 46rem; text-shadow: none; }
        .mh-hero-link:hover, .mh-hero-link:focus-visible { --bs-bg-opacity: .22; }
        .mh-hero-title { font-size: clamp(2rem, 1.3rem + 3vw, 3.25rem); font-weight: 800; margin-bottom: .75rem; }

        /* Section headings */
        .mh-home-heading { font-size: clamp(1.5rem, 1.2rem + 1.1vw, 2.1rem); margin: .35rem 0 0; }

        /* Company logos sit inside the card frame instead of being cropped */
        .mh-media-card .card-img-top.mh-home-logo { object-fit: contain; max-height: 200px; padding: 1.25rem; background: var(--mh-surface-2); }

        /* Carousel arrows: navy discs that read on photos and on white */
        #heroCarousel .carousel-control-prev-icon,
        #heroCarousel .carousel-control-next-icon,
        #houseCarousel .carousel-control-prev-icon,
        #houseCarousel .carousel-control-next-icon {
            width: 2.75rem;
            height: 2.75rem;
            border-radius: 50%;
            background-color: var(--mh-navy);
            background-size: 1.1rem;
            box-shadow: var(--mh-shadow);
        }

        #heroCarousel .carousel-control-prev,
        #heroCarousel .carousel-control-next { opacity: .9; }
        #houseCarousel .carousel-control-prev,
        #houseCarousel .carousel-control-next { width: 3rem; opacity: 1; }

        #houseCarousel { padding-inline: 3.25rem; }

        @@media (max-width: 575.98px) {
            .mh-home-hero .hero-content { width: 100%; padding-inline: .75rem; }
            .mh-home-hero .search-tabs .nav-link { padding-inline: .6rem; font-size: .875rem; }
            #houseCarousel { padding-inline: 2.75rem; }
            #houseCarousel .carousel-control-prev-icon,
            #houseCarousel .carousel-control-next-icon { width: 2.25rem; height: 2.25rem; }
        }
    </style>
}

<div class="px-2 px-md-3 pt-2 pt-md-3">
    <section class="hero mh-home-hero position-relative text-white">
        <div class="hero-bg" style="opacity:.7">
            <img src="~/images/banner3.jpg" alt="">
            <div class="hero-overlay position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-50"></div>
        </div>

        <div class="hero-content">
            <h1 class="mh-hero-title">Find Your Dream Home</h1>
            <p class="lead mb-4">Explore the best houses across Ethiopia tailored to your needs</p>

            <div class="search-box bg-white text-dark rounded-3 shadow-lg p-3 mx-auto">
                <ul class="nav nav-tabs justify-content-center mb-3 search-tabs" id="searchTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="buy-tab" data-bs-toggle="tab" data-bs-target="#buy" type="button" role="tab" aria-controls="buy" aria-selected="true">Apartments</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="rent-tab" data-bs-toggle="tab" data-bs-target="#rent" type="button" role="tab" aria-controls="rent" aria-selected="false">Condos</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="commercial-tab" data-bs-toggle="tab" data-bs-target="#commercial" type="button" role="tab" aria-controls="commercial" aria-selected="false">Commercial</button>
                    </li>
                </ul>

                @* Each tab submits to the apartment listing, which binds SearchTerm (title / city / sub-city)
                   and HouseType (Residential, Commercial, …) — see Pages/ApartmentHouses/Index.cshtml.cs. *@
                <div class="tab-content" id="searchTabContent">
                    <div class="tab-pane fade show active" id="buy" role="tabpanel" aria-labelledby="buy-tab">
                        <form method="get" asp-page="/ApartmentHouses/Index" role="search" aria-label="Search apartments">
                            <div class="input-group search-input-group">
                                <span class="input-group-text"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
                                <input type="search" id="buySearchInput" name="SearchTerm" class="form-control" placeholder="Search by city, sub-city or title" aria-label="Search apartments">
                                <button type="submit" class="btn btn-accent px-3 px-sm-4" aria-label="Search"><i class="bi bi-search" aria-hidden="true"></i><span class="d-none d-sm-inline"> Search</span></button>
                            </div>
                        </form>
                    </div>
                    <div class="tab-pane fade" id="rent" role="tabpanel" aria-labelledby="rent-tab">
                        <form method="get" asp-page="/ApartmentHouses/Index" role="search" aria-label="Search condos">
                            <div class="input-group search-input-group">
                                <span class="input-group-text"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
                                <input type="search" id="rentSearchInput" name="SearchTerm" class="form-control" placeholder="Search condos by city, sub-city or title" aria-label="Search condos">
                                <button type="submit" class="btn btn-accent px-3 px-sm-4" aria-label="Search"><i class="bi bi-search" aria-hidden="true"></i><span class="d-none d-sm-inline"> Search</span></button>
                            </div>
                        </form>
                    </div>
                    <div class="tab-pane fade" id="commercial" role="tabpanel" aria-labelledby="commercial-tab">
                        <form method="get" asp-page="/ApartmentHouses/Index" role="search" aria-label="Search commercial properties">
                            <input type="hidden" name="HouseType" value="Commercial" />
                            <div class="input-group search-input-group">
                                <span class="input-group-text"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
                                <input type="search" id="commercialSearchInput" name="SearchTerm" class="form-control" placeholder="Search commercial properties by city or title" aria-label="Search commercial properties">
                                <button type="submit" class="btn btn-accent px-3 px-sm-4" aria-label="Search"><i class="bi bi-search" aria-hidden="true"></i><span class="d-none d-sm-inline"> Search</span></button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-center gap-2 gap-sm-3 mt-4">
                <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" target="_blank" rel="noopener" title="MichuHomes Intro Video"
                   class="btn mh-hero-link text-white bg-white bg-opacity-10 border border-white border-opacity-50">
                    <i class="fa-solid fa-circle-play" aria-hidden="true"></i> Explore the Journey
                </a>
                <a asp-page="/LiveVideoMeet" asp-route-roomId=""
                   class="btn mh-hero-link text-white bg-white bg-opacity-10 border border-white border-opacity-50">
                    <i class="bi bi-camera-video" aria-hidden="true"></i> Video Call Live Agents
                </a>
            </div>
        </div>
    </section>
</div>

<section id="properties" class="py-5">
    <div class="container">
        <div class="text-center mb-4">
            <span class="mh-eyebrow">Listings</span>
            <h2 class="mh-home-heading">Featured Sale Homes</h2>
        </div>

        <ul class="nav nav-tabs justify-content-center mb-4 property-tabs" id="propertyTabs" role="tablist">
            @foreach (var category in Model.HouseCategories)
            {
                // Valid, unique element id ("Serviced Apartment" → "cat-serviced-apartment"; the space broke the tab)
                var categoryId = "cat-" + System.Text.RegularExpressions.Regex.Replace(category.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(category == Model.HouseCategories[0] ? "active" : "")"
                            id="@categoryId-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#@categoryId"
                            type="button"
                            role="tab" aria-controls="@categoryId" aria-selected="@(category == Model.HouseCategories[0] ? "true" : "false")">
                        @category
                    </button>
                </li>
            }
        </ul>

        <div class="tab-content" id="propertyTabContent">
            @foreach (var category in Model.HouseCategories)
            {
                // Valid, unique element id ("Serviced Apartment" → "cat-serviced-apartment"; the space broke the tab)
                var categoryId = "cat-" + System.Text.RegularExpressions.Regex.Replace(category.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');
                var isActive = category == Model.HouseCategories[0] ? "show active" : "";

                <div class="tab-pane fade @isActive" id="@categoryId" role="tabpanel" aria-labelledby="@categoryId-tab">
                    <div class="row">
                        @if (category.Equals("Apartment", StringComparison.OrdinalIgnoreCase))
                        {
                            var apartments = Model.FeaturedApartments;

                            @if (apartments.Any())
                            {
                                <div id="houseCarousel" class="carousel slide" data-bs-ride="carousel">
                                    <div class="carousel-inner">
                                        @{
                                            int chunkSize = 4; // This is still controlled by C# for the initial chunking
                                            var chunkedApts = apartments.Select((apt, index) => new { apt, index })
                                            .GroupBy(x => x.index / chunkSize)
                                            .Select(g => g.Select(x => x.apt).ToList())
                                            .ToList();
                                        }

                                        @for (int i = 0; i < chunkedApts.Count; i++)
                                        {
                                            var group = chunkedApts[i];
                                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                                <div class="row g-4">
                                                    @foreach (var apt in group)
                                                    {
                                                        <div class="col-12 col-sm-6 col-md-3">
                                                            <div class="card glass-card mh-media-card h-100" data-name="@apt.Title.ToLower()">
                                                                @if (Model.ApartmentPhotoUrls.TryGetValue(apt.Id, out var aptPhoto))
                                                                {
                                                                    <img src="@aptPhoto" class="card-img-top" alt="Apartment @apt.Title" loading="lazy"
                                                                         onerror="this.onerror=null;this.src='@companyLogoFallback';this.classList.add('mh-home-logo')">
                                                                }
                                                                else
                                                                {
                                                                    @* No photo yet: show the brand mark (contained, like company logos) *@
                                                                    <img src="@companyLogoFallback" class="card-img-top mh-home-logo" alt="">
                                                                }
                                                                <div class="card-body d-flex flex-column">
                                                                    <h3 class="card-title h5">@apt.Title</h3>
                                                                    <p class="card-text small">
                                                                        <i class="fa-solid fa-bed" aria-hidden="true"></i> @apt.Bedrooms Beds |
                                                                        <i class="fa-solid fa-house" aria-hidden="true"></i> @apt.TotalRooms Rooms |
                                                                        <i class="fa-solid fa-dollar-sign" aria-hidden="true"></i> @apt.SalePrice
                                                                    </p>
                                                                    <a href="/ApartmentHouses/Details?id=@apt.Id" class="btn btn-outline-primary btn-sm mt-auto align-self-start">View Details</a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    <div class="col-12 text-center">
                                                        <a href="/ApartmentHouses" class="btn btn-primary">View All Apartment Houses <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <button class="carousel-control-prev" type="button" data-bs-target="#houseCarousel" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Previous</span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#houseCarousel" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Next</span>
                                    </button>
                                </div>

                            }
                            else
                            {
                                <div class="col-12">
                                    <div class="mh-empty">
                                        <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-buildings"></i></span>
                                        <p>No Apartment properties found.</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            var housesInCategory = Model.FeaturedSalesHomes
                            .Where(h => h.HouseCategory.Name.Equals(category, StringComparison.OrdinalIgnoreCase))
                            .ToList();

                            @if (housesInCategory.Any())
                            {
                                @foreach (var house in housesInCategory)
                                {
                                    <div class="col-12 col-sm-6 col-md-4 mb-4">
                                        <div class="card glass-card mh-media-card h-100" data-name="@house.Title.ToLower()">
                                            @if (string.IsNullOrEmpty(house.MainPhotoUrl))
                                            {
                                                @* No photo yet: show the brand mark (contained, like company logos) *@
                                                <img src="@companyLogoFallback" class="card-img-top mh-home-logo" alt="">
                                            }
                                            else
                                            {
                                                <img src="@house.MainPhotoUrl" class="card-img-top" alt="House @house.Title"
                                                     onerror="this.onerror=null;this.src='@companyLogoFallback';this.classList.add('mh-home-logo')">
                                            }
                                            <div class="card-body d-flex flex-column">
                                                <h3 class="card-title h5">@house.Title</h3>
                                                <p class="card-text small">
                                                    <i class="fa-solid fa-bed" aria-hidden="true"></i> @house.TotalBedRooms Beds |
                                                    <i class="fa-solid fa-house" aria-hidden="true"></i> @house.TotalRooms Total Rooms |
                                                    <i class="fa-solid fa-maximize" aria-hidden="true"></i> @house.TotalArea m²
                                                </p>
                                                <p class="fw-bold text-navy"><i class="fa-solid fa-dollar-sign" aria-hidden="true"></i> @house.Price</p>
                                                <a href="/Houses/Details?id=@house.Id" class="btn btn-outline-primary w-100 mt-auto">View Details</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12">
                                    <div class="mh-empty">
                                        <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-house"></i></span>
                                        <p>No @category properties found.</p>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="real-estates" class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-4">
            <span class="mh-eyebrow">Partners</span>
            <h2 class="mh-home-heading">Featured Real Estates</h2>
        </div>
        <div class="row g-4">
            @foreach (var realestate in Model.RealEstates)
            {
                <div class="col-12 col-sm-6 col-md-4">
                    <div class="card glass-card mh-media-card h-100" data-name="@realestate.Name.ToLower()">
                        <img src="@(string.IsNullOrEmpty(realestate.LogoUrl) ? companyLogoFallback : realestate.LogoUrl)" class="card-img-top mh-home-logo" alt="Logo of @realestate.Name"
                             onerror="this.onerror=null;this.src='/images/brand/michu-homes-mark.svg'">
                        <div class="card-body d-flex flex-column">
                            <h3 class="card-title h5">@realestate.Name</h3>
                            <p class="card-text small">
                                <i class="fa-solid fa-calendar-alt" aria-hidden="true"></i> Since @realestate.EstablishedDate.Year |
                                <i class="fa-solid fa-circle-info" aria-hidden="true"></i> @realestate.Status
                            </p>
                            @{
                                var Address = Model.Addresses.Where(a => a.AddressID == realestate.AddressId).FirstOrDefault()?.LocationMain;
                                if (!string.IsNullOrEmpty(Address))
                                {
                                    <p class="fw-bold text-navy"><i class="fa-solid fa-map-marker-alt text-accent" aria-hidden="true"></i> @Address</p>
                                }
                            }
                            <a href="/Realestates/Details?id=@realestate.CompanyId" class="btn btn-outline-primary w-100 mt-auto">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-5" id="why-choose-us">
    <div class="container">
        <div class="text-center mb-5">
            <span class="mh-eyebrow">Why us</span>
            <h2 class="mh-home-heading">Why Choose <span class="text-accent">Michu Homes</span>?</h2>
        </div>

        @* Live counts from IndexModel. The numbers are rendered server-side; the script below only
           animates them up from 0 when they scroll into view (skipped for prefers-reduced-motion). *@
        @{
            var stats = new List<(int Value, string Label)>
            {
                (Model.RealEstateCount, "Real Estates"),
                (Model.ListedHomesCount, "Houses Listed"),
                (Model.ProjectCount, "Projects"),
                (Model.CompletedDealsCount, "Sold / Rented")
            };
        }
        <div class="row g-3 g-md-4 text-center mb-5 justify-content-center">
            @foreach (var stat in stats.Where(s => s.Value > 0))
            {
                <div class="col-md-3 col-6">
                    <div class="card h-100 p-3">
                        <h3 class="mh-stat-value mb-1"><span class="count" data-target="@stat.Value">@stat.Value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span></h3>
                        <p class="mh-stat-label">@stat.Label</p>
                    </div>
                </div>
            }
        </div>

        <div class="row align-items-center">
            <div class="col-md-6">
                <ul class="list-group list-group-flush fs-6">
                    <li class="list-group-item d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-accent" aria-hidden="true"></i> Cheaper Commission Rates</li>
                    <li class="list-group-item d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-accent" aria-hidden="true"></i> 24/7 Customer Service</li>
                    <li class="list-group-item d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-accent" aria-hidden="true"></i> Four Languages Support</li>
                    <li class="list-group-item d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-accent" aria-hidden="true"></i> Strict Property &amp; Document Checks</li>
                </ul>
            </div>
            <div class="col-md-6 text-center d-none d-md-block">
                @* why-youchooseus*.png all have the old "RadiantHomes" brand and made-up figures baked in. *@
                <img src="~/images/banner1.jpg" alt="Modern apartment living room" class="img-fluid rounded-4 shadow-sm w-100 object-fit-cover" style="max-height: 300px;">
            </div>
        </div>
    </div>
</section>

<div class="container">
    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/banner3.jpg" class="d-block w-100 img-fluid" alt="banner1">
                <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 text-white rounded-3 p-3">
                    <h3 class="fw-bold">Find Your Dream Home</h3>
                    <p class="h5 text-white mb-0">Explore the best houses across Ethiopia that are tailored to your needs</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="~/images/banner2.jpg" class="d-block w-100 img-fluid" alt="banner2">
                <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 text-white rounded-3 p-3">
                    <h3 class="fw-bold">Buy, Sell or Rent</h3>
                    <p class="h5 text-white mb-0">All in one platform for Housing solutions</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="~/images/banner3.jpg" class="d-block w-100 img-fluid" alt="banner3">
                <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 text-white rounded-3 p-3">
                    <h3 class="fw-bold text-white">Your Trusted Housing Partner</h3>
                    <p class="h5 text-white mb-0">Secure deals, expert guidance, smooth transactions</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="~/images/Villa1.jpg" class="d-block w-100 img-fluid" alt="Villa">
                <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 text-white rounded-3 p-3">
                    <h3 class="fw-bold">Grow Your Business</h3>
                    <p class="h5 text-white mb-0">If you registered as a Broker we have special discount package.</p>
                </div>
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>

<section class="text-center py-5">
    <div class="container">
        <div class="mb-5">
            <span class="mh-eyebrow">Get started</span>
            <h2 class="mh-home-heading">What are you looking to do?</h2>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <div class="card glass-card h-100 text-center">
                    <div class="card-body p-4">
                        <span class="mh-stat-icon mb-3" aria-hidden="true"><i class="bi bi-house-door-fill"></i></span>
                        <h3 class="card-title h5">Buy a House</h3>
                        <p>Browse our listings to find the home of your dreams.</p>
                        <a href="#properties" class="btn btn-outline-primary">
                            Buy a House
                        </a>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card glass-card h-100 text-center">
                    <div class="card-body p-4">
                        <span class="mh-stat-icon mh-stat-icon--accent mb-3" aria-hidden="true"><i class="bi bi-cash-coin"></i></span>
                        <h3 class="card-title h5">Sell a House</h3>
                        <p>List your house with us and get top value quickly.</p>
                        @* Listing a house needs a house owner profile: visitors register one first,
                           signed-in users go straight to the listing form. *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-page="/Houses/Create" class="btn btn-outline-primary">
                                Sell a House
                            </a>
                        }
                        else
                        {
                            <a asp-page="/HouseOwner/Create" class="btn btn-outline-primary">
                                Sell a House
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card glass-card h-100 text-center">
                    <div class="card-body p-4">
                        <span class="mh-stat-icon mb-3" aria-hidden="true"><i class="bi bi-door-open-fill"></i></span>
                        <h3 class="card-title h5">Rent a House</h3>
                        <p>Find a comfortable house to call home temporarily.</p>
                        <a href="#properties" class="btn btn-outline-primary">
                            Rent a House
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="advice-section text-center py-5 position-relative overflow-hidden">
    <div class="container position-relative z-1">
        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-8">
                <div class="advice-card rounded-4 bg-white bg-opacity-75 shadow p-4 p-md-5">
                    <div class="mb-3">
                        <i class="bi bi-lightbulb-fill fs-1 text-accent" aria-hidden="true"></i>
                    </div>
                    <h2 class="mh-home-heading mb-3">Seeking Expert Guidance?</h2>
                    <p class="lead mb-4 text-secondary">
                        Our experienced team is ready to assist you through every step of your real estate journey.
                    </p>
                    @* There is no contact page: e-mail (same address as the footer), plus the live chat
                       widget once it has loaded. *@
                    <div class="d-flex flex-wrap justify-content-center gap-2">
