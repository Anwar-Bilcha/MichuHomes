@page
@model RadiantHomes.Pages.ApartmentHouses.IndexModel

@{
    ViewData["Title"] = "Apartment houses";
    ViewData["Subtitle"] = "Browse available apartments and filter by type, balcony or real estate company.";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var hasHouses = Model.ApartmentHouse is not null && Model.ApartmentHouse.Any();
}

@* Filters *@
<form method="get" class="card mb-4" role="search" aria-label="Filter apartment houses">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-6 col-lg-3">
                <label for="filterSearchTerm" class="form-label">Search</label>
                <input type="text" id="filterSearchTerm" name="SearchTerm" value="@Model.SearchTerm" placeholder="Search by title or city..." class="form-control" />
            </div>

            <div class="col-6 col-md-3 col-lg-2">
                <label for="filterHouseType" class="form-label">Type</label>
                <select id="filterHouseType" name="HouseType" class="form-select">
                    <option value="">All Types</option>
                    @foreach (var type in Enum.GetValues<HouseTypesCateg>())
                    {
                        <option value="@type" selected="@(string.Equals(Model.HouseType, type.ToString(), StringComparison.OrdinalIgnoreCase))">
                            @type.GetDisplayName()
                        </option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-3 col-lg-2">
                <label for="filterHasBalcony" class="form-label">Balcony</label>
                <select id="filterHasBalcony" name="HasBalcony" class="form-select">
                    <option value="">Balcony?</option>
                    <option value="true" selected="@(Model.HasBalcony == true)">Yes</option>
                    <option value="false" selected="@(Model.HasBalcony == false)">No</option>
                </select>
            </div>

            <!-- Real Estate Name Filter -->
            <div class="col-12 col-md-8 col-lg-3">
                <label for="filterRealEstateName" class="form-label">Real estate</label>
                <input type="text" id="filterRealEstateName" name="RealEstateName" value="@Model.RealEstateName" placeholder="Filter by Real Estate Name" class="form-control" />
            </div>

            <div class="col-12 col-md-4 col-lg-2 d-grid">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel" aria-hidden="true"></i> Filter
                </button>
            </div>
        </div>
    </div>
</form>

@if (hasHouses)
{
    <div class="row g-4">
        @foreach (var house in Model.ApartmentHouse)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card mh-media-card h-100" data-name="@house.Title.ToLower()">
                    @if (Model.PhotoUrls.TryGetValue(house.Id, out var photoUrl))
                    {
                        <img src="@photoUrl" class="card-img-top" alt="Photo of @house.Title" loading="lazy"
                             onerror="this.onerror=null;this.src='/images/brand/michu-homes-mark.svg';this.classList.add('mh-card-logo')">
                    }
                    else
                    {
                        @* No photo yet: the brand mark, contained *@
                        <img src="/images/brand/michu-homes-mark.svg" class="card-img-top mh-card-logo" alt="" loading="lazy">
                    }
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title mb-1">@house.Title</h2>
                        <p class="card-text text-muted small mb-3">
                            <i class="bi bi-geo-alt-fill text-accent" aria-hidden="true"></i>
                            @house.HouseAddress?.City, @house.HouseAddress?.SubCity
                        </p>

                        <ul class="list-unstyled d-flex flex-wrap gap-2 mb-3" aria-label="Features">
                            @if (Model.With3DModel.Contains(house.Id))
                            {
                                <li class="mh-chip mh-chip-3d"><i class="bi bi-badge-3d" aria-hidden="true"></i> 3D view</li>
                            }
                            <li class="mh-chip"><i class="fa-solid fa-bed" aria-hidden="true"></i> @house.Bedrooms Beds</li>
                            <li class="mh-chip"><i class="fa-solid fa-door-open" aria-hidden="true"></i> @house.TotalRooms Total Rooms</li>
                            <li class="mh-chip"><i class="fa-solid fa-bath" aria-hidden="true"></i> @house.Bathrooms Bath Rooms</li>
                            <li class="mh-chip" title="Parking"><i class="fa-solid fa-car" aria-hidden="true"></i><span class="visually-hidden">Parking:</span> @house.HasParking</li>
                        </ul>

                        <p class="mh-listing-price mt-auto mb-3">
                            @if (house.SalePrice > 0)
                            {
                                @ApartmentHouseForm.Price(house.SalePrice, house.Currency)
                            }
                            else
                            {
                                <span class="text-muted fw-normal fs-6">Price not listed</span>
                            }
                        </p>
                        <a href="/ApartmentHouses/Details?id=@house.Id" class="btn btn-outline-primary w-100">
                            <i class="bi bi-eye" aria-hidden="true"></i> View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-house-door"></i></span>
            <h2>No apartment houses found</h2>
            <p>Try a different search, or clear the filters to see every available apartment.</p>
            <a class="btn btn-secondary" asp-page="./Index">Clear filters</a>
        </div>
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Apartment pages">
        <ul class="pagination justify-content-center flex-wrap">
            @for (int pageN = 1; pageN <= Model.TotalPages; pageN++)
            {
                <li class="page-item @(Model.PageNumber == pageN ? "active" : "")">
                    <a asp-page="./Index" asp-all-route-data="Model.FilterRouteValues" asp-route-pageNumber="@pageN" class="page-link" aria-current="@(Model.PageNumber == pageN ? "page" : null)">@pageN</a>
                </li>
            }
        </ul>
    </nav>
}

@section Styles {
    <style>
        .mh-listing-price { font-family: var(--mh-font-display); font-size: 1.25rem; font-weight: 800; color: var(--mh-navy); }
        .mh-media-card .mh-chip { font-weight: 500; }
        .mh-media-card .card-img-top.mh-card-logo { object-fit: contain; padding: 1.25rem; background: var(--mh-surface-2); }
    </style>
}

@section Scripts {
    <script>
        // Client-side filter for cards tagged with data-realestate (only when the filter input exists)
        const realEstateFilter = document.getElementById('realEstateFilter');
        if (realEstateFilter) {
            realEstateFilter.addEventListener('input', function () {
                const filter = this.value.trim().toLowerCase();
                const cards = document.querySelectorAll('.card[data-realestate]');

                cards.forEach(card => {
                    const realEstate = card.dataset.realestate || '';
                    if (realEstate.includes(filter)) {
                        card.parentElement.style.display = ''; // Show
                    } else {
                        card.parentElement.style.display = 'none'; // Hide
                    }
                });
            });
        }
    </script>
}
