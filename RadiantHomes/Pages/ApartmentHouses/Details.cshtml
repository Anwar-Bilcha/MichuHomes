@page
@model RadiantHomes.Pages.ApartmentHouses.DetailsModel

@{
    ViewData["Title"] = "Apartment House Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<!-- Include Swiper for slider -->


<div class="container border-0 py-3">
    <div class="row border-0">
        <!-- Left: Main House Details (75%) -->
        <div class="col-md-9 border-0">
            <div class="card rounded-0 border-0">
                <div class="card-header rounded border-0 bg-white text-dark">
                    <p class="card-header lead mb-0">🏡 Apartment House Details for   
                    <span class="fs-5 text-dark mb-0 fw-semibold"> @Model.ApartmentHouse.Title </span>
                    </p>
                </div>
                <div class="card-body">
                 

<div class="w-100 py-1">
    <div class="card rounded-4 border-0" style="max-width: 1400px;">
        <div class="card-body">
                                
            <div class="mb-4 flex-column" style="padding-top:0px">
                <p class="lead">
                    <span class="fs-5 text-dark mb-1 fw-300"> @Model.ApartmentHouse.Title </span>
                    <i class="bi bi-geo-alt-fill"></i>
                    From <strong>@Model.CompanyName</strong> Real Estate
                <span class="fs-4 fw-semibold text-success">ETB @Model.ApartmentHouse.SalePrice.ToString("N0")</span>
                <span class="text-body">@Model.ApartmentHouse.Description</span>
                </p>
            </div>

            
            <div class="d-flex flex-wrap justify-content-between text-center gap-1">

                <div class="flex-column">
                    <i class="fa-solid fa-bed text-warning" style="font-size: 2.5rem;"></i>
                    <div>Bedrooms: <br><strong>@Model.ApartmentHouse.Bedrooms</strong></div>
                </div>
                <div class="flex-column">
                    <i class="fa-solid fa-shower text-success" style="font-size: 2.5rem;"></i>
                    <div>Total Rooms: <br><strong>@Model.ApartmentHouse.TotalRooms</strong></div>
                </div>


                <div class="flex-column">
                    <i class="fa fa-building text-danger" style="font-size: 2rem;"></i>
                    <div>Floor Number: <br><strong>@Model.ApartmentHouse.FloorNumber</strong></div>
                </div>
                <div class="flex-column">
                    <i class="fa fa-buy text-secondary" style="font-size: 2rem;"></i>
                    <div>Available For: <br><strong>@Model.ApartmentHouse.AvailableFor</strong></div>
                </div>
            </div>
            <input type="hidden" asp-for="CompanyName" />

            <!-- Full-width Auto-sliding Swiper -->


            <h5 class="mb-3 card-header">Photos</h5>
            <div class="swiper mySwiper rounded-4" style="max-height: 400px;">
                <div class="swiper-wrapper">
                    
                    @foreach (var photoPath in Model.Photos)
                    {
                        <div class="swiper-slide">
                            <img src="@Url.Content(photoPath)" class="img-fluid w-100" style="height: 500px; object-fit: cover;" />
                        </div>
                    }
                </div>
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-pagination"></div>
               </div>

            <script>
                var swiper = new Swiper(".mySwiper", {
                    loop: true,
                    autoplay: {
                        delay: 30000,
                        disableOnInteraction: false,
                    },
                    pagination: {
                        el: ".swiper-pagination",
                        clickable: true,
                    },
                    navigation: {
                        nextEl: ".swiper-button-next",
                        prevEl: ".swiper-button-prev",
                    },
                });
            </script>
                                <h4 class="mt-5 mb-3">Customer Reviews</h4>

                                @if (Model.ApartmentHouse.Reviews != null && Model.Reviews.Any())
                                {
                                    <div class="row row-cols-1 row-cols-md-2 g-4">
                                        <div class="mt-4">
                                            @foreach (var review in Model.Reviews.OrderByDescending(r => r.ReviewDate))
                                            {
                                                <div class="d-flex mb-4">
                                                    <div class="me-3">
                                                        <img src="~/images/default-profile.png" class="rounded-circle" width="48" height="48" alt="User Avatar" />
                                                    </div>
                                                    <div class="bg-light rounded p-3 shadow-sm w-100">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <strong>@review.ReviewerCustomer?.FirstName @review.ReviewerCustomer?.LastName</strong>
                                                            <small class="text-muted">@review.ReviewDate.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</small>
                                                        </div>
                                                        <div class="text-warning mb-1">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                                            }
                                                        </div>
                                                        <div class="text-dark">@review.Comment</div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-light border rounded-4">
                                        <p class="text-muted mb-0">No reviews yet for this house. Be the first to leave a review!</p>
                                    </div>
                                }
                                <hr class="my-4" />
                                <h5 class="mb-3">Leave a Review</h5>
                                <form method="post" asp-page-handler="SubmitReview" asp-route-itemid="@Model.ApartmentHouse.Id" id="review-form">
                                    <input type="hidden" asp-for="HouseReviews.HouseId" />
                                    <div class="d-flex mb-4">
                                        <div class="me-3">
                                            <img src="~/images/default-profile.png" class="rounded-circle" width="48" height="48" alt="User Avatar" />
                                        </div>
                                        <div class="w-100">
                                            <div class="mb-2">
                                                <textarea name="HouseReviews.Comment" class="form-control" placeholder="Write a comment..." rows="3" required></textarea>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <label class="me-2 fw-semibold">Rating:</label>
                                                    <select name="HouseReviews.Rating" class="form-select d-inline w-auto" required>
                                                        <option value="">--</option>
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <option value="@i">@i ★</option>
                                                        }
                                                    </select>
                                                </div>
                                                <button type="submit" class="btn btn-primary rounded-pill px-4">Post</button>
                                            </div>
                                        </div>
                                    </div>
                                </form>

            <hr class="my-4">
            
            <!-- Actions -->
            <div class="d-flex flex-wrap gap-3 mt-5 justify-content-center">
                                    <button class="btn btn-warning rounded-pill px-4 py-2" data-bs-toggle="modal" data-bs-target="#reserveModal">
                                        <i class="bi bi-calendar-check me-2"></i> Reserve House
                                    </button>

               
                                <a asp-page="/Houses/Actions/Complaints/Create" asp-route-id="@Model.ApartmentHouse.Id" class="btn btn-outline-danger rounded-pill px-4 py-2">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i> Report
                </a>
            </div>
        </div>
    </div>
</div>

                    ...
                </div>
            </div>
        </div>

        <!-- Right: Similar Houses (25%) -->
        <div class="col-md-3 mt-4 mt-md-4">
            <div class="card rounded-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Similar Houses</h5>
                </div>
                <div class="card-body p-3">
                    @if (Model.SimilarHouses != null && Model.SimilarHouses.Any())
                    {
                        <ul class="list-unstyled">
                            @foreach (var house in Model.SimilarHouses)
                            {
                                <li class="mb-3">
                                    <a asp-page="/ApartmentHouses/Details" asp-route-id="@house.Id" class="text-decoration-none">
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="~/images/Villa2.jpg" class="rounded" alt="House" style="width: 60px; height: 60px; object-fit: cover;" />
                                            <div>
                                                <h6 class="mb-0">@house.Title</h6>
                                                <p class="mb-1">@house.Building.Project.Company.Name</p>
                                                <small class="text-muted">ETB @house.SalePrice.ToString("N0")</small>
                                            </div>
                                        </div>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No similar houses found.</p>
                    }
                </div>
            </div>
        </div>
    </div>
    <!-- House Review Modal -->
    <!-- Reserve House Modal -->
    <!-- Reserve House Modal -->
    <div class="modal fade" id="reserveModal" tabindex="-1" aria-labelledby="reserveModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header">
                    <h5 class="modal-title" id="reserveModalLabel">Reserve This Apartment House</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form method="post" asp-page-handler="ReserveHouse" asp-route-itemid="@Model.ApartmentHouse.Id">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">

                        <!-- Hidden Fields from Transaction -->
                        <input type="hidden" asp-for="Transaction.ApartmentHouseId" />
                        <input type="hidden" asp-for="Transaction.CustomerId" />
                        <input type="hidden" asp-for="Transaction.OwnerId" />

                        <!-- Customer Name (Optional if logged in) -->
                        <div class="mb-3">
                            <label asp-for="CustomerName" class="form-label">Your Name</label>
                            <input asp-for="CustomerName" class="form-control" required />
                        </div>

                        <!-- Optional Notes -->
                        <div class="mb-3">
                            <label asp-for="Transaction.Notes" class="form-label">Reservation Notes</label>
                            <textarea asp-for="Transaction.Notes" class="form-control" rows="3" placeholder="Any specific requests or info?"></textarea>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success rounded-pill px-4">Reserve</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>
