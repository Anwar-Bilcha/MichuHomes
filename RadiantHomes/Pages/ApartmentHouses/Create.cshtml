@page
@model RadiantHomes.Pages.ApartmentHouses.CreateModel
@{
    ViewData["Title"] = "New apartment";
    ViewData["Subtitle"] = "Add one apartment by hand, or many at once from an Excel file.";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

@section PageActions {
    <a asp-page="Index" class="btn btn-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list</a>
}

<ul class="nav nav-tabs mb-4" id="createApartmentTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="manual-tab" data-bs-toggle="tab" data-bs-target="#manual" type="button" role="tab" aria-controls="manual" aria-selected="true">
            <i class="bi bi-pencil-square me-1" aria-hidden="true"></i> Manual Entry
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="excel-tab" data-bs-toggle="tab" data-bs-target="#excel" type="button" role="tab" aria-controls="excel" aria-selected="false">
            <i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i> Bulk Upload (Excel)
        </button>
    </li>
</ul>

@if (Model.Errors.Any())
{
    <div class="alert alert-danger" role="alert">
        <p class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> The Excel upload could not be completed:</p>
        <ul class="mb-0">
            @foreach (var error in Model.Errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<div class="tab-content" id="createApartmentTabsContent">
    <!-- Manual Entry Form -->
    <div class="tab-pane fade show active" id="manual" role="tabpanel" aria-labelledby="manual-tab">
        <form method="post" enctype="multipart/form-data" class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mh-fieldset">
                    <h2 class="mh-fieldset-title">Basic Info</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ApartmentHouse.Title" class="form-label"></label>
                            <input asp-for="ApartmentHouse.Title" class="form-control" />
                            <span asp-validation-for="ApartmentHouse.Title" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ApartmentHouse.HouseNumber" class="form-label"></label>
                            <input asp-for="ApartmentHouse.HouseNumber" class="form-control" />
                            <span asp-validation-for="ApartmentHouse.HouseNumber" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ApartmentHouse.Description" class="form-label"></label>
                            <textarea asp-for="ApartmentHouse.Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="ApartmentHouse.Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mh-fieldset">
                    <h2 class="mh-fieldset-title">Pricing</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ApartmentHouse.SalePrice" class="form-label"></label>
                            <input asp-for="ApartmentHouse.SalePrice" class="form-control" type="number" min="0" step="any"
                                   data-val-range="Sale price can&#39;t be negative." data-val-range-min="0" data-val-range-max="1000000000000" />
                            <span asp-validation-for="ApartmentHouse.SalePrice" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ApartmentHouse.Currency" class="form-label"></label>
                            <select asp-for="ApartmentHouse.Currency" class="form-select" asp-items="ApartmentHouseForm.CurrencyItems(Model.ApartmentHouse?.Currency)">
                                <option value="">-- Select Currency --</option>
                            </select>
                            <span asp-validation-for="ApartmentHouse.Currency" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Location -->
                <div class="mh-fieldset">
                    <h2 class="mh-fieldset-title">Location</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ApartmentHouse.BuildingId" class="form-label"></label>
                            <select asp-for="ApartmentHouse.BuildingId" class="form-select" asp-items="ViewBag.BuildingId">
                                <option value="">-- Select Building --</option>
                            </select>
                            <span asp-validation-for="ApartmentHouse.BuildingId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ApartmentHouse.HouseCategoryId" class="form-label"></label>
                            <select asp-for="ApartmentHouse.HouseCategoryId" class="form-select" asp-items="ViewBag.HouseCategoryId">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="ApartmentHouse.HouseCategoryId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ApartmentHouse.AddressId" class="form-label"></label>
                            <select asp-for="ApartmentHouse.AddressId" class="form-select" asp-items="ViewBag.AddressId">
                                <option value="">-- Select Address --</option>
                            </select>
                            <span asp-validation-for="ApartmentHouse.AddressId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Specifications -->
                <div class="mh-fieldset">
                    <h2 class="mh-fieldset-title">Specifications</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ApartmentHouse.HouseType" class="form-label"></label>
                            <select asp-for="ApartmentHouse.HouseType" class="form-select"
                                    asp-items="@(Enum.GetValues<HouseTypesCateg>().Select(t => new SelectListItem(t.GetDisplayName(), t.ToString())))"></select>
                            <span asp-validation-for="ApartmentHouse.HouseType" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ApartmentHouse.AvailableFor" class="form-label"></label>
                            <select asp-for="ApartmentHouse.AvailableFor" class="form-select"
                                    asp-items="@(ApartmentHouseForm.AvailableForOptions.Select(o => new SelectListItem(o.Text, o.Value)))">
                                <option value="">-- Select Availability --</option>
                            </select>
                            <span asp-validation-for="ApartmentHouse.AvailableFor" class="text-danger"></span>
                        </div>
                        <partial name="_ApartmentNumbers" for="ApartmentHouse" />
                    </div>
                </div>

                <!-- Amenities -->
                <div class="mh-fieldset">
                    <h2 class="mh-fieldset-title">Availability &amp; amenities</h2>
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="ApartmentHouse.IsAvailable" aria-describedby="isAvailableHelp" />
                                <label class="form-check-label" asp-for="ApartmentHouse.IsAvailable">Available for buyers or tenants</label>
                            </div>
                            <div id="isAvailableHelp" class="form-text">Only available, approved apartments are shown in the public listing.</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="ApartmentHouse.HasBalcony" />
                                <label class="form-check-label" asp-for="ApartmentHouse.HasBalcony">@Html.DisplayNameFor(model => model.ApartmentHouse.HasBalcony)</label>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="ApartmentHouse.HasElevator" />
                                <label class="form-check-label" asp-for="ApartmentHouse.HasElevator">@Html.DisplayNameFor(model => model.ApartmentHouse.HasElevator)</label>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="ApartmentHouse.HasParking" />
                                <label class="form-check-label" asp-for="ApartmentHouse.HasParking">@Html.DisplayNameFor(model => model.ApartmentHouse.HasParking)</label>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="ApartmentHouse.IsFurnished" />
                                <label class="form-check-label" asp-for="ApartmentHouse.IsFurnished">@Html.DisplayNameFor(model => model.ApartmentHouse.IsFurnished)</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Apartment Photos -->
                <div class="mh-fieldset">
                    <h2 class="mh-fieldset-title">Apartment Photos</h2>
                    <p class="form-text mt-0">JPG, PNG, GIF or WebP, up to 10 MB each.</p>
                    <div id="photo-section">
                        <div class="photo-item mh-photo-item">
                            <label class="form-label">Photo</label>
                            <input type="file" name="Photos[0].PhotoFile" class="form-control mb-2" accept=".jpg,.jpeg,.png,.gif,.webp" />
                            <label class="form-label">Description</label>
                            <input type="text" name="Photos[0].Description" class="form-control" placeholder="e.g. Front View" />
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addPhotoInput()"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Another Photo</button>
                </div>

                <partial name="_ApartmentModelField" model="new ApartmentModel3D.Field(null)" />

                <div class="mh-form-actions">
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Create Apartment</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Excel Upload -->
    <div class="tab-pane fade" id="excel" role="tabpanel" aria-labelledby="excel-tab">
        <form method="post" enctype="multipart/form-data" asp-page-handler="UploadExcel" class="card">
            <div class="card-header">
                <h2 class="mh-section-title"><i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i> Bulk Upload (Excel)</h2>
            </div>
            <div class="card-body">
                <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <span>You can download the system-generated Excel format here:</span>
                    <a class="btn btn-sm btn-outline-primary" asp-page-handler="DownloadTemplate" data-no-loader><i class="bi bi-download" aria-hidden="true"></i> Download Template</a>
                </div>

                <label for="excelFile" class="form-label">Upload Excel File</label>
                <input type="file" asp-for="@Model.ExcelFile" name="ExcelFile" id="excelFile" class="form-control" accept=".xlsx" required />
                <input type="hidden" asp-for="BuildingId" id="buildingId" class="form-control" accept=".xlsx" required />

                <div class="mh-form-actions">
                    <button asp-page-handler="BulkExcelUpload" type="submit" class="btn btn-primary"><i class="bi bi-upload" aria-hidden="true"></i> Upload &amp; Create Apartments</button>
                </div>
            </div>
        </form>
    </div>
</div>


@section Styles {
    <style>
        .mh-photo-item { margin-bottom: 1rem; padding: 1rem; border: 1px solid var(--mh-border); border-radius: var(--mh-radius-sm); background: var(--mh-surface-2); }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let photoIndex = 1;
        function addPhotoInput() {
            const t = (window.MichuI18n ? MichuI18n.t : (s => s));
            const section = document.getElementById("photo-section");
            const html = `
                <div class="photo-item mh-photo-item">
                    <label class="form-label">${t("Photo")}</label>
                    <input type="file" name="Photos[${photoIndex}].PhotoFile" class="form-control mb-2" accept=".jpg,.jpeg,.png,.gif,.webp" />
                    <label class="form-label">${t("Description")}</label>
                    <input type="text" name="Photos[${photoIndex}].Description" class="form-control" />
                    <button type="button" class="btn btn-sm btn-outline-danger mt-2" onclick="this.parentElement.remove()">${t("Remove")}</button>
                </div>`;
            section.insertAdjacentHTML("beforeend", html);
            photoIndex++;
        }
    </script>
}
