@page
@using RadiantHomes.DAL @* Make sure MichuHomesRoles is accessible *@
@model RadiantHomes.Pages.RealEstates.IndexModel

@{
    ViewData["Title"] = "Real estate companies";
    ViewData["Subtitle"] = "Housing companies registered on Michu Homes.";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var canManage = User.IsInRole(MichuHomesRoles.MichuAdmin) || User.IsInRole(MichuHomesRoles.RealEstateAdmin);
}

@section PageActions {
    @* The "New company" button is only for MichuAdmin/RealEstateAdmin *@
    @if (User.IsInRole(MichuHomesRoles.MichuAdmin) || User.IsInRole(MichuHomesRoles.RealEstateAdmin))
    {
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New company
        </a>
    }
}

@if (Model.HousingCompany != null && Model.HousingCompany.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var item in Model.HousingCompany)
        {
            <div class="col">
                <div class="card mh-media-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            @if (!string.IsNullOrEmpty(item.LogoUrl))
                            {
                                <img src="@item.LogoUrl" alt="@item.Name Logo" class="company-logo" />
                            }
                            else
                            {
                                <div class="company-logo company-logo--placeholder" aria-hidden="true">
                                    <i class="bi bi-building"></i>
                                </div>
                            }
                            <div class="mh-min-w-0">
                                <h2 class="h5 card-title mb-0">@item.Name</h2>
                                <small class="text-muted">@item.CompanyCategory.GetDisplayName()</small>
                            </div>
                        </div>

                        <dl class="mh-company-facts">
                            <dt>License</dt>
                            <dd>@item.LicenseNumber</dd>
                            <dt>Established</dt>
                            <dd>@item.EstablishedDate.ToShortDateString()</dd>
                            <dt>Address</dt>
                            <dd>@(item.Address?.City ?? "N/A")</dd>
                            <dt>Email</dt>
                            <dd>@item.Email</dd>
                            <dt>Phone</dt>
                            <dd>@item.PhoneNumber</dd>
                            <dt>Website</dt>
                            <dd>
                                @if (!string.IsNullOrEmpty(item.Website))
                                {
                                    <a href="@(item.Website.StartsWith("http") ? item.Website : "http://" + item.Website)" target="_blank" rel="noopener">@item.Website</a>
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </dd>
                            <dt>Status</dt>
                            <dd><span class="badge @(item.Status == "Active" ? "bg-success" : "bg-warning")">@item.Status</span></dd>
                        </dl>
                    </div>
                    <div class="card-footer d-flex align-items-center gap-2">
                        <a asp-page="./Details" asp-route-id="@item.CompanyId" class="btn btn-primary btn-sm me-auto">
                            <i class="bi bi-eye" aria-hidden="true"></i> View details
                        </a>
                        @* Conditional rendering for Edit and Delete buttons *@
                        @if (User.IsInRole(MichuHomesRoles.MichuAdmin) || User.IsInRole(MichuHomesRoles.RealEstateAdmin))
                        {
                            <a asp-page="./Edit" asp-route-id="@item.CompanyId" class="btn btn-sm btn-outline-primary btn-icon" title="Edit Company" aria-label="Edit @item.Name">
                                <i class="bi bi-pencil" aria-hidden="true"></i>
                            </a>
                            <a asp-page="./Delete" asp-route-id="@item.CompanyId" class="btn btn-sm btn-outline-danger btn-icon" title="Delete Company" aria-label="Delete @item.Name">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-building"></i></span>
            <h2>No Housing Companies Found!</h2>
            <p>It looks like there are no housing companies registered yet. Be the first to add one!</p>
            @if (canManage)
            {
                <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> New company</a>
            }
            else
            {
                <p class="mb-0">Please contact an administrator to add new companies.</p>
            }
        </div>
    </div>
}

@section Styles {
    <style>
        .company-logo { flex: 0 0 auto; width: 64px; height: 64px; object-fit: contain; padding: .35rem; border-radius: var(--mh-radius-sm); border: 1px solid var(--mh-border); background: var(--mh-surface); }
        .company-logo--placeholder { display: flex; align-items: center; justify-content: center; font-size: 1.6rem; color: var(--mh-navy); background: var(--mh-navy-50); }
        .mh-min-w-0 { min-width: 0; }
        .mh-company-facts { display: grid; grid-template-columns: auto 1fr; gap: .4rem 1rem; margin: 0; font-size: .875rem; }
        .mh-company-facts dt { font-weight: 500; color: var(--mh-ink-3); }
        .mh-company-facts dd { margin: 0; color: var(--mh-ink); word-break: break-word; }
    </style>
}
