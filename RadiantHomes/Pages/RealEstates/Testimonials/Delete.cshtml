@page
@model RadiantHomes.Pages.RealEstates.Testimonials.DeleteModel

@{
    ViewData["Title"] = "Delete testimonial";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="card mh-confirm">
    <div class="card-header">
        <h2 class="mh-section-title text-reset"><i class="bi bi-exclamation-triangle text-reset" aria-hidden="true"></i> Are you sure you want to delete this testimonial?</h2>
    </div>
    <div class="card-body">
        <p class="text-muted">This permanently removes the record below. It can't be undone.</p>
        <dl class="mh-dl">
            <dt>@Html.DisplayNameFor(model => model.CustomerTestimonial.Category)</dt>
            <dd>@Html.DisplayFor(model => model.CustomerTestimonial.Category)</dd>
            <dt>@Html.DisplayNameFor(model => model.CustomerTestimonial.CustomerName)</dt>
            <dd>@Html.DisplayFor(model => model.CustomerTestimonial.CustomerName)</dd>
            <dt>@Html.DisplayNameFor(model => model.CustomerTestimonial.TestimonialText)</dt>
            <dd>@Html.DisplayFor(model => model.CustomerTestimonial.TestimonialText)</dd>
            <dt>@Html.DisplayNameFor(model => model.CustomerTestimonial.SubmissionDate)</dt>
            <dd>@(Model.CustomerTestimonial.SubmissionDate == default ? "—" : Model.CustomerTestimonial.SubmissionDate.ToString("MMM d, yyyy"))</dd>
            <dt>@Html.DisplayNameFor(model => model.CustomerTestimonial.Company)</dt>
            <dd>@(Model.CustomerTestimonial.Company?.Name ?? "—")</dd>
            <dt>@Html.DisplayNameFor(model => model.CustomerTestimonial.Customer)</dt>
            <dd>@(Model.CustomerTestimonial.Customer is { } customer ? $"{customer.FirstName} {customer.LastName}" : "—")</dd>
            <dt>@Html.DisplayNameFor(model => model.CustomerTestimonial.Rating)</dt>
            <dd>@Html.DisplayFor(model => model.CustomerTestimonial.Rating)</dd>
            <dt>@Html.DisplayNameFor(model => model.CustomerTestimonial.CreatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.CustomerTestimonial.CreatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.CustomerTestimonial.CreatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.CustomerTestimonial.CreatedOn)</dd>
            <dt>@Html.DisplayNameFor(model => model.CustomerTestimonial.UpdatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.CustomerTestimonial.UpdatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.CustomerTestimonial.UpdatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.CustomerTestimonial.UpdatedOn)</dd>
        </dl>

        <form method="post" class="mh-form-actions">
            <input type="hidden" asp-for="CustomerTestimonial.Id" />
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash" aria-hidden="true"></i> Delete testimonial</button>
        </form>
    </div>
</div>
