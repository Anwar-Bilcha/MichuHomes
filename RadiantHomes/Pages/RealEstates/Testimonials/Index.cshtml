@page
@model RadiantHomes.Pages.RealEstates.Testimonials.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CustomerTestimonial[0].Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerTestimonial[0].CustomerName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerTestimonial[0].TestimonialText)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerTestimonial[0].SubmissionDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerTestimonial[0].Company)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerTestimonial[0].Customer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerTestimonial[0].Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerTestimonial[0].CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerTestimonial[0].CreatedOn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerTestimonial[0].UpdatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerTestimonial[0].UpdatedOn)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.CustomerTestimonial) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Category)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CustomerName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TestimonialText)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SubmissionDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Company.CompanyId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Rating)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedOn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedOn)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
