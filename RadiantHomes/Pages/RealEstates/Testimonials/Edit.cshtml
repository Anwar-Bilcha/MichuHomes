@page
@model RadiantHomes.Pages.RealEstates.Testimonials.EditModel

@{
    ViewData["Title"] = "Edit testimonial";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<form method="post" class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="CustomerTestimonial.Id" />

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Testimonial</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CustomerTestimonial.CustomerId" class="form-label"></label>
                    <select asp-for="CustomerTestimonial.CustomerId" class="form-select" asp-items="ViewBag.CustomerId"></select>
                    <span asp-validation-for="CustomerTestimonial.CustomerId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CustomerTestimonial.CompanyId" class="form-label"></label>
                    <select asp-for="CustomerTestimonial.CompanyId" class="form-select" asp-items="ViewBag.CompanyId"></select>
                    <span asp-validation-for="CustomerTestimonial.CompanyId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CustomerTestimonial.Category" class="form-label"></label>
                    <input asp-for="CustomerTestimonial.Category" class="form-control" />
                    <span asp-validation-for="CustomerTestimonial.Category" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CustomerTestimonial.CustomerName" class="form-label"></label>
                    <input asp-for="CustomerTestimonial.CustomerName" class="form-control" />
                    <span asp-validation-for="CustomerTestimonial.CustomerName" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="CustomerTestimonial.TestimonialText" class="form-label"></label>
                    <input asp-for="CustomerTestimonial.TestimonialText" class="form-control" />
                    <span asp-validation-for="CustomerTestimonial.TestimonialText" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CustomerTestimonial.SubmissionDate" class="form-label"></label>
                    <input asp-for="CustomerTestimonial.SubmissionDate" class="form-control" />
                    <span asp-validation-for="CustomerTestimonial.SubmissionDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CustomerTestimonial.Rating" class="form-label"></label>
                    <input asp-for="CustomerTestimonial.Rating" class="form-control" />
                    <span asp-validation-for="CustomerTestimonial.Rating" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mh-form-actions">
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save changes</button>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
