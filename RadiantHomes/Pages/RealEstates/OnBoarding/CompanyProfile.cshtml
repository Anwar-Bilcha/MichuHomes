@page
@model RadiantHomes.Pages.RealEstates.OnBoarding.Profile.CreateModel

@{
    ViewData["Title"] = "Onboarding: company profile";
    ViewData["Subtitle"] = "Step 1 of 4. Register the housing company that will list projects and apartments.";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

@* Onboarding stepper *@
<nav aria-label="Onboarding progress">
    <div class="stepper-wrapper">
        <div class="stepper-item active" aria-current="step">
            <div class="step-counter">1</div>
            <div class="step-name">Company Profile</div>
        </div>
        <div class="stepper-item">
            <div class="step-counter">2</div>
            <div class="step-name">Financial Details</div>
        </div>
        <div class="stepper-item">
            <div class="step-counter">3</div>
            <div class="step-name">Contact Person</div>
        </div>
        <div class="stepper-item">
            <div class="step-counter">4</div>
            <div class="step-name">Housing Project</div>
        </div>
    </div>
</nav>

@* Results of the previous action are shown as toasts by _FlashMessages. *@

<form method="post" enctype="multipart/form-data" asp-page-handler="Profile" class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div> @* Show all model-level errors *@

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Company</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="HousingCompany.Name" class="form-label">Company Name</label>
                    <input asp-for="HousingCompany.Name" class="form-control" placeholder="e.g. Skyline Developers" />
                    <span asp-validation-for="HousingCompany.Name" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="HousingCompany.LicenseNumber" class="form-label">License Number</label>
                    <input asp-for="HousingCompany.LicenseNumber" class="form-control" placeholder="123456789" />
                    <span asp-validation-for="HousingCompany.LicenseNumber" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="HousingCompany.EstablishedDate" class="form-label">Established Date</label>
                    @* An unset date would show as 01/01/0001: leave the field empty instead. *@
                    <input asp-for="HousingCompany.EstablishedDate" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")"
                           value="@(Model.HousingCompany?.EstablishedDate is DateTime established && established != default ? established.ToString("yyyy-MM-dd") : "")" />
                    <span asp-validation-for="HousingCompany.EstablishedDate" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="HousingCompany.CompanyCategory" class="form-label">Category</label>
                    <select asp-for="HousingCompany.CompanyCategory" class="form-select"
                            asp-items="@(Enum.GetValues<RadiantHomes.Models.HousingCompanies.HousingCompany.CompanyType>().Select(c => new SelectListItem(c.GetDisplayName(), c.ToString())))"></select>
                    <span asp-validation-for="HousingCompany.CompanyCategory" class="text-danger"></span>
                </div>

                <div class="col-md-4">\n                    <span class="form-label d-block">Approval status</span>\n                    <div class="form-text mt-0">New companies wait for Michu Homes approval before their administrators can manage listings.</div>\n                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Contact</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="HousingCompany.AddressId" class="form-label">Address</label>
                    <select asp-for="HousingCompany.AddressId" class="form-select" asp-items="ViewBag.AddressId">
                        <option value="">-- Select Address --</option>
                    </select>
                    <span asp-validation-for="HousingCompany.AddressId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="HousingCompany.Email" class="form-label">Email</label>
                    <input asp-for="HousingCompany.Email" class="form-control" type="email" placeholder="example@company.com" />
                    <span asp-validation-for="HousingCompany.Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="HousingCompany.PhoneNumber" class="form-label">Phone Number</label>
                    <input asp-for="HousingCompany.PhoneNumber" class="form-control" placeholder="+251912345678" />
                    <span asp-validation-for="HousingCompany.PhoneNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="HousingCompany.Website" class="form-label">Website</label>
                    <input asp-for="HousingCompany.Website" class="form-control" placeholder="https://www.company.com" data-val="false" aria-describedby="websiteHelp" />
                    <div id="websiteHelp" class="form-text">Optional.</div>
                    <span asp-validation-for="HousingCompany.Website" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Branding</h2>
            <label asp-for="Logo" class="form-label">Company Logo</label>
            <input type="file" asp-for="Logo" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" aria-describedby="logoHelp" />
            <span asp-validation-for="Logo" class="text-danger"></span>
            <div id="logoHelp" class="form-text">Optional. Max file size: 10 MB. Allowed formats: .jpg, .jpeg, .png, .gif, .webp.</div>
        </div>

        <div class="mh-form-actions">
            <button type="submit" class="btn btn-primary">
                Next <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</form>

@section Styles {
    <link rel="stylesheet" href="~/css/OnboardingStepper.css" asp-append-version="true" />
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
