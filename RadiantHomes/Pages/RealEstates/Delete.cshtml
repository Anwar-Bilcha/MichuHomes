@page
@model RadiantHomes.Pages.RealEstates.DeleteModel
@{
    ViewData["Title"] = "Delete housing company";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="card mh-confirm">
    <div class="card-header">
        <h2 class="mh-section-title text-reset"><i class="bi bi-exclamation-triangle text-reset" aria-hidden="true"></i> Are you sure you want to delete this company?</h2>
    </div>
    <div class="card-body">
        <p>
            You are about to <strong>permanently delete</strong> the company:
            <strong class="text-danger">@Model.HousingCompany.Name</strong>.
        </p>
        <p class="mb-2">This will also delete:</p>
        <dl class="mh-dl">
            <dt>Project(s)</dt>
            <dd>@Model.Projects.Count</dd>
            <dt>Building(s)</dt>
            <dd>@Model.Buildings.Count</dd>
            <dt>Apartment House(s)</dt>
            <dd>@Model.Apartments.Count</dd>
        </dl>

        <div class="alert alert-danger mt-4 mb-0" role="alert">
            <i class="bi bi-exclamation-octagon me-1" aria-hidden="true"></i>
            <strong>This action is irreversible. Are you absolutely sure?</strong>
        </div>

        <form method="post" class="mh-form-actions">
            <input type="hidden" asp-for="HousingCompany.CompanyId" />
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash" aria-hidden="true"></i> Yes, Delete Everything
            </button>
        </form>
    </div>
</div>
