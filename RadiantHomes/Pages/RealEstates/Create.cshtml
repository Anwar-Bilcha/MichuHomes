@page
@model RadiantHomes.Pages.RealEstates.CreateModel

@{
    ViewData["Title"] = "Create Housing Company";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<div class="container mt-4">

    <nav class="nav nav-pills mb-0 bg-light rounded p-2">
        <a class="nav-link" asp-page="./Index"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
        <a class="nav-link active" asp-page="./Create"><i class="bi bi-plus-circle me-1"></i> Create Company</a>
        <a class="nav-link" asp-page="./Projects/Index"><i class="bi bi-briefcase me-1"></i> Financial</a>
        <a class="nav-link" asp-page="./Buildings/Index"><i class="bi bi-buildings me-1"></i> Projects</a>
        <a class="nav-link" asp-page="./ApartmentHouses/Index"><i class="bi bi-house-door me-1"></i> Apartments</a>
        <a class="nav-link" asp-page="./Testimonials/Index"><i class="bi bi-chat-right-text me-1"></i> Testimonials</a>
    </nav>
    @* @if(TempData.ContainsKey("SuccessMessage"))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData.Peek("SuccessMessage")
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    } *@


    <div class="card shadow-sm rounded-4 p-1">
        <div class="card-header bg-light">
            <h3 class="mb-4 text-dark d-flex align-items-center gap-4">
                <i class="bi bi-building"></i> Create Housing Company
            </h3>
        </div>
        <form method="post" enctype="multipart/form-data">
            <div class="row g-3">
                <!-- Company Name -->
                <div class="col-md-6">
                    <label asp-for="HousingCompany.Name" class="form-label">
                        <i class="bi bi-card-heading"></i> Company Name
                    </label>
                    <input asp-for="HousingCompany.Name" class="form-control" placeholder="e.g. Skyline Developers" />
                    <span asp-validation-for="HousingCompany.Name" class="text-danger"></span>
                </div>

                <!-- License Number -->
                <div class="col-md-6">
                    <label asp-for="HousingCompany.LicenseNumber" class="form-label">
                        <i class="bi bi-file-earmark-text"></i> License Number
                    </label>
                    <input asp-for="HousingCompany.LicenseNumber" class="form-control" placeholder="123456789" />
                    <span asp-validation-for="HousingCompany.LicenseNumber" class="text-danger"></span>
                </div>

                <!-- Established Date -->
                <div class="col-md-6">
                    <label asp-for="HousingCompany.EstablishedDate" class="form-label">
                        <i class="bi bi-calendar"></i> Established Date
                    </label>
                    <input asp-for="HousingCompany.EstablishedDate" class="form-control" type="date" />
                    <span asp-validation-for="HousingCompany.EstablishedDate" class="text-danger"></span>
                </div>

                <!-- Address -->
                <div class="col-md-6">
                    <label asp-for="HousingCompany.AddressId" class="form-label">
                        <i class="bi bi-geo-alt"></i> Address
                    </label>
                    <select asp-for="HousingCompany.AddressId" class="form-select" asp-items="ViewBag.AddressId"></select>
                </div>

                <!-- Contact Info -->
                <div class="col-md-6">
                    <label asp-for="HousingCompany.Email" class="form-label">
                        <i class="bi bi-envelope-at"></i> Email
                    </label>
                    <input asp-for="HousingCompany.Email" class="form-control" type="email" placeholder="example@company.com" />
                    <span asp-validation-for="HousingCompany.Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="HousingCompany.PhoneNumber" class="form-label">
                        <i class="bi bi-telephone"></i> Phone Number
                    </label>
                    <input asp-for="HousingCompany.PhoneNumber" class="form-control" placeholder="+251912345678" />
                    <span asp-validation-for="HousingCompany.PhoneNumber" class="text-danger"></span>
                </div>

                <!-- Website -->
                <div class="col-md-6">
                    <label asp-for="HousingCompany.Website" class="form-label">
                        <i class="bi bi-globe2"></i> Website
                    </label>
                    <input asp-for="HousingCompany.Website" class="form-control" placeholder="https://www.company.com" />
                    <span asp-validation-for="HousingCompany.Website" class="text-danger"></span>
                </div>

                <!-- Logo URL -->
                <!-- Logo URL -->
                <div class="col-md-6">
                    <label asp-for="HousingCompany.LogoUrl" class="form-label">
                        <i class="bi bi-image"></i> Logo URL
                    </label>
                    <input type="file" name="Logo" class="form-control" />
                    <span asp-validation-for="HousingCompany.LogoUrl" class="text-danger"></span>
                </div>


                <!-- Status & Category -->
                <div class="col-md-6">
                    <label asp-for="HousingCompany.Status" class="form-label">
                        <i class="bi bi-toggle-on"></i> Status
                    </label>
                    <input asp-for="HousingCompany.Status" class="form-control" />
                    <span asp-validation-for="HousingCompany.Status" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="HousingCompany.CompanyCategory" class="form-label">
                        <i class="bi bi-tags"></i> Category
                    </label>
                    <input asp-for="HousingCompany.CompanyCategory" class="form-control" />
                    <span asp-validation-for="HousingCompany.CompanyCategory" class="text-danger"></span>
                </div>

                <!-- Audit Fields (Optional or read-only?) -->
                <div class="col-md-6">
                    @* <label asp-for="HousingCompany.CreatedBy" class="form-label">
                        <i class="bi bi-person-circle"></i> Created By
                    </label> *@
                    <input type="hidden" asp-for="HousingCompany.CreatedBy" class="form-control" />
                    <span asp-validation-for="HousingCompany.CreatedBy" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    @* <label asp-for="HousingCompany.CreatedOn" class="form-label">
                        <i class="bi bi-clock-history"></i> Created On
                    </label> *@
                    <input type="hidden" asp-for="HousingCompany.CreatedOn" class="form-control" />
                    <span asp-validation-for="HousingCompany.CreatedOn" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    @* <label asp-for="HousingCompany.UpdatedBy" class="form-label">
                        <i class="bi bi-person-check"></i> Updated By
                    </label> *@
                    <input type="hidden" asp-for="HousingCompany.UpdatedBy" class="form-control" />
                    <span asp-validation-for="HousingCompany.UpdatedBy" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    @* <label asp-for="HousingCompany.UpdatedOn" class="form-label">
                        <i class="bi bi-clock"></i> Updated On
                    </label> *@
                    <input type="hidden" asp-for="HousingCompany.UpdatedOn" class="form-control" />
                    <span asp-validation-for="HousingCompany.UpdatedOn" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-between">
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="bi bi-check-circle"></i> Submit
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
