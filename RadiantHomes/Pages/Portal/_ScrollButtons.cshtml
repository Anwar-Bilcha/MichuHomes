@*
    Previous/next buttons for the .mh-hscroll slider of the same .mh-psection (desktop mouse users; touch screens
    swipe and the buttons stay hidden there). Shown by the layout script only while the slider overflows.
*@
<button type="button" class="mh-hs-btn" data-hscroll="prev" aria-label="Previous" hidden><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
<button type="button" class="mh-hs-btn" data-hscroll="next" aria-label="Next" hidden><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
