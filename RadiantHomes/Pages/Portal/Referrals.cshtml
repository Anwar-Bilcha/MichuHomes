@page
@model RadiantHomes.Pages.Portal.ReferralsModel
@{
    ViewData["Title"] = "Refer a friend";
}

<section class="mh-refer-hero">
    <i class="bi bi-gift" aria-hidden="true"></i>
    <div>
        <h2>Invite friends to Michu Homes</h2>
        <ol>
            <li>Create a code and share its link.</li>
            <li>Your friend signs up with the link.</li>
            <li>You see them here, and we let you know.</li>
        </ol>
    </div>
</section>

@if (!Model.Me.HasProfile)
{
    <partial name="_ProfileNeeded" model="@("Referral codes belong to your customer profile.")" />
    return;
}

<section class="mh-psection" aria-labelledby="codesHeading">
    <div class="mh-psection-head">
        <h2 id="codesHeading">My codes</h2>
        <span class="text-muted small">@($"{Model.ActiveCount} of {ReferralService.MaxActiveCodes} active")</span>
    </div>

    @if (!Model.Codes.Any())
    {
        <p class="text-muted">You don't have a code yet. Create one below.</p>
    }

    <div class="mh-code-grid">
        @foreach (var code in Model.Codes)
        {
            var link = Model.LinkFor(code.Code);
            <article class="mh-code-card @(code.IsActive ? null : "is-off")" aria-label="@($"Code {code.Code}")">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                    <div class="min-w-0">
                        <span class="mh-refcode" translate="no">@code.Code</span>
                        @if (!string.IsNullOrWhiteSpace(code.Label))
                        {
                            <span class="mh-code-label">@code.Label</span>
                        }
                    </div>
                    <span class="mh-pstatus @(code.IsActive ? "mh-pstatus--completed" : "mh-pstatus--cancelled")">@(code.IsActive ? "Active" : "Off")</span>
                </div>
                <p class="mh-code-meta">
                    <i class="bi bi-people" aria-hidden="true"></i> @(code.Referrals.Count == 1 ? "1 friend joined" : $"{code.Referrals.Count} friends joined")
                    · @($"Created {code.CreatedOn:d MMM yyyy}")
                </p>
                @if (code.IsActive)
                {
                    <div class="mh-code-link">
                        <input class="form-control form-control-sm" type="text" value="@link" readonly aria-label="@($"Link of code {code.Code}")" translate="no" />
                    </div>
                    <div class="mh-share" data-share-link="@link">
                        <button type="button" class="btn btn-sm btn-primary" data-share="copy"><i class="bi bi-clipboard" aria-hidden="true"></i> Copy link</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-share="native" hidden><i class="bi bi-share" aria-hidden="true"></i> Share</button>
                        <button type="button" class="btn btn-sm mh-share-wa" data-share="whatsapp"><i class="bi bi-whatsapp" aria-hidden="true"></i> WhatsApp</button>
                        <button type="button" class="btn btn-sm mh-share-tg" data-share="telegram"><i class="bi bi-telegram" aria-hidden="true"></i> Telegram</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-share="sms"><i class="bi bi-chat-dots" aria-hidden="true"></i> SMS</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-share="email"><i class="bi bi-envelope" aria-hidden="true"></i> Email</button>
                    </div>
                }
                <form method="post" asp-page-handler="Toggle" asp-route-id="@code.Id" asp-route-active="@(!code.IsActive)" class="mt-2">
                    <button type="submit" class="btn btn-link btn-sm p-0">@(code.IsActive ? "Turn off this code" : "Turn this code on again")</button>
                </form>
            </article>
        }
    </div>

    @if (Model.ActiveCount < ReferralService.MaxActiveCodes)
    {
        <form method="post" asp-page-handler="Generate" class="mh-code-new">
            <label for="codeLabel" class="form-label">New code</label>
            <div class="mh-portal-search">
                <input id="codeLabel" name="Label" type="text" class="form-control" maxlength="@ReferralService.MaxLabelLength" placeholder="Label (optional), e.g. Family" />
                <button type="submit" class="btn btn-accent text-nowrap"><i class="bi bi-plus-lg" aria-hidden="true"></i> Create code</button>
            </div>
            <div class="form-text">A label helps you see which group of friends joined with which code.</div>
        </form>
    }
</section>

<section class="mh-psection" aria-labelledby="friendsHeading">
    <div class="mh-psection-head">
        <h2 id="friendsHeading">Friends who joined</h2>
        <span class="text-muted small">@Model.Friends.Count</span>
    </div>
    @if (!Model.Friends.Any())
    {
        <p class="text-muted">No friends have joined with your codes yet.</p>
    }
    else
    {
        <ul class="mh-friend-list">
            @foreach (var friend in Model.Friends)
            {
                <li>
                    <span class="mh-friend-avatar" aria-hidden="true">@(friend.Name.Length > 0 ? friend.Name[..1].ToUpperInvariant() : "?")</span>
                    <span class="min-w-0">
                        <strong>@friend.Name</strong>
                        <small>@($"Joined {friend.JoinedOn:d MMM yyyy}") · <span translate="no">@friend.Code</span></small>
                    </span>
                    <span class="mh-pstatus @(friend.Status switch { "Bought a home" => "mh-pstatus--completed", "Reserved a home" => "mh-pstatus--approved", _ => "mh-pstatus--pending" })">@friend.Status</span>
                </li>
            }
        </ul>
    }
</section>

@section Scripts {
    <script>
        // Share a referral link: copy, the phone's share sheet, or a messaging app.
        (function () {
            const t = (text, ...args) => (window.MichuI18n ? MichuI18n.t(text, ...args) : text);
            const canShare = !!navigator.share;
            document.querySelectorAll('[data-share="native"]').forEach((b) => { b.hidden = !canShare; });

            document.addEventListener('click', async function (e) {
                const button = e.target.closest('[data-share]');
                if (!button) return;
                const link = button.closest('[data-share-link]').dataset.shareLink;
                const message = t('Join me on Michu Homes and find your next home: {0}', link);
                switch (button.dataset.share) {
                    case 'copy':
                        try {
                            await navigator.clipboard.writeText(link);
                        } catch (err) {
                            const input = button.closest('.mh-code-card').querySelector('input');
                            input.select();
                            document.execCommand('copy');
                        }
                        if (window.MichuDialog) MichuDialog.toast(t('Link copied.'), 'success');
                        break;
                    case 'native':
                        try { await navigator.share({ title: 'Michu Homes', text: message, url: link }); } catch (err) { /* closed */ }
                        break;
                    case 'whatsapp':
                        window.open('https://wa.me/?text=' + encodeURIComponent(message), '_blank', 'noopener');
                        break;
                    case 'telegram':
                        window.open('https://t.me/share/url?url=' + encodeURIComponent(link) + '&text=' + encodeURIComponent(t('Join me on Michu Homes and find your next home.')), '_blank', 'noopener');
                        break;
                    case 'sms':
                        window.location.href = 'sms:?&body=' + encodeURIComponent(message);
                        break;
                    case 'email':
                        window.location.href = 'mailto:?subject=' + encodeURIComponent(t('An invitation to Michu Homes')) + '&body=' + encodeURIComponent(message);
                        break;
                }
            });
        })();
    </script>
}
