@page
@model RadiantHomes.Pages.Staff.Leads.CreateModel
@{
    ViewData["Title"] = "New lead";
    ViewData["Subtitle"] = "Someone who called, walked in, answered a campaign or was referred.";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<form method="post" class="card card-body">
    @if (Model.Error is { } error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    <partial name="_LeadFields" model="(Model.Input, Model.Options, true)" />
    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i> Create lead</button>
        <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
    </div>
</form>
