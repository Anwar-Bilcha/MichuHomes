@page
@model RadiantHomes.Pages.Staff.Roles.IndexModel
@{
    ViewData["Title"] = "Roles & permissions";
    ViewData["Subtitle"] = "A role is a set of permissions. People get permissions only through the roles they hold.";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

@section PageActions {
    <a mh-permission="roles.manage" class="btn btn-primary" asp-page="./Create" asp-route-company="@Model.Company">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> New role
    </a>
}

@if (Model.Access.IsPlatform)
{
    <form method="get" class="card card-body mb-3">
        <label class="form-label" for="company">Roles of</label>
        <select class="form-select" id="company" name="company" asp-items="@(new SelectList(Model.CompanyOptions, "Value", "Text", Model.Company?.ToString() ?? ""))" onchange="this.form.submit()"></select>
        <noscript><button class="btn btn-outline-primary btn-sm mt-2" type="submit">Show</button></noscript>
    </form>
}

<p class="text-muted small"><i class="bi bi-diagram-3" aria-hidden="true"></i> @Model.ScopeLabel</p>

<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Role</th>
                    <th scope="col" class="text-center">Permissions</th>
                    <th scope="col" class="text-center">People</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="5" class="text-muted">No roles yet.</td></tr>
                }
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@r.Name @if (r.IsSystem) { <span class="badge text-bg-light border ms-1">Built-in</span> }</div>
                            @if (!string.IsNullOrWhiteSpace(r.Description)) { <div class="small text-muted">@r.Description</div> }
                        </td>
                        <td class="text-center">@r.Permissions</td>
                        <td class="text-center">@r.Holders</td>
                        <td><span class="badge @(r.IsActive ? "text-bg-success" : "text-bg-secondary")">@(r.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-id="@r.Id" aria-label="Open @r.Name"><i class="bi bi-pencil" aria-hidden="true"></i> Open</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
