@page
@model RadiantHomes.Pages.Staff.Audit.IndexModel
@{
    ViewData["Title"] = "Audit log";
    ViewData["Subtitle"] = Model.Access.IsPlatform
        ? "Who changed users, roles, permissions and company status, and when — across the platform."
        : "Who changed your company's users, roles and status, and when.";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<form method="get" class="card card-body mb-3" role="search">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-3">
            <label class="form-label" for="category">Area</label>
            <select class="form-select" id="category" name="category">
                <option value="">All</option>
                @foreach (var c in RadiantHomes.Pages.Staff.Audit.IndexModel.Categories)
                {
                    <option value="@c" selected="@(Model.Category == c)">@c</option>
                }
            </select>
        </div>
        <div class="col-12 col-md">
            <label class="form-label" for="q">Text</label>
            <input class="form-control" id="q" name="q" value="@Model.Q" placeholder="Name, email, role, company…" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="from">From</label>
            <input class="form-control" type="date" id="from" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="to">To</label>
            <input class="form-control" type="date" id="to" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12 col-md-auto">
            <button class="btn btn-outline-primary w-100" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i> Filter</button>
        </div>
    </div>
</form>

@if (!Model.Entries.Any())
{
    <div class="card">
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-journal-text"></i></span>
            <h2>Nothing recorded</h2>
            <p>Changes to users, roles, permissions and company status appear here.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0 small">
                <thead>
                    <tr>
                        <th scope="col">When</th>
                        <th scope="col">Who</th>
                        <th scope="col">What</th>
                        @if (Model.Access.IsPlatform) { <th scope="col">Company</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Entries)
                    {
                        <tr>
                            <td class="text-nowrap">@e.OccurredOn.ToLocalTime().ToString("d MMM yyyy HH:mm")</td>
                            <td>@(e.ActorName ?? "System")</td>
                            <td>
                                <span class="badge text-bg-light border me-1">@e.Category</span>@e.Summary
                                @if (!string.IsNullOrWhiteSpace(e.Details))
                                {
                                    <details class="mt-1"><summary class="text-muted">Details</summary><code class="d-block text-wrap" style="word-break:break-word">@e.Details</code></details>
                                }
                            </td>
                            @if (Model.Access.IsPlatform)
                            {
                                <td>@(e.CompanyId is Guid c && Model.Companies.TryGetValue(c, out var n) ? n : "—")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Pages > 1)
    {
        <nav class="mt-3" aria-label="Audit log pages">
            <ul class="pagination justify-content-center">
                @for (var i = 1; i <= Model.Pages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : null)">
                        <a class="page-link" asp-page="./Index" asp-route-p="@i" asp-route-category="@Model.Category" asp-route-q="@Model.Q"
                           asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" aria-current="@(i == Model.PageNumber ? "page" : null)">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
