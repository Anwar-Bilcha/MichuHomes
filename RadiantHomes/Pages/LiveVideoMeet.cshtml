@page
@model RadiantHomes.Pages.LiveVideoMeetModel
@{
    ViewData["Title"] = "Live class";
    var userName = User.Identity?.Name ?? "Guest";
    var roomName = $"RadiantClass_{Model.RoomId}"; // You can set RoomId from the model
    ViewData["Subtitle"] = $"Room: {roomName}";
}

<div class="card overflow-hidden">
    <div id="jitsi-container" style="height: 800px; width: 100%;"></div>
</div>

@section Scripts {
    <script src='https://meet.jit.si/external_api.js'></script>
    <script>
        const domain = "meet.jit.si";
        const options = {
            roomName: "@roomName",
            width: "100%",
            height: 800,
            parentNode: document.querySelector("#jitsi-container"),
            userInfo: {
                displayName: "@userName"
            }
        };
        const api = new JitsiMeetExternalAPI(domain, options);
    </script>
}
