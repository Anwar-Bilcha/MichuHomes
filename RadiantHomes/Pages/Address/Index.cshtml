                @Html.DisplayNameFor(model => model.PartyAddress[0].City)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PartyAddress[0].Woreda)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PartyAddress[0].SubCity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PartyAddress[0].Region)
            </th>
