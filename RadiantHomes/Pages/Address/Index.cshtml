@page
@model RadiantHomes.Pages.Address.IndexModel

@{
    ViewData["Title"] = "Addresses";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var hasRows = Model.PartyAddress is not null && Model.PartyAddress.Any();
}

@section PageActions {
    <a class="btn btn-primary" asp-page="Create">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> New address
    </a>
}

<div class="card">
    @if (!hasRows)
    {
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-geo-alt"></i></span>
            <h2>No addresses yet</h2>
            <p>Addresses appear here once they are added.</p>
            <a class="btn btn-primary" asp-page="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> New address</a>
        </div>
    }
    else
    {
        <div class="table-responsive position-relative">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(model => model.PartyAddress[0].City)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PartyAddress[0].Woreda)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PartyAddress[0].SubCity)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PartyAddress[0].Region)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PartyAddress[0].PostalCode)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PartyAddress[0].Country)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PartyAddress[0].LocationMain)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PartyAddress[0].LocationSub)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PartyAddress[0].Street)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PartyAddress[0].CreatedBy)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PartyAddress[0].CreatedOn)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PartyAddress[0].UpdatedBy)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PartyAddress[0].UpdatedOn)</th>
                        <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PartyAddress!)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.City)</td>
                            <td>@Html.DisplayFor(modelItem => item.Woreda)</td>
                            <td>@Html.DisplayFor(modelItem => item.SubCity)</td>
                            <td>@Html.DisplayFor(modelItem => item.Region)</td>
                            <td>@Html.DisplayFor(modelItem => item.PostalCode)</td>
                            <td>@Html.DisplayFor(modelItem => item.Country)</td>
                            <td>@Html.DisplayFor(modelItem => item.LocationMain)</td>
                            <td>@Html.DisplayFor(modelItem => item.LocationSub)</td>
                            <td>@Html.DisplayFor(modelItem => item.Street)</td>
                            <td>@Html.DisplayFor(modelItem => item.CreatedBy)</td>
                            <td>@Html.DisplayFor(modelItem => item.CreatedOn)</td>
                            <td>@Html.DisplayFor(modelItem => item.UpdatedBy)</td>
                            <td>@Html.DisplayFor(modelItem => item.UpdatedOn)</td>
                            <td class="text-end">
                                <div class="mh-row-actions">
                                    <a class="btn btn-sm btn-outline-secondary btn-icon" asp-page="./Details" asp-route-id="@item.AddressID" title="View details" aria-label="View details"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                    <a class="btn btn-sm btn-outline-primary btn-icon" asp-page="./Edit" asp-route-id="@item.AddressID" title="Edit" aria-label="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                    <a class="btn btn-sm btn-outline-danger btn-icon" asp-page="./Delete" asp-route-id="@item.AddressID" title="Delete" aria-label="Delete"><i class="bi bi-trash" aria-hidden="true"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
