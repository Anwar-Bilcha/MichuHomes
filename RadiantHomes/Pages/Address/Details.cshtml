@page
@model RadiantHomes.Pages.Address.DetailsModel

@{
    ViewData["Title"] = "Address details";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section PageActions {
    <a class="btn btn-secondary" asp-page="./Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list</a>
    <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.PartyAddress.AddressID"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</a>
}

<div class="card">
    <div class="card-body">
        <dl class="mh-dl">
            <dt>@Html.DisplayNameFor(model => model.PartyAddress.City)</dt>
            <dd>@Html.DisplayFor(model => model.PartyAddress.City)</dd>
            <dt>@Html.DisplayNameFor(model => model.PartyAddress.Woreda)</dt>
            <dd>@Html.DisplayFor(model => model.PartyAddress.Woreda)</dd>
            <dt>@Html.DisplayNameFor(model => model.PartyAddress.SubCity)</dt>
            <dd>@Html.DisplayFor(model => model.PartyAddress.SubCity)</dd>
            <dt>@Html.DisplayNameFor(model => model.PartyAddress.Region)</dt>
            <dd>@Html.DisplayFor(model => model.PartyAddress.Region)</dd>
            <dt>@Html.DisplayNameFor(model => model.PartyAddress.PostalCode)</dt>
            <dd>@Html.DisplayFor(model => model.PartyAddress.PostalCode)</dd>
            <dt>@Html.DisplayNameFor(model => model.PartyAddress.Country)</dt>
            <dd>@Html.DisplayFor(model => model.PartyAddress.Country)</dd>
            <dt>@Html.DisplayNameFor(model => model.PartyAddress.LocationMain)</dt>
            <dd>@Html.DisplayFor(model => model.PartyAddress.LocationMain)</dd>
            <dt>@Html.DisplayNameFor(model => model.PartyAddress.LocationSub)</dt>
            <dd>@Html.DisplayFor(model => model.PartyAddress.LocationSub)</dd>
            <dt>@Html.DisplayNameFor(model => model.PartyAddress.Street)</dt>
            <dd>@Html.DisplayFor(model => model.PartyAddress.Street)</dd>
            <dt>@Html.DisplayNameFor(model => model.PartyAddress.CreatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.PartyAddress.CreatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.PartyAddress.CreatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.PartyAddress.CreatedOn)</dd>
            <dt>@Html.DisplayNameFor(model => model.PartyAddress.UpdatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.PartyAddress.UpdatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.PartyAddress.UpdatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.PartyAddress.UpdatedOn)</dd>
        </dl>
    </div>
</div>
