@page
@model RadiantHomes.Pages.Houses.DetailsModel

@{
    ViewData["Title"] = "House details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var isForRent = HouseAvailability.IsForRent(Model.House.AvailableFor);
    var isForSale = HouseAvailability.IsForSale(Model.House.AvailableFor);
    var rentInfo = isForRent ? Model.House.HouseRentInfo : null;
}

@section Styles {
    <style>
        .house-hero-img {
            width: 100%;
            max-height: 420px;
            object-fit: cover;
            background: var(--mh-surface-3);
        }

        .house-hero-placeholder {
            min-height: 220px;
            background: var(--mh-surface-3);
            color: var(--mh-ink-3);
        }

        .mySwiper {
            width: 100%;
            --swiper-theme-color: var(--mh-orange);
        }

        .house-slide-img {
            width: 100%;
            height: clamp(240px, 45vw, 500px);
            object-fit: cover;
        }

        @@media (min-width: 992px) {
            .house-actions-card {
                position: sticky;
                top: calc(var(--mh-nav-h) + 1rem);
            }
        }
    </style>
}

@section PageActions {
    <a class="btn btn-secondary" asp-page="./Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to List</a>
    @if (Model.CanManage)
    {
        <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.House.Id"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</a>
    }
}


<div class="row g-4">
    <div class="col-lg-8">
        <!-- House Info -->
        <div class="card overflow-hidden mb-4">
            @if (!string.IsNullOrEmpty(Model.House.MainPhotoUrl))
            {
                <img src="@Model.House.MainPhotoUrl" class="house-hero-img" alt="@Model.House.Title">
            }
            else
            {
                <div class="house-hero-placeholder d-flex flex-column align-items-center justify-content-center gap-2">
                    <i class="bi bi-image fs-1" aria-hidden="true"></i>
                    <span>No Main Photo Available</span>
                </div>
            }
            <div class="card-body">
                <h2 class="h3 mb-2">@Model.House.Title</h2>
                <p class="text-muted mb-2">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i> @(Model.House.HouseAddress?.FormattedAddressCompact ?? "Address not available")
                </p>
                <p class="h4 text-accent fw-bold mb-3">
                    ETB @HouseAvailability.ListingPrice(Model.House).ToString("N0")
                    @if (rentInfo is not null)
                    {
                        <span class="fs-6 fw-normal text-muted">/ @HouseAvailability.RentTermLabel(rentInfo.RentTerm).ToLowerInvariant()</span>
                    }
                </p>
                @if (rentInfo is { ExcepectedAdvancePayment: > 0 })
                {
                    <p class="small text-muted mb-3">Expected advance payment: ETB @rentInfo.ExcepectedAdvancePayment.ToString("N0")</p>
                }
                <p class="mb-0">@Model.House.Description</p>
            </div>
        </div>

        <!-- Property information -->
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="mh-section-title"><i class="bi bi-info-circle" aria-hidden="true"></i> Property Information</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-md-4">
                        <div class="d-flex align-items-center gap-3">
                            <span class="mh-stat-icon" aria-hidden="true"><i class="fa-solid fa-bed"></i></span>
                            <div>
                                <p class="mh-stat-label">Bedrooms</p>
                                <p class="fw-semibold mb-0">@Model.House.TotalBedRooms</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="d-flex align-items-center gap-3">
                            <span class="mh-stat-icon" aria-hidden="true"><i class="fa-solid fa-shower"></i></span>
                            <div>
                                <p class="mh-stat-label">Total Rooms</p>
                                <p class="fw-semibold mb-0">@Model.House.TotalRooms</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="d-flex align-items-center gap-3">
                            <span class="mh-stat-icon" aria-hidden="true"><i class="fa-solid fa-warehouse"></i></span>
                            <div>
                                <p class="mh-stat-label">Area</p>
                                <p class="fw-semibold mb-0">@Model.House.TotalArea sqm</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="d-flex align-items-center gap-3">
                            <span class="mh-stat-icon mh-stat-icon--accent" aria-hidden="true"><i class="bi bi-key"></i></span>
                            <div>
                                <p class="mh-stat-label">Ownership</p>
                                <p class="fw-semibold mb-0">@Model.House.HouseOwnership</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="d-flex align-items-center gap-3">
                            <span class="mh-stat-icon mh-stat-icon--accent" aria-hidden="true"><i class="bi bi-tag"></i></span>
                            <div>
                                <p class="mh-stat-label">Category</p>
                                <p class="fw-semibold mb-0">@Model.House.HouseCategory?.Name</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="d-flex align-items-center gap-3">
                            <span class="mh-stat-icon mh-stat-icon--accent" aria-hidden="true"><i class="bi bi-signpost"></i></span>
                            <div>
                                <p class="mh-stat-label">Available For</p>
                                <p class="fw-semibold mb-0">@HouseAvailability.Label(Model.House.AvailableFor)</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-8">
                        <div class="d-flex align-items-center gap-3">
                            <span class="mh-stat-icon" aria-hidden="true"><i class="fa-solid fa-file-circle-check"></i></span>
                            <div>
                                <p class="mh-stat-label">Ownership Document</p>
                                <p class="mb-0">
                                    @if (Model.House.HasOwnershipDocument)
                                    {
                                        <span class="mh-chip mh-chip--success">Yes</span>
                                        @if (!string.IsNullOrEmpty(Model.House.OwnershipDocumentUrl))
                                        {
                                            <a href="@Model.House.OwnershipDocumentUrl" target="_blank" rel="noopener" class="ms-2">View</a>
                                        }
                                    }
                                    else
                                    {
                                        <span class="mh-chip mh-chip--danger">No</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Full-width Auto-sliding Swiper -->
        <div class="card overflow-hidden mb-4">
            <div class="card-header">
                <h2 class="mh-section-title"><i class="bi bi-images" aria-hidden="true"></i> Photos</h2>
            </div>
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                    @if (!string.IsNullOrEmpty(Model.House.MainPhotoUrl))
                    {
                        <div class="swiper-slide">
                            <img src="@Model.House.MainPhotoUrl" class="house-slide-img" alt="@Model.House.Title" />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.House.OutOfCompoundViewPhotoUrl))
                    {
                        <div class="swiper-slide">
                            <img src="@Model.House.OutOfCompoundViewPhotoUrl" class="house-slide-img" alt="Out of compound view" />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.House.KitchenViewPhotoUrl))
                    {
                        <div class="swiper-slide">
                            <img src="@Model.House.KitchenViewPhotoUrl" class="house-slide-img" alt="Kitchen view" />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.House.FrontCompoundViewPhotoUrl))
                    {
                        <div class="swiper-slide">
                            <img src="@Model.House.FrontCompoundViewPhotoUrl" class="house-slide-img" alt="Front compound view" />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.House.HouseInternalViewPhotoUrl))
                    {
                        <div class="swiper-slide">
                            <img src="@Model.House.HouseInternalViewPhotoUrl" class="house-slide-img" alt="House internal view" />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.House.MainSalonViewPhotoUrl))
                    {
                        <div class="swiper-slide">
                            <img src="@Model.House.MainSalonViewPhotoUrl" class="house-slide-img" alt="Main salon view" />
                        </div>
                    }
                </div>

                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-pagination"></div>
            </div>
        </div>

        <!-- 3D views -->
        <div class="card overflow-hidden">
            <div class="card-header">
                <h2 class="mh-section-title"><i class="bi bi-badge-3d" aria-hidden="true"></i> 3D View</h2>
            </div>
            <div class="sketchfab-embed-wrapper ratio ratio-16x9">
                <iframe title="Room" frameborder="0" allowfullscreen mozallowfullscreen="true" webkitallowfullscreen="true" allow="autoplay; fullscreen; xr-spatial-tracking" xr-spatial-tracking execution-while-out-of-viewport execution-while-not-rendered web-share src="https://sketchfab.com/models/6417cbc1870a4a1691cca06912ae0369/embed"> </iframe>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="col-lg-4">
        <div class="card house-actions-card">
            <div class="card-header">
                <h2 class="mh-section-title"><i class="bi bi-hand-index" aria-hidden="true"></i> Interested in this house?</h2>
            </div>
            <div class="card-body d-grid gap-2">
                @if (Model.IsOwnHouse)
                {
                    @* Owners can't rent, buy, request the contact of or report their own house. *@
                    <p class="text-muted mb-0">This is your house. Other users can rent or buy it, contact you and report issues from here.</p>
                }
                else
                {
                    @if (isForRent)
                    {
                        <a asp-page="/Houses/Actions/Rent/Create" asp-route-id="@Model.House.Id" class="btn btn-accent">
                            <i class="bi bi-house-door" aria-hidden="true"></i> Rent House
                        </a>
                    }
                    @if (isForSale)
                    {
                        <a asp-page="/Houses/Actions/Sales/Create" asp-route-id="@Model.House.Id" class="btn btn-accent">
                            <i class="bi bi-cash-stack" aria-hidden="true"></i> Buy House
                        </a>
                    }
                    <a asp-page="/Houses/Actions/GetOwnersContact" asp-route-id="@Model.House.Id" class="btn btn-primary">
                        <i class="bi bi-person-lines-fill" aria-hidden="true"></i> Contact Owner
                    </a>
                    <a asp-page="/Houses/Actions/Complaints/Create" asp-route-id="@Model.House.Id" class="btn btn-outline-danger">
                        <i class="bi bi-exclamation-octagon" aria-hidden="true"></i> Report
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Shared photo-slider behaviour (wwwroot/js/site.js): 5 s auto-advance, pause on hover, keyboard/swipe.
        initPhotoSlider('.mySwiper');
    </script>
}
