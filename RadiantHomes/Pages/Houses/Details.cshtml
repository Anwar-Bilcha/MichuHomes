@page
@model RadiantHomes.Pages.Houses.DetailsModel

@{
    ViewData["Title"] = "House Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<!-- Include Swiper for slider -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<div class="w-100 py-4">
    <div class="card shadow rounded-4 mx-auto" style="max-width: 1400px;">
        <div class="card-header bg-secondary text-white py-3">
            <h4 class="mb-0">🏡 House Details</h4>
        </div>
        <div class="card-body p-4">

            <!-- House Info -->
            <div class="text-center mb-4">
                @if (!string.IsNullOrEmpty(Model.House.MainPhotoUrl))
                {
                    <img src="@Model.House.MainPhotoUrl" class="img-fluid rounded-4 shadow" alt="@Model.House.Title" style="max-height: 300px; object-fit: cover;">
                }
                else
                {
                    <div class="bg-secondary text-white rounded-3 py-5">No Main Photo Available</div>
                }
                <h3 class="mt-3">@Model.House.Title</h3>
                <p class="text-muted">
                    <i class="bi bi-geo-alt-fill"></i> @Model.House.HouseAddress?.AddressID
                </p>
                <h4 class="text-success fw-bold mb-3">ETB @Model.House.Price.ToString("N0")</h4>
                <p>@Model.House.Description</p>
            </div>

            <hr class="my-4">

            <!-- Icons in one row -->
            <h5 class="mb-3">Property Information</h5>
            <div class="d-flex flex-wrap justify-content-between text-center gap-4">

                <div class="flex-fill">
                    <i class="fa-solid fa-bed text-warning" style="font-size: 2.5rem;"></i>
                    <div>Bedrooms: <br><strong>@Model.House.TotalBedRooms</strong></div>
                </div>
                <div class="flex-fill">
                    <i class="fa-solid fa-shower text-success" style="font-size: 2.5rem;"></i>
                    <div>Total Rooms: <br><strong>@Model.House.TotalRooms</strong></div>
                </div>
                <div class="flex-fill">
                    <i class="fa-solid fa-warehouse text-warning" style="font-size: 2.5rem;"></i>
                    <div>Area: <br><strong>@Model.House.TotalArea</strong> sqm</div>
                </div>
                <div class="flex-fill">
                    <i class="bi bi-key-fill text-success" style="font-size: 2rem;"></i>
                    <div>Ownership: <br><strong>@Model.House.HouseOwnership</strong></div>
                </div>
                <div class="flex-fill">
                    <i class="bi bi-tag-fill text-danger" style="font-size: 2rem;"></i>
                    <div>Category: <br><strong>@Model.House.HouseCategory?.Id</strong></div>
                </div>
                <div class="flex-fill">
                    <i class="bi bi-signpost-fill text-secondary" style="font-size: 2rem;"></i>
                    <div>Available For: <br><strong>@Model.House.AvailableFor</strong></div>
                </div>
                <div class="flex-fill">
                    <i class="fa-solid fa-file-circle-check" style="font-size: 2.5rem"></i>
                    <div>
                        Ownership Document:
                        @if (Model.House.HasOwnershipDocument)
                        {
                            <span class="fw-bold text-success">Yes</span>
                            @if (!string.IsNullOrEmpty(Model.House.OwnershipDocumentUrl))
                            {
                                <a href="@Model.House.OwnershipDocumentUrl" target="_blank" class="ms-2 text-decoration-underline">View</a>
                            }
                        }
                        else
                        {
                            <span class="fw-bold text-danger">No</span>
                        }
                    </div>
                </div>
            </div>

            <hr class="my-4">

            <!-- Full-width Auto-sliding Swiper -->
            <h5 class="mb-3">Photos</h5>
            <div class="swiper mySwiper rounded-4 shadow" style="width: 100%; max-height: 500px;">
                <div class="swiper-wrapper">
                    @if (!string.IsNullOrEmpty(Model.House.MainPhotoUrl))
                    {
                        <div class="swiper-slide">
                            <img src="@Model.House.MainPhotoUrl" class="img-fluid w-100" style="height: 500px; object-fit: cover;" />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.House.OutOfCompoundViewPhotoUrl))
                    {
                        <div class="swiper-slide">
                            <img src="@Model.House.OutOfCompoundViewPhotoUrl" class="img-fluid w-100" style="height: 500px; object-fit: cover;" />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.House.KitchenViewPhotoUrl))
                    {
                        <div class="swiper-slide">
                            <img src="@Model.House.KitchenViewPhotoUrl" class="img-fluid w-100" style="height: 500px; object-fit: cover;" />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.House.FrontCompoundViewPhotoUrl))
                    {
                        <div class="swiper-slide">
                            <img src="@Model.House.FrontCompoundViewPhotoUrl" class="img-fluid w-100" style="height: 500px; object-fit: cover;" />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.House.HouseInternalViewPhotoUrl))
                    {
                        <div class="swiper-slide">
                            <img src="@Model.House.HouseInternalViewPhotoUrl" class="img-fluid w-100" style="height: 500px; object-fit: cover;" />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.House.MainSalonViewPhotoUrl))
                    {
                        <div class="swiper-slide">
                            <img src="@Model.House.MainSalonViewPhotoUrl" class="img-fluid w-100" style="height: 500px; object-fit: cover;" />
                        </div>
                    }
                </div>

                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-pagination"></div>
            </div>

            <script>
                var swiper = new Swiper(".mySwiper", {
                    loop: true,
                    autoplay: {
                        delay: 300000,
                        disableOnInteraction: false,
                    },
                    pagination: {
                        el: ".swiper-pagination",
                        clickable: true,
                    },
                    navigation: {
                        nextEl: ".swiper-button-next",
                        prevEl: ".swiper-button-prev",
                    },
                });
            </script>

            <hr class="my-4">
            <model-viewer src="~/models/sample-house.glb"
                          alt="3D house model"
                          auto-rotate
                          camera-controls
                          style="width: 100%; height: 500px;">
            </model-viewer>
            <div class="sketchfab-embed-wrapper">
                <iframe title="Room" frameborder="0" allowfullscreen mozallowfullscreen="true" webkitallowfullscreen="true" allow="autoplay; fullscreen; xr-spatial-tracking" xr-spatial-tracking execution-while-out-of-viewport execution-while-not-rendered web-share src="https://sketchfab.com/models/6417cbc1870a4a1691cca06912ae0369/embed"> </iframe> 
                </div>
            <!-- Actions -->
            <div class="d-flex flex-wrap gap-3 mt-5 justify-content-center">
                <a asp-page="./Edit" asp-route-id="@Model.House.Id" class="btn btn-outline-primary rounded-pill px-4 py-2 shadow-sm">
                    <i class="bi bi-pencil-square me-2"></i> Edit
                </a>
                <a asp-page="./Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 shadow-sm">
                    <i class="bi bi-arrow-left me-2"></i> Back to List
                </a>
                <a asp-page="/Houses/Actions/GetOwnersContact" asp-route-id="@Model.House.Id" class="btn btn-info text-white rounded-pill px-4 py-2 shadow-sm">
                    <i class="bi bi-person-lines-fill me-2"></i> Contact Owner
                </a>
                <a asp-page="./RequestMoreInfo" asp-route-id="@Model.House.Id" class="btn btn-warning text-dark rounded-pill px-4 py-2 shadow-sm">
                    <i class="bi bi-info-circle-fill me-2"></i> Request Info
                </a>
                @if (!string.IsNullOrEmpty(Model.House.AvailableFor) && Model.House.AvailableFor?.ToLower() == "rent")
                {
                    <a asp-page="/Houses/Actions/Rent/Create" asp-route-id="@Model.House.Id" class="btn btn-success rounded-pill px-4 py-2 shadow-sm">
                        <i class="bi bi-house-door-fill me-2"></i> Rent House
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.House.AvailableFor) && Model.House.AvailableFor?.ToLower() == "sell")
                {
                    <a asp-page="/Houses/Actions/Sales/Create" asp-route-id="@Model.House.Id" class="btn btn-success rounded-pill px-4 py-2 shadow-sm">
                        <i class="bi bi-cash-stack me-2"></i> Buy House
                    </a>
                }
                <a asp-page="./ScheduleViewing" asp-route-id="@Model.House.Id" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
                    <i class="bi bi-calendar2-event-fill me-2"></i> Schedule Viewing
                </a>
                <a asp-page="./ShareProperty" asp-route-id="@Model.House.Id" class="btn btn-outline-dark rounded-pill px-4 py-2 shadow-sm">
                    <i class="bi bi-share-fill me-2"></i> Share
                </a>
                <a asp-page="/Houses/Actions/Complaints/Create" asp-route-id="@Model.House.Id" class="btn btn-outline-danger rounded-pill px-4 py-2 shadow-sm">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i> Report
                </a>
            </div>
        </div>
    </div>
</div>
