@page
@model RadiantHomes.Pages.Houses.EditModel

@{
    ViewData["Title"] = "Edit house";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .house-thumb {
            display: block;
            max-width: 100px;
            max-height: 100px;
            object-fit: cover;
            margin-bottom: .5rem;
        }

        .house-thumb--lg {
            max-width: 150px;
            max-height: 150px;
        }
    </style>
}

<form method="post" enctype="multipart/form-data" class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="House.Id" />

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Basic information</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="House.Title" class="form-label">Title</label>
                    <input asp-for="House.Title" class="form-control" />
                    <span asp-validation-for="House.Title" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="House.Price" class="form-label">Price</label>
                    <input asp-for="House.Price" class="form-control" />
                    <span asp-validation-for="House.Price" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    @if (Model.CanChooseOwner)
                    {
                        <label asp-for="House.HouseOwnerId" class="form-label">Owner</label>
                        <select asp-for="House.HouseOwnerId" class="form-select" asp-items="ViewBag.HouseOwnerId">
                            <option value="">-- Select Owner --</option>
                        </select>
                    }
                    else
                    {
                        @* Only admins can move a house to another owner; the server keeps the current one. *@
                        <label for="house-owner-current" class="form-label">Owner</label>
                        <input id="house-owner-current" class="form-control" value="@Model.OwnerName" readonly />
                    }
                    <span asp-validation-for="House.HouseOwnerId" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="House.Description" class="form-label">Description</label>
                    <textarea asp-for="House.Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="House.Description" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Property details</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="House.TotalBedRooms" class="form-label">Bedrooms</label>
                    <input asp-for="House.TotalBedRooms" class="form-control" />
                    <span asp-validation-for="House.TotalBedRooms" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="House.TotalRooms" class="form-label">Total Rooms</label>
                    <input asp-for="House.TotalRooms" class="form-control" />
                    <span asp-validation-for="House.TotalRooms" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="House.TotalArea" class="form-label">Total Area</label>
                    <input asp-for="House.TotalArea" class="form-control" placeholder="Area (e.g., sq m)" />
                    <span asp-validation-for="House.TotalArea" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input class="form-check-input" asp-for="House.HasOwnershipDocument" />
                        <label class="form-check-label" asp-for="House.HasOwnershipDocument">@Html.DisplayNameFor(model => model.House.HasOwnershipDocument)</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Location &amp; ownership</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="House.AddressId" class="form-label">Address</label>
                    <select asp-for="House.AddressId" class="form-select" asp-items="ViewBag.AddressId">
                        <option value="">-- Select Address --</option>
                    </select>
                    <span asp-validation-for="House.AddressId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="House.HouseCategoryId" class="form-label">Category</label>
                    <select asp-for="House.HouseCategoryId" class="form-select" asp-items="ViewBag.HouseCategoryId">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="House.HouseCategoryId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="House.AvailableFor" class="form-label">Available For</label>
                    <select asp-for="House.AvailableFor" class="form-select">
                        <option value="">-- Select Availability --</option>
                        <option value="@HouseAvailability.Rent">Rent</option>
                        <option value="@HouseAvailability.Sale">Sale</option>
                    </select>
                    <span asp-validation-for="House.AvailableFor" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="House.HouseOwnership" class="form-label">Ownership Type</label>
                    <select asp-for="House.HouseOwnership" class="form-select">
                        <option value="">-- Select Ownership Type --</option>
                        <option value="Individual">Individual</option>
                        <option value="Couples">Couples</option>
                        <option value="Family">Family</option>
                    </select>
                    <span asp-validation-for="House.HouseOwnership" class="text-danger small"></span>
                </div>
            </div>
        </div>

        @* Same rent-terms fields as Houses/Create; shown while "Available For" is Rent. *@
        <div class="mh-fieldset" id="rent-info-section" hidden="@(!HouseAvailability.IsForRent(Model.House.AvailableFor))">
            <h2 class="mh-fieldset-title">Rent terms</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="House.HouseRentInfo.RentTerm" class="form-label">Rent Term</label>
                    <select asp-for="House.HouseRentInfo.RentTerm" class="form-select">
                        <option value="">-- Select Rent Term --</option>
                        @foreach (var term in Enum.GetValues<RentInfo.RentTerms>())
                        {
                            <option value="@term">@HouseAvailability.RentTermLabel(term)</option>
                        }
                    </select>
                    <span asp-validation-for="House.HouseRentInfo.RentTerm" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="House.HouseRentInfo.PricePerTerm" class="form-label">Price Per Term</label>
                    <input asp-for="House.HouseRentInfo.PricePerTerm" class="form-control" />
                    <span asp-validation-for="House.HouseRentInfo.PricePerTerm" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="House.HouseRentInfo.ExcepectedAdvancePayment" class="form-label">Advance Payment</label>
                    <input asp-for="House.HouseRentInfo.ExcepectedAdvancePayment" class="form-control" />
                    <span asp-validation-for="House.HouseRentInfo.ExcepectedAdvancePayment" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Documents &amp; main photo</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="OwnershipDocument" class="form-label">Ownership Document</label>
                    @if (!string.IsNullOrEmpty(Model.House.OwnershipDocumentUrl))
                    {
                        <a href="@Model.House.OwnershipDocumentUrl" target="_blank" rel="noopener" class="d-inline-block small mb-2"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> View Current Document</a>
                    }
                    <input asp-for="OwnershipDocument" type="file" class="form-control" accept="image/*,.pdf" />
                    <span asp-validation-for="OwnershipDocument" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConsentDocument" class="form-label">Consent Document</label>
                    @if (!string.IsNullOrEmpty(Model.House.ConsentofSaleOrRentDocUrl))
                    {
                        <a href="@Model.House.ConsentofSaleOrRentDocUrl" target="_blank" rel="noopener" class="d-inline-block small mb-2"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> View Current Document</a>
                    }
                    <input asp-for="ConsentDocument" type="file" class="form-control" accept="image/*,.pdf" />
                    <span asp-validation-for="ConsentDocument" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TaxVoucher" class="form-label">Tax Voucher</label>
                    @if (!string.IsNullOrEmpty(Model.House.LatestHouseTaxVoucherUrl))
                    {
                        <a href="@Model.House.LatestHouseTaxVoucherUrl" target="_blank" rel="noopener" class="d-inline-block small mb-2"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> View Current Document</a>
                    }
                    <input asp-for="TaxVoucher" type="file" class="form-control" accept="image/*,.pdf" />
                    <span asp-validation-for="TaxVoucher" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MainPhotoUrl" class="form-label">Main Photo</label>
                    @if (!string.IsNullOrEmpty(Model.House.MainPhotoUrl))
                    {
                        <img src="@Model.House.MainPhotoUrl" alt="Current Main Photo" class="img-thumbnail house-thumb house-thumb--lg" />
                    }
                    <input type="file" asp-for="MainPhotoUrl" class="form-control" accept="image/*" />
                    <span asp-validation-for="MainPhotoUrl" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">House photos</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="FrontCompoundViewPhotoUrl" class="form-label">Front Compound View</label>
                    @if (!string.IsNullOrEmpty(Model.House.FrontCompoundViewPhotoUrl))
                    {
                        <img src="@Model.House.FrontCompoundViewPhotoUrl" alt="Current Front Compound View" class="img-thumbnail house-thumb" />
                    }
                    <input type="file" asp-for="FrontCompoundViewPhotoUrl" class="form-control" accept="image/*" />
                    <span asp-validation-for="FrontCompoundViewPhotoUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="OutOfCompoundViewPhotoUrl" class="form-label">Out of Compound View</label>
                    @if (!string.IsNullOrEmpty(Model.House.OutOfCompoundViewPhotoUrl))
                    {
                        <img src="@Model.House.OutOfCompoundViewPhotoUrl" alt="Current Out of Compound View" class="img-thumbnail house-thumb" />
                    }
                    <input type="file" asp-for="OutOfCompoundViewPhotoUrl" class="form-control" accept="image/*" />
                    <span asp-validation-for="OutOfCompoundViewPhotoUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="HouseInternalViewPhotoUrl" class="form-label">House Internal View</label>
                    @if (!string.IsNullOrEmpty(Model.House.HouseInternalViewPhotoUrl))
                    {
                        <img src="@Model.House.HouseInternalViewPhotoUrl" alt="Current House Internal View" class="img-thumbnail house-thumb" />
                    }
                    <input type="file" asp-for="HouseInternalViewPhotoUrl" class="form-control" accept="image/*" />
                    <span asp-validation-for="HouseInternalViewPhotoUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MainSalonViewPhotoUrl" class="form-label">Main Salon View</label>
                    @if (!string.IsNullOrEmpty(Model.House.MainSalonViewPhotoUrl))
                    {
                        <img src="@Model.House.MainSalonViewPhotoUrl" alt="Current Main Salon View" class="img-thumbnail house-thumb" />
                    }
                    <input type="file" asp-for="MainSalonViewPhotoUrl" class="form-control" accept="image/*" />
                    <span asp-validation-for="MainSalonViewPhotoUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MasterBedRoomViewPhotoUrl" class="form-label">Master Bedroom View</label>
                    @if (!string.IsNullOrEmpty(Model.House.MasterBedRoomViewPhotoUrl))
                    {
                        <img src="@Model.House.MasterBedRoomViewPhotoUrl" alt="Current Master Bedroom View" class="img-thumbnail house-thumb" />
                    }
                    <input type="file" asp-for="MasterBedRoomViewPhotoUrl" class="form-control" accept="image/*" />
                    <span asp-validation-for="MasterBedRoomViewPhotoUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="KitchenViewPhotoUrl" class="form-label">Kitchen View</label>
                    @if (!string.IsNullOrEmpty(Model.House.KitchenViewPhotoUrl))
                    {
                        <img src="@Model.House.KitchenViewPhotoUrl" alt="Current Kitchen View" class="img-thumbnail house-thumb" />
                    }
                    <input type="file" asp-for="KitchenViewPhotoUrl" class="form-control" accept="image/*" />
                    <span asp-validation-for="KitchenViewPhotoUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="RestRoomViewPhotoUrl" class="form-label">Restroom View</label>
                    @if (!string.IsNullOrEmpty(Model.House.RestRoomViewPhotoUrl))
                    {
                        <img src="@Model.House.RestRoomViewPhotoUrl" alt="Current Restroom View" class="img-thumbnail house-thumb" />
                    }
                    <input type="file" asp-for="RestRoomViewPhotoUrl" class="form-control" accept="image/*" />
                    <span asp-validation-for="RestRoomViewPhotoUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AuxiSalonViewPhotoUrl" class="form-label">Auxiliary Salon View</label>
                    @if (!string.IsNullOrEmpty(Model.House.AuxiSalonViewPhotoUrl))
                    {
                        <img src="@Model.House.AuxiSalonViewPhotoUrl" alt="Current Auxiliary Salon View" class="img-thumbnail house-thumb" />
                    }
                    <input type="file" asp-for="AuxiSalonViewPhotoUrl" class="form-control" accept="image/*" />
                    <span asp-validation-for="AuxiSalonViewPhotoUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="SecBedRoomViewPhotoUrl" class="form-label">Second Bedroom View</label>
                    @if (!string.IsNullOrEmpty(Model.House.SecBedRoomViewPhotoUrl))
                    {
                        <img src="@Model.House.SecBedRoomViewPhotoUrl" alt="Current Second Bedroom View" class="img-thumbnail house-thumb" />
                    }
                    <input type="file" asp-for="SecBedRoomViewPhotoUrl" class="form-control" accept="image/*" />
                    <span asp-validation-for="SecBedRoomViewPhotoUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AdditionalViewPhotoUrl" class="form-label">Additional View</label>
                    @if (!string.IsNullOrEmpty(Model.House.AdditionalViewPhotoUrl))
                    {
                        <img src="@Model.House.AdditionalViewPhotoUrl" alt="Current Additional View" class="img-thumbnail house-thumb" />
                    }
                    <input type="file" asp-for="AdditionalViewPhotoUrl" class="form-control" accept="image/*" />
                    <span asp-validation-for="AdditionalViewPhotoUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="BackyardViewPhotoUrl" class="form-label">Backyard View</label>
                    @if (!string.IsNullOrEmpty(Model.House.BackyardViewPhotoUrl))
                    {
                        <img src="@Model.House.BackyardViewPhotoUrl" alt="Current Backyard View" class="img-thumbnail house-thumb" />
                    }
                    <input type="file" asp-for="BackyardViewPhotoUrl" class="form-control" accept="image/*" />
                    <span asp-validation-for="BackyardViewPhotoUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Additional2PhotoUrl" class="form-label">Additional Photo 2</label>
                    @if (!string.IsNullOrEmpty(Model.House.Additional2PhotoUrl))
                    {
                        <img src="@Model.House.Additional2PhotoUrl" alt="Current Additional Photo 2" class="img-thumbnail house-thumb" />
                    }
                    <input type="file" asp-for="Additional2PhotoUrl" class="form-control" accept="image/*" />
                    <span asp-validation-for="Additional2PhotoUrl" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="mh-form-actions">
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save Changes</button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const availableForSelect = document.querySelector('[name="House.AvailableFor"]');
            const rentInfoSection = document.getElementById("rent-info-section");
            function toggleRentInfo() {
                rentInfoSection.hidden = availableForSelect.value !== "@HouseAvailability.Rent";
            }
            availableForSelect.addEventListener("change", toggleRentInfo);
            toggleRentInfo();
        });
    </script>
}
