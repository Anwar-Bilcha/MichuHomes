@page
@model RadiantHomes.Pages.Houses.IndexModel

@{
    ViewData["Title"] = "Houses";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <h1 class="mb-4 text-center" data-translate="HousesAvailable">Available Houses</h1>

    <p>
        <a asp-page="/Houses/Create" class="btn btn-success d-inline-flex align-items-center gap-2">
            <i class="bi bi-house-add-fill"></i>
            <span data-translate="registerhousebtn">Add New House</span>
        </a>
        <a asp-page="Create" class="btn btn-success" data-translate="registerhousebtn">
            <i class="bi bi-house-add me-1"></i> Add New House
        </a>
    </p>

    <div class="row">
        <!-- Filters Column -->
        <div class="col-lg-3 mb-4">
            <div class="card shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <h5 class="card-title mb-3">Filter Houses</h5>
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="priceMin" class="form-label">Min Price (ETB)</label>
                            <input type="number" class="form-control form-control-sm" id="priceMin" placeholder="Min">
                        </div>
                        <div class="col-12">
                            <label for="priceMax" class="form-label">Max Price (ETB)</label>
                            <input type="number" class="form-control form-control-sm" id="priceMax" placeholder="Max">
                        </div>
                        <div class="col-12">
                            <label for="availability" class="form-label">Availability</label>
                            <select class="form-select form-select-sm" id="availability">
                                <option value="">All</option>
                                <option value="Rent">Rent</option>
                                <option value="Sell">Sale</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label for="category" class="form-label">Category</label>
                            <select class="form-select form-select-sm" id="category">
                                <option value="">All</option>
                                @if (Model.House.Any())
                                {
                                    @foreach (var category in Model.House.Select(h => new { h.HouseCategory?.Name, h.HouseCategory?.Id }).Distinct().OrderBy(c => c.Name))
                                    {
                                        @if (!string.IsNullOrEmpty(category.Id.ToString()))
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label for="city" class="form-label">City</label>
                            <select class="form-select form-select-sm" id="city">
                                <option value="">All</option>
                                @if (Model.House.Any() && Model.House.Any(h => h.HouseAddress?.City != null))
                                {
                                    @foreach (var city in Model.House.Where(h => h.HouseAddress?.City != null).Select(h => h.HouseAddress.City).Distinct().OrderBy(c => c))
                                    {
                                        <option value="@city">@city</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary btn-sm w-50 me-2" onclick="filterHouses()">Filter</button>
                            <button type="button" class="btn btn-outline-warning btn-sm w-50" onclick="resetFilters()">Reset</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Houses Column -->
        <div class="col-lg-9">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4" id="housesContainer">
                @foreach (var item in Model.House)
                {
                    if(item.AvailableFor.ToLower()=="rent")
                    {
                        string rentPrice = $"{@item.Price} / {@item.HouseRentInfo.RentTerm}";
                        <div class="col house-grid-item"
                             data-price="@rentPrice"
                             data-availability="@item.AvailableFor"
                             data-category="@item.HouseCategory?.Id"
                             data-city="@item.HouseAddress?.City">
                            <div class="card bg-dark text-white shadow rounded-4 overflow-hidden"
                                 style="background-image: url('@item.MainPhotoUrl'); background-size: cover; background-position: center; height: 350px;">
                                <div class="card-img-overlay d-flex flex-column justify-content-end p-3">
                                    <h5 class="card-title fw-bold text-truncate">@item.Title</h5>
                                    <p class="card-text small mb-1"><i class="bi bi-geo-alt-fill"></i> @item.HouseAddress?.City</p>
                                    <p class="card-text fw-bold mb-0">
                                        ETB @item.Price.ToString("N0")
                                    </p>
                                    <div class="mt-2">
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light rounded-pill">View Details</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                    }
                    else
                    {
                        <div class="col house-grid-item"
                             data-price="@item.HouseRentInfo.PricePerTerm"
                             data-availability="@item.AvailableFor"
                             data-category="@item.HouseCategory?.Id"
                             data-city="@item.HouseAddress?.City">
                            <div class="card bg-dark text-white shadow rounded-4 overflow-hidden"
                                 style="background-image: url('@item.MainPhotoUrl'); background-size: cover; background-position: center; height: 350px;">
                                <div class="card-img-overlay d-flex flex-column justify-content-end p-3">
                                    <h5 class="card-title fw-bold text-truncate">@item.Title</h5>
                                    <p class="card-text small mb-1"><i class="bi bi-geo-alt-fill"></i> @item.HouseAddress?.City</p>
                                    <p class="card-text fw-bold mb-0">
                                        ETB @item.Price.ToString("N0")
                                    </p>
                                    <div class="mt-2">
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light rounded-pill">View Details</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                    }
                    }
            </div>
        </div>
    </div>
</div>

<style>
    .house-grid-item {
        height: 350px;
    }

    .card-img-overlay {
    }
</style>

@section Scripts {
    <script>
        function filterHouses() {
            const priceMin = parseFloat(document.getElementById('priceMin').value) || 0;
            const priceMax = parseFloat(document.getElementById('priceMax').value) || Infinity;
            const availability = document.getElementById('availability').value;
            const category = document.getElementById('category').value;
            const city = document.getElementById('city').value;
            const houseItems = document.querySelectorAll('#housesContainer .house-grid-item');

            houseItems.forEach(item => {
                const housePrice = parseFloat(item.dataset.price);
                const houseAvailability = item.dataset.availability || '';
                const houseCategory = item.dataset.category || '';
                const houseCity = item.dataset.city || '';
                const priceCondition = housePrice >= priceMin && housePrice <= priceMax;
                const availabilityCondition = availability === '' || houseAvailability === availability;
                const categoryCondition = category === '' || houseCategory === category;
                const cityCondition = city === '' || houseCity === city;

                if (priceCondition && availabilityCondition && categoryCondition && cityCondition) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        function resetFilters() {
            document.getElementById('priceMin').value = '';
            document.getElementById('priceMax').value = '';
            document.getElementById('availability').value = '';
            document.getElementById('category').value = '';
            document.getElementById('city').value = '';
            filterHouses();
        }
    </script>
}
