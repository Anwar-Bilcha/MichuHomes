@page
@model RadiantHomes.Pages.Houses.IndexModel

@{
    ViewData["Title"] = "Available houses";
    ViewData["Subtitle"] = "Houses listed for rent or sale.";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var hasRows = Model.House is not null && Model.House.Any();
}

@section PageActions {
    <a asp-page="/Houses/Create" class="btn btn-primary">
        <i class="bi bi-house-add" aria-hidden="true"></i>
        <span>Add New House</span>
    </a>
}


<div class="row g-4">
    <!-- Filters Column -->
    <div class="col-lg-3">
        <div class="card">
            <div class="card-header">
                <h2 class="mh-section-title"><i class="bi bi-funnel" aria-hidden="true"></i> Filter Houses</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-lg-12">
                        <label for="priceMin" class="form-label">Min Price (ETB)</label>
                        <input type="number" class="form-control form-control-sm" id="priceMin" placeholder="Min">
                    </div>
                    <div class="col-6 col-lg-12">
                        <label for="priceMax" class="form-label">Max Price (ETB)</label>
                        <input type="number" class="form-control form-control-sm" id="priceMax" placeholder="Max">
                    </div>
                    <div class="col-md-4 col-lg-12">
                        <label for="availability" class="form-label">Availability</label>
                        <select class="form-select form-select-sm" id="availability">
                            <option value="">All</option>
                            <option value="@HouseAvailability.Rent">Rent</option>
                            <option value="@HouseAvailability.Sale">Sale</option>
                        </select>
                    </div>
                    <div class="col-md-4 col-lg-12">
                        <label for="category" class="form-label">Category</label>
                        <select class="form-select form-select-sm" id="category">
                            <option value="">All</option>
                            @if (hasRows)
                            {
                                @foreach (var category in Model.House.Select(h => new { h.HouseCategory?.Name, h.HouseCategory?.Id }).Distinct().OrderBy(c => c.Name))
                                {
                                    @if (!string.IsNullOrEmpty(category.Id.ToString()))
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4 col-lg-12">
                        <label for="city" class="form-label">City</label>
                        <select class="form-select form-select-sm" id="city">
                            <option value="">All</option>
                            @if (hasRows && Model.House.Any(h => h.HouseAddress?.City != null))
                            {
                                @foreach (var city in Model.House.Where(h => h.HouseAddress?.City != null).Select(h => h.HouseAddress.City).Distinct().OrderBy(c => c))
                                {
                                    <option value="@city">@city</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button type="button" class="btn btn-primary btn-sm flex-fill" onclick="filterHouses()">Filter</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" onclick="resetFilters()">Reset</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Houses Column -->
    <div class="col-lg-9">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-4 @(hasRows ? "" : "d-none")" id="housesContainer">
            @if (hasRows)
            {
                @foreach (var item in Model.House)
                {
                    var isForRent = HouseAvailability.IsForRent(item.AvailableFor);
                    var listingPrice = HouseAvailability.ListingPrice(item);
                    <div class="col house-grid-item"
                         data-price="@HouseAvailability.InvariantNumber(listingPrice)"
                         data-availability="@HouseAvailability.Normalize(item.AvailableFor)"
                         data-category="@item.HouseCategory?.Id"
                         data-city="@item.HouseAddress?.City">
                        <div class="card mh-media-card h-100">
                            @if (!string.IsNullOrEmpty(item.MainPhotoUrl))
                            {
                                <img src="@item.MainPhotoUrl" class="card-img-top" alt="@item.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="card-img-top d-flex align-items-center justify-content-center text-muted fs-1" aria-hidden="true"><i class="bi bi-house"></i></div>
                            }
                            <div class="card-body d-flex flex-column">
                                <span class="mh-chip @(isForRent ? "mh-chip--accent" : "") align-self-start mb-2">@HouseAvailability.Label(item.AvailableFor)</span>
                                <h3 class="card-title h6 text-truncate mb-1">@item.Title</h3>
                                <p class="card-text small text-muted mb-2"><i class="bi bi-geo-alt" aria-hidden="true"></i> @item.HouseAddress?.City</p>
                                <p class="card-text fw-bold text-navy mb-3">
                                    ETB @listingPrice.ToString("N0")
                                    @if (isForRent && item.HouseRentInfo is not null)
                                    {
                                        <span class="fw-normal small text-muted">/ @HouseAvailability.RentTermLabel(item.HouseRentInfo.RentTerm).ToLowerInvariant()</span>
                                    }
                                </p>
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary mt-auto align-self-start">View Details</a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        @if (!hasRows)
        {
            <div class="card">
                <div class="mh-empty">
                    <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-house"></i></span>
                    <h2>No houses listed yet</h2>
                    <p>Houses appear here once owners list them for rent or sale.</p>
                    <a asp-page="/Houses/Create" class="btn btn-primary"><i class="bi bi-house-add" aria-hidden="true"></i> <span>Add New House</span></a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function filterHouses() {
            const priceMin = parseFloat(document.getElementById('priceMin').value) || 0;
            const priceMax = parseFloat(document.getElementById('priceMax').value) || Infinity;
            const availability = document.getElementById('availability').value;
            const category = document.getElementById('category').value;
            const city = document.getElementById('city').value;
            const houseItems = document.querySelectorAll('#housesContainer .house-grid-item');

            houseItems.forEach(item => {
                const housePrice = parseFloat(item.dataset.price);
                const houseAvailability = item.dataset.availability || '';
                const houseCategory = item.dataset.category || '';
                const houseCity = item.dataset.city || '';
                const priceCondition = housePrice >= priceMin && housePrice <= priceMax;
                const availabilityCondition = availability === '' || houseAvailability === availability;
                const categoryCondition = category === '' || houseCategory === category;
                const cityCondition = city === '' || houseCity === city;

                if (priceCondition && availabilityCondition && categoryCondition && cityCondition) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        function resetFilters() {
            document.getElementById('priceMin').value = '';
            document.getElementById('priceMax').value = '';
            document.getElementById('availability').value = '';
            document.getElementById('category').value = '';
            document.getElementById('city').value = '';
            filterHouses();
        }
    </script>
}
