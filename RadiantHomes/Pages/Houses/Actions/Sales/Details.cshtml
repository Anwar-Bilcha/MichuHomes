@page
@model RadiantHomes.Pages.Houses.Actions.Sales.DetailsModel

@{
    ViewData["Title"] = "House sale details";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section PageActions {
    <a class="btn btn-secondary" asp-page="./Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list</a>
    <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.HouseSaleTransaction.Id"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</a>
}

<div class="card">
    <div class="card-body">
        <dl class="mh-dl">
            <dt>@Html.DisplayNameFor(model => model.HouseSaleTransaction.House)</dt>
            <dd><a asp-page="/Houses/Details" asp-route-id="@Model.HouseSaleTransaction.HouseId">@Model.HouseSaleTransaction.House?.Title</a></dd>
            <dt>@Html.DisplayNameFor(model => model.HouseSaleTransaction.Receiver)</dt>
            <dd>@DisplayText.PersonName(Model.HouseSaleTransaction.Receiver)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseSaleTransaction.HomeOwner)</dt>
            <dd>@DisplayText.PersonName(Model.HouseSaleTransaction.HomeOwner)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseSaleTransaction.TransactionDate)</dt>
            <dd>@Html.DisplayFor(model => model.HouseSaleTransaction.TransactionDate)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseSaleTransaction.Status)</dt>
            <dd>@Html.DisplayFor(model => model.HouseSaleTransaction.Status)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseSaleTransaction.Notes)</dt>
            <dd>@Html.DisplayFor(model => model.HouseSaleTransaction.Notes)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseSaleTransaction.CreatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.HouseSaleTransaction.CreatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseSaleTransaction.CreatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.HouseSaleTransaction.CreatedOn)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseSaleTransaction.UpdatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.HouseSaleTransaction.UpdatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseSaleTransaction.UpdatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.HouseSaleTransaction.UpdatedOn)</dd>
        </dl>
    </div>
</div>
