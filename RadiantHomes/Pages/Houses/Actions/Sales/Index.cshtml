@page
@model RadiantHomes.Pages.Houses.Actions.Sales.IndexModel

@{
    ViewData["Title"] = "House sales";
    ViewData["Subtitle"] = "House sale transactions between owners and buyers.";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var hasRows = Model.HouseSaleTransaction != null && Model.HouseSaleTransaction.Any();
}

@section PageActions {
    <a class="btn btn-outline-primary" asp-page="HouseSalesExport" asp-route-format="excel" data-no-loader>
        <i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Download Excel
    </a>
    <a class="btn btn-outline-primary" asp-page="HouseSalesExport" asp-route-format="pdf" data-no-loader>
        <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Download PDF
    </a>
    <a class="btn btn-primary" asp-page="Create">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> New sale
    </a>
}


<div class="card">
    @if (hasRows)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">House</th>
                        <th scope="col">Buyer</th>
                        <th scope="col">Seller</th>
                        <th scope="col">Date</th>
                        <th scope="col">Status</th>
                        <th scope="col">Notes</th>
                        <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.HouseSaleTransaction)
                    {
                        <tr>
                            <td>@item.House?.Title</td>
                            <td>@item.Receiver?.FirstName</td>
                            <td>@item.HomeOwner?.FirstName</td>
                            <td>@item.TransactionDate.ToShortDateString()</td>
                            <td>
                                <span class="badge @(item.Status == "Completed" ? "bg-success" : "bg-warning")">
                                    @item.Status
                                </span>
                            </td>
                            <td>@item.Notes</td>
                            <td class="text-end">
                                <div class="mh-row-actions">
                                    <a class="btn btn-sm btn-outline-secondary btn-icon" asp-page="./Details" asp-route-id="@item.Id" title="View details" aria-label="View details"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                    <a class="btn btn-sm btn-outline-primary btn-icon" asp-page="./Edit" asp-route-id="@item.Id" title="Edit" aria-label="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                    <a class="btn btn-sm btn-outline-danger btn-icon" asp-page="./Delete" asp-route-id="@item.Id" title="Delete" aria-label="Delete"><i class="bi bi-trash" aria-hidden="true"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-cash-stack"></i></span>
            <h2>No house sales found.</h2>
            <p>Sale transactions appear here once a house is sold.</p>
            <a class="btn btn-primary" asp-page="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> New sale</a>
        </div>
    }
</div>
