@page
@model RadiantHomes.Pages.Houses.Actions.Sales.IndexModel

@{
    ViewData["Title"] = "House Sales";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">House Sales</h2>
        <a class="btn btn-success" asp-page="Create"><i class="bi bi-plus-circle"></i> Create New</a>
    </div>

    @if (Model.HouseSaleTransaction != null && Model.HouseSaleTransaction.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>House</th>
                        <th>Buyer</th>
                        <th>Seller</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.HouseSaleTransaction)
                    {
                        <tr>
                            <td>@item.House?.Title"</td>
                            <td>@item.Receiver?.FirstName </td>
                            <td>@item.HomeOwner?.FirstName</td>
                            <td>@item.TransactionDate.ToShortDateString()</td>
                            <td>
                                <span class="badge @(item.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">
                                    @item.Status
                                </span>
                            </td>
                            <td>@item.Notes</td>
                            <td class="text-center">
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            No house sales found.
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">House Sales</h2>
        <div>
            <a class="btn btn-success me-2" asp-page="Create"><i class="bi bi-plus-circle"></i> Create New</a>
            <a class="btn btn-outline-primary me-2" asp-page="HouseSalesExport" asp-route-format="excel">
                <i class="bi bi-file-earmark-excel"></i> Download Excel
            </a>
            <a class="btn btn-outline-danger" asp-page="HouseSalesExport" asp-route-format="pdf">
                <i class="bi bi-file-earmark-pdf"></i> Download PDF
            </a>
        </div>
    </div>
</div>
