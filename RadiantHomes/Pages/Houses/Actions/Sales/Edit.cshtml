@page
@model RadiantHomes.Pages.Houses.Actions.Sales.EditModel

@{
    ViewData["Title"] = "Edit house sale";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<form method="post" class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="HouseSaleTransaction.Id" />

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Sale</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="HouseSaleTransaction.HouseId" class="form-label">House</label>
                    @if (Model.CanEditParties)
                    {
                        <select asp-for="HouseSaleTransaction.HouseId" class="form-select" asp-items="ViewBag.HouseId"></select>
                    }
                    else
                    {
                        <input id="HouseSaleTransaction_HouseId" class="form-control" value="@Model.HouseTitle" readonly />
                    }
                    <span asp-validation-for="HouseSaleTransaction.HouseId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseSaleTransaction.CustomerId" class="form-label">Buyer</label>
                    @if (Model.CanEditParties)
                    {
                        <select asp-for="HouseSaleTransaction.CustomerId" class="form-select" asp-items="ViewBag.CustomerId"></select>
                    }
                    else
                    {
                        <input id="HouseSaleTransaction_CustomerId" class="form-control" value="@Model.BuyerName" readonly />
                    }
                    <span asp-validation-for="HouseSaleTransaction.CustomerId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseSaleTransaction.OwnerId" class="form-label">Seller</label>
                    @if (Model.CanEditParties)
                    {
                        <select asp-for="HouseSaleTransaction.OwnerId" class="form-select" asp-items="ViewBag.OwnerId"></select>
                    }
                    else
                    {
                        <input id="HouseSaleTransaction_OwnerId" class="form-control" value="@Model.SellerName" readonly />
                    }
                    <span asp-validation-for="HouseSaleTransaction.OwnerId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseSaleTransaction.TransactionDate" class="form-label">Transaction Date</label>
                    <input asp-for="HouseSaleTransaction.TransactionDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="HouseSaleTransaction.TransactionDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseSaleTransaction.Status" class="form-label">Status</label>
                    <input asp-for="HouseSaleTransaction.Status" class="form-control" placeholder="e.g. Completed, Pending..." />
                    <span asp-validation-for="HouseSaleTransaction.Status" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="HouseSaleTransaction.Notes" class="form-label">Notes</label>
                    <textarea asp-for="HouseSaleTransaction.Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="HouseSaleTransaction.Notes" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="mh-form-actions">
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save Changes</button>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
