@page
@model RadiantHomes.Pages.Houses.Actions.Sales.CreateModel

@{
    ViewData["Title"] = "New house sale";
    ViewData["Subtitle"] = "Register a house sale transaction.";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@if (Model.ProfileMissingMessage is not null)
{
    <div class="alert alert-warning" role="status">@Model.ProfileMissingMessage</div>
    <div class="mh-form-actions">
        <a asp-page="Index" class="btn btn-secondary">Back to sales</a>
        <a asp-page="/HouseOwner/Create" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i> Create a customer profile</a>
    </div>
    return;
}

<form method="post" class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="HouseSaleTransaction.HouseId" class="form-label"></label>
                @if (Model.CanEditParties || Model.IsChoosingHouse)
                {
                    @if (Model.IsChoosingHouse)
                    {
                        <input type="hidden" name="ChoosingHouse" value="1" />
                    }
                    <select asp-for="HouseSaleTransaction.HouseId" class="form-select" asp-items="ViewBag.HouseId" autofocus>
                        <option value="">-- Select House --</option>
                    </select>
                }
                else
                {
                    <input type="hidden" asp-for="HouseSaleTransaction.HouseId" />
                    <input id="HouseSaleTransaction_HouseTitle" class="form-control" value="@Model.HouseTitle" readonly />
                }
                <span asp-validation-for="HouseSaleTransaction.HouseId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="HouseSaleTransaction.CustomerId" class="form-label"></label>
                @if (Model.CanEditParties)
                {
                    <select asp-for="HouseSaleTransaction.CustomerId" class="form-select" asp-items="ViewBag.CustomerId">
                        <option value="">-- Select Buyer --</option>
                    </select>
                }
                else
                {
                    <input id="HouseSaleTransaction_CustomerId" class="form-control" value="@Model.BuyerName" readonly />
                }
                <span asp-validation-for="HouseSaleTransaction.CustomerId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="HouseSaleTransaction.OwnerId" class="form-label"></label>
                @if (Model.CanEditParties)
                {
                    <select asp-for="HouseSaleTransaction.OwnerId" class="form-select" asp-items="ViewBag.OwnerId">
                        <option value="">-- Select Seller --</option>
                    </select>
                }
                else
                {
                    @* The seller is always the house's owner (set by the server). *@
                    <input id="HouseSaleTransaction_OwnerId" class="form-control" value="@(Model.IsChoosingHouse ? "The owner of the chosen house" : Model.SellerName)" readonly />
                }
                <span asp-validation-for="HouseSaleTransaction.OwnerId" class="text-danger small"></span>
            </div>
            @if (Model.CanEditParties)
            {
                <div class="col-md-6">
                    <label asp-for="HouseSaleTransaction.TransactionDate" class="form-label"></label>
                    <input asp-for="HouseSaleTransaction.TransactionDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="HouseSaleTransaction.TransactionDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseSaleTransaction.Status" class="form-label"></label>
                    <select asp-for="HouseSaleTransaction.Status" class="form-select">
                        <option value="">-- Select Status --</option>
                        <option value="Pending">Pending</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                    <span asp-validation-for="HouseSaleTransaction.Status" class="text-danger small"></span>
                </div>
            }
            <div class="col-12">
                <label asp-for="HouseSaleTransaction.Notes" class="form-label"></label>
                <textarea asp-for="HouseSaleTransaction.Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="HouseSaleTransaction.Notes" class="text-danger small"></span>
            </div>
        </div>

        <div class="mh-form-actions">
            <a asp-page="Index" class="btn btn-secondary">Back to list</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Submit</button>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
