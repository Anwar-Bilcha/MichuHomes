@page
@model RadiantHomes.Pages.Houses.Actions.Sales.CreateModel

@{
    ViewData["Title"] = "Create Sale Transaction";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2 class="mt-4 mb-3">Register House Sale Transaction</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="HouseSaleTransaction.HouseId" class="form-label"></label>
                <select asp-for="HouseSaleTransaction.HouseId" class="form-select" asp-items="ViewBag.HouseId" autofocus></select>
                <span asp-validation-for="HouseSaleTransaction.HouseId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HouseSaleTransaction.CustomerId" class="form-label"></label>
                <select asp-for="HouseSaleTransaction.CustomerId" class="form-select" asp-items="ViewBag.CustomerId"></select>
                <span asp-validation-for="HouseSaleTransaction.CustomerId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HouseSaleTransaction.OwnerId" class="form-label"></label>
                <select asp-for="HouseSaleTransaction.OwnerId" class="form-select" asp-items="ViewBag.OwnerId"></select>
                <span asp-validation-for="HouseSaleTransaction.OwnerId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HouseSaleTransaction.TransactionDate" class="form-label"></label>
                <input asp-for="HouseSaleTransaction.TransactionDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="HouseSaleTransaction.TransactionDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HouseSaleTransaction.Status" class="form-label"></label>
                <select asp-for="HouseSaleTransaction.Status" class="form-select">
                    <option value="">-- Select Status --</option>
                    <option value="Pending">Pending</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <span asp-validation-for="HouseSaleTransaction.Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HouseSaleTransaction.Notes" class="form-label"></label>
                <textarea asp-for="HouseSaleTransaction.Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="HouseSaleTransaction.Notes" class="text-danger"></span>
            </div>

            <!-- Optional: System-generated fields can be hidden or made readonly -->
            <!--
            <div class="mb-3">
                <label asp-for="HouseSaleTransaction.CreatedBy" class="form-label"></label>
                <input asp-for="HouseSaleTransaction.CreatedBy" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="HouseSaleTransaction.CreatedOn" class="form-label"></label>
                <input asp-for="HouseSaleTransaction.CreatedOn" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="HouseSaleTransaction.UpdatedBy" class="form-label"></label>
                <input asp-for="HouseSaleTransaction.UpdatedBy" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="HouseSaleTransaction.UpdatedOn" class="form-label"></label>
                <input asp-for="HouseSaleTransaction.UpdatedOn" class="form-control" readonly />
            </div>
            -->

            <div class="d-flex justify-content-between mt-4">
                <button type="submit" class="btn btn-primary">Submit</button>
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
