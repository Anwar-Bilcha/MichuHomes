@page
@model RadiantHomes.Pages.Houses.Actions.Rent.DeleteModel

@{
    ViewData["Title"] = "Delete rent transaction";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="card mh-confirm">
    <div class="card-header">
        <h2 class="mh-section-title text-reset"><i class="bi bi-exclamation-triangle text-reset" aria-hidden="true"></i> Are you sure you want to delete this rent transaction?</h2>
    </div>
    <div class="card-body">
        <p class="text-muted">This permanently removes the record below. It can't be undone.</p>
        <dl class="mh-dl">
            <dt>@Html.DisplayNameFor(model => model.HouseRentTransaction.House)</dt>
            <dd><a asp-page="/Houses/Details" asp-route-id="@Model.HouseRentTransaction.HouseId">@Model.HouseRentTransaction.House?.Title</a></dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentTransaction.Receiver)</dt>
            <dd>@DisplayText.PersonName(Model.HouseRentTransaction.Receiver)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentTransaction.HomeOwner)</dt>
            <dd>@DisplayText.PersonName(Model.HouseRentTransaction.HomeOwner)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentTransaction.TransactionDate)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentTransaction.TransactionDate)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentTransaction.RentDuration)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentTransaction.RentDuration)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentTransaction.RentStartingDate)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentTransaction.RentStartingDate)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentTransaction.RentEndDate)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentTransaction.RentEndDate)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentTransaction.Status)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentTransaction.Status)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentTransaction.Notes)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentTransaction.Notes)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentTransaction.CreatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentTransaction.CreatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentTransaction.CreatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentTransaction.CreatedOn)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentTransaction.UpdatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentTransaction.UpdatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentTransaction.UpdatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentTransaction.UpdatedOn)</dd>
        </dl>

        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }
        <form method="post" class="mh-form-actions">
            <input type="hidden" asp-for="HouseRentTransaction.Id" />
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash" aria-hidden="true"></i> Delete transaction</button>
        </form>
    </div>
</div>
