@page
@model RadiantHomes.Pages.Houses.Actions.Rent.CreateModel

@{
    ViewData["Title"] = "Create House Rent Transaction";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="mb-4">Create Rent Transaction</h1>

<hr />

<form method="post" class="needs-validation" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <input type="hidden" asp-for="HouseId" class="form-control" />
                <span asp-validation-for="HouseId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="hidden" asp-for="CustomerId" class="form-control" />
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="hidden" asp-for="HouseOwnerId" class="form-control" />
                <span asp-validation-for="HouseOwnerId" class="text-danger"></span>
            </div>

            @* <div class="form-group mb-3">
                <label asp-for="HouseRentTransaction.TransactionDate" class="form-label">Transaction Date</label>
                <input asp-for="HouseRentTransaction.TransactionDate" class="form-control" type="date" />
                <span asp-validation-for="HouseRentTransaction.TransactionDate" class="text-danger"></span>
            </div> *@

            @* <div class="form-group mb-3">
                <label asp-for="HouseRentTransaction.Status" class="form-label">Status</label>
                <select asp-for="HouseRentTransaction.Status" class="form-control">
                    <option value="">-- Select Status --</option>
                    <option value="Pending">Pending</option>
                    <option value="Active">Active</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <span asp-validation-for="HouseRentTransaction.Status" class="text-danger"></span>
            </div> *@
        </div>

        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="HouseRentTransaction.RentDuration" class="form-label">Rent Duration (in months)</label>
                <input asp-for="HouseRentTransaction.RentDuration" class="form-control" type="number" min="1" />
                <span asp-validation-for="HouseRentTransaction.RentDuration" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="HouseRentTransaction.RentStartingDate" class="form-label">Start Date</label>
                <input asp-for="HouseRentTransaction.RentStartingDate" class="form-control" type="date" />
                <span asp-validation-for="HouseRentTransaction.RentStartingDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="HouseRentTransaction.RentEndDate" class="form-label">End Date</label>
                <input asp-for="HouseRentTransaction.RentEndDate" class="form-control" type="date" />
                <span asp-validation-for="HouseRentTransaction.RentEndDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="HouseRentTransaction.Notes" class="form-label">Additional Notes</label>
                <textarea asp-for="HouseRentTransaction.Notes" class="form-control" rows="3" placeholder="Enter any comments or special terms..."></textarea>
                <span asp-validation-for="HouseRentTransaction.Notes" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary me-2">Create Transaction</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
