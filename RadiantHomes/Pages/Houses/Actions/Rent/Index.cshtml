@page
@model RadiantHomes.Pages.Houses.Actions.Rent.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.HouseRentTransaction[0].House)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseRentTransaction[0].Receiver)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseRentTransaction[0].HomeOwner)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseRentTransaction[0].TransactionDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseRentTransaction[0].RentDuration)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseRentTransaction[0].RentStartingDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseRentTransaction[0].RentEndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseRentTransaction[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseRentTransaction[0].Notes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseRentTransaction[0].CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseRentTransaction[0].CreatedOn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseRentTransaction[0].UpdatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HouseRentTransaction[0].UpdatedOn)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.HouseRentTransaction) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.House.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Receiver.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HomeOwner.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TransactionDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RentDuration)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RentStartingDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RentEndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Notes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedOn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedOn)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
