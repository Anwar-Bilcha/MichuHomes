@page
@model RadiantHomes.Pages.Houses.Actions.Rent.EditModel

@{
    ViewData["Title"] = "Edit rent transaction";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<form method="post" class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="HouseRentTransaction.Id" />

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Transaction</h2>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="HouseRentTransaction.HouseId" class="form-label"></label>
                    @if (Model.CanEditParties)
                    {
                        <select asp-for="HouseRentTransaction.HouseId" class="form-select" asp-items="ViewBag.HouseId"></select>
                    }
                    else
                    {
                        <input id="HouseRentTransaction_HouseId" class="form-control" value="@Model.HouseTitle" readonly />
                    }
                    <span asp-validation-for="HouseRentTransaction.HouseId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseRentTransaction.CustomerId" class="form-label"></label>
                    @if (Model.CanEditParties)
                    {
                        <select asp-for="HouseRentTransaction.CustomerId" class="form-select" asp-items="ViewBag.CustomerId"></select>
                    }
                    else
                    {
                        <input id="HouseRentTransaction_CustomerId" class="form-control" value="@Model.TenantName" readonly />
                    }
                    <span asp-validation-for="HouseRentTransaction.CustomerId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseRentTransaction.OwnerId" class="form-label"></label>
                    @if (Model.CanEditParties)
                    {
                        <select asp-for="HouseRentTransaction.OwnerId" class="form-select" asp-items="ViewBag.OwnerId"></select>
                    }
                    else
                    {
                        <input id="HouseRentTransaction_OwnerId" class="form-control" value="@Model.OwnerName" readonly />
                    }
                    <span asp-validation-for="HouseRentTransaction.OwnerId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseRentTransaction.TransactionDate" class="form-label"></label>
                    <input asp-for="HouseRentTransaction.TransactionDate" class="form-control" />
                    <span asp-validation-for="HouseRentTransaction.TransactionDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseRentTransaction.Status" class="form-label"></label>
                    <input asp-for="HouseRentTransaction.Status" class="form-control" />
                    <span asp-validation-for="HouseRentTransaction.Status" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Rent period</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="HouseRentTransaction.RentDuration" class="form-label"></label>
                    <input asp-for="HouseRentTransaction.RentDuration" class="form-control" />
                    <span asp-validation-for="HouseRentTransaction.RentDuration" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="HouseRentTransaction.RentStartingDate" class="form-label"></label>
                    <input asp-for="HouseRentTransaction.RentStartingDate" class="form-control" />
                    <span asp-validation-for="HouseRentTransaction.RentStartingDate" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="HouseRentTransaction.RentEndDate" class="form-label"></label>
                    <input asp-for="HouseRentTransaction.RentEndDate" class="form-control" />
                    <span asp-validation-for="HouseRentTransaction.RentEndDate" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="HouseRentTransaction.Notes" class="form-label"></label>
                    <input asp-for="HouseRentTransaction.Notes" class="form-control" />
                    <span asp-validation-for="HouseRentTransaction.Notes" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="mh-form-actions">
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save changes</button>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
