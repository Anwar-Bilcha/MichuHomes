@page
@model RadiantHomes.Pages.Houses.Actions.Rent.Payment.IndexModel

@{
    ViewData["Title"] = "Rent payments";
    ViewData["Subtitle"] = "Payments recorded against house rent transactions.";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var hasRows = Model.HouseRentPayment is not null && Model.HouseRentPayment.Any();
}

@section PageActions {
    <a class="btn btn-primary" asp-page="Create">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> New payment
    </a>
}


<div class="card">
    @if (!hasRows)
    {
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-receipt"></i></span>
            <h2>No rent payments yet</h2>
            <p>Payments appear here once they are recorded for a rent transaction.</p>
            <a class="btn btn-primary" asp-page="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> New payment</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(model => model.HouseRentPayment[0].Transaction)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.HouseRentPayment[0].RentCommision)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.HouseRentPayment[0].RentPricePerTerm)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.HouseRentPayment[0].TotalRentPrice)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.HouseRentPayment[0].SalersPreferredBank)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.HouseRentPayment[0].BuyersPreferedBank)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.HouseRentPayment[0].CommisionedPreferedBank)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.HouseRentPayment[0].CreatedBy)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.HouseRentPayment[0].CreatedOn)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.HouseRentPayment[0].UpdatedBy)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.HouseRentPayment[0].UpdatedOn)</th>
                        <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.HouseRentPayment!)
                    {
                        <tr>
                            <td><a asp-page="/Houses/Actions/Rent/Details" asp-route-id="@item.TransactionId">@DisplayText.RentTransaction(item.Transaction)</a></td>
                            <td>@Html.DisplayFor(modelItem => item.RentCommision)</td>
                            <td>@Html.DisplayFor(modelItem => item.RentPricePerTerm)</td>
                            <td>@Html.DisplayFor(modelItem => item.TotalRentPrice)</td>
                            <td>@Html.DisplayFor(modelItem => item.SalersPreferredBank)</td>
                            <td>@Html.DisplayFor(modelItem => item.BuyersPreferedBank)</td>
                            <td>@Html.DisplayFor(modelItem => item.CommisionedPreferedBank)</td>
                            <td>@Html.DisplayFor(modelItem => item.CreatedBy)</td>
                            <td>@Html.DisplayFor(modelItem => item.CreatedOn)</td>
                            <td>@Html.DisplayFor(modelItem => item.UpdatedBy)</td>
                            <td>@Html.DisplayFor(modelItem => item.UpdatedOn)</td>
                            <td class="text-end">
                                <div class="mh-row-actions">
                                    <a class="btn btn-sm btn-outline-secondary btn-icon" asp-page="./Details" asp-route-id="@item.Id" title="View details" aria-label="View details"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                    <a class="btn btn-sm btn-outline-primary btn-icon" asp-page="./Edit" asp-route-id="@item.Id" title="Edit" aria-label="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                    <a class="btn btn-sm btn-outline-danger btn-icon" asp-page="./Delete" asp-route-id="@item.Id" title="Delete" aria-label="Delete"><i class="bi bi-trash" aria-hidden="true"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
