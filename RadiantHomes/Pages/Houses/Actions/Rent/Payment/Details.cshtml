@page
@model RadiantHomes.Pages.Houses.Actions.Rent.Payment.DetailsModel

@{
    ViewData["Title"] = "Rent payment details";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section PageActions {
    <a class="btn btn-secondary" asp-page="./Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list</a>
    <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.HouseRentPayment.Id"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</a>
}

<div class="card">
    <div class="card-body">
        <dl class="mh-dl">
            <dt>@Html.DisplayNameFor(model => model.HouseRentPayment.Transaction)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentPayment.Transaction.Id)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentPayment.RentCommision)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentPayment.RentCommision)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentPayment.RentPricePerTerm)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentPayment.RentPricePerTerm)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentPayment.TotalRentPrice)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentPayment.TotalRentPrice)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentPayment.SalersPreferredBank)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentPayment.SalersPreferredBank)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentPayment.BuyersPreferedBank)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentPayment.BuyersPreferedBank)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentPayment.CommisionedPreferedBank)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentPayment.CommisionedPreferedBank)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentPayment.CreatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentPayment.CreatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentPayment.CreatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentPayment.CreatedOn)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentPayment.UpdatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentPayment.UpdatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseRentPayment.UpdatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.HouseRentPayment.UpdatedOn)</dd>
        </dl>
    </div>
</div>
