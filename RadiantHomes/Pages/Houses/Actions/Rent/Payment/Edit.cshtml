@page
@model RadiantHomes.Pages.Houses.Actions.Rent.Payment.EditModel

@{
    ViewData["Title"] = "Edit rent payment";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<form method="post" class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="HouseRentPayment.Id" />

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Payment</h2>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="HouseRentPayment.TransactionId" class="form-label"></label>
                    <select asp-for="HouseRentPayment.TransactionId" class="form-select" asp-items="ViewBag.TransactionId"></select>
                    <span asp-validation-for="HouseRentPayment.TransactionId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="HouseRentPayment.RentCommision" class="form-label"></label>
                    <input asp-for="HouseRentPayment.RentCommision" class="form-control" />
                    <span asp-validation-for="HouseRentPayment.RentCommision" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="HouseRentPayment.RentPricePerTerm" class="form-label"></label>
                    <input asp-for="HouseRentPayment.RentPricePerTerm" class="form-control" />
                    <span asp-validation-for="HouseRentPayment.RentPricePerTerm" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="HouseRentPayment.TotalRentPrice" class="form-label"></label>
                    <input asp-for="HouseRentPayment.TotalRentPrice" class="form-control" />
                    <span asp-validation-for="HouseRentPayment.TotalRentPrice" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Banks</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="HouseRentPayment.SalersPreferredBank" class="form-label"></label>
                    <input asp-for="HouseRentPayment.SalersPreferredBank" class="form-control" />
                    <span asp-validation-for="HouseRentPayment.SalersPreferredBank" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="HouseRentPayment.BuyersPreferedBank" class="form-label"></label>
                    <input asp-for="HouseRentPayment.BuyersPreferedBank" class="form-control" />
                    <span asp-validation-for="HouseRentPayment.BuyersPreferedBank" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="HouseRentPayment.CommisionedPreferedBank" class="form-label"></label>
                    <input asp-for="HouseRentPayment.CommisionedPreferedBank" class="form-control" />
                    <span asp-validation-for="HouseRentPayment.CommisionedPreferedBank" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Record</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="HouseRentPayment.CreatedBy" class="form-label"></label>
                    <input asp-for="HouseRentPayment.CreatedBy" class="form-control" />
                    <span asp-validation-for="HouseRentPayment.CreatedBy" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseRentPayment.CreatedOn" class="form-label"></label>
                    <input asp-for="HouseRentPayment.CreatedOn" class="form-control" />
                    <span asp-validation-for="HouseRentPayment.CreatedOn" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseRentPayment.UpdatedBy" class="form-label"></label>
                    <input asp-for="HouseRentPayment.UpdatedBy" class="form-control" />
                    <span asp-validation-for="HouseRentPayment.UpdatedBy" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HouseRentPayment.UpdatedOn" class="form-label"></label>
                    <input asp-for="HouseRentPayment.UpdatedOn" class="form-control" />
                    <span asp-validation-for="HouseRentPayment.UpdatedOn" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mh-form-actions">
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save changes</button>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
