@page
@model RadiantHomes.Pages.Houses.Actions.Rent.Payment.CreateModel

@{
    ViewData["Title"] = "New rent payment";
    ViewData["Subtitle"] = "Amounts are calculated from the rent transaction.";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<form method="post" class="card needs-validation" novalidate>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <input type="hidden" asp-for="TransactionId" />
        <input type="hidden" asp-for="HouseRentPayment.SalersPreferredBank" />
        <input type="hidden" asp-for="HouseRentPayment.BuyersPreferedBank" />
        <input type="hidden" asp-for="HouseRentPayment.CommisionedPreferedBank" />
        <span asp-validation-for="HouseRentPayment.SalersPreferredBank" class="text-danger small d-block"></span>
        <span asp-validation-for="HouseRentPayment.BuyersPreferedBank" class="text-danger small d-block"></span>
        <span asp-validation-for="HouseRentPayment.CommisionedPreferedBank" class="text-danger small d-block"></span>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="HouseRentPayment.RentPricePerTerm" class="form-label">Rent price / term</label>
                <input asp-for="HouseRentPayment.RentPricePerTerm" readonly class="form-control" />
                <span asp-validation-for="HouseRentPayment.RentPricePerTerm" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="HouseRentPayment.TotalRentPrice" class="form-label">Total rent price</label>
                <input asp-for="HouseRentPayment.TotalRentPrice" readonly class="form-control" />
                <span asp-validation-for="HouseRentPayment.TotalRentPrice" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="HouseRentPayment.RentCommision" class="form-label">Commission</label>
                <input asp-for="HouseRentPayment.RentCommision" readonly class="form-control" />
                <span asp-validation-for="HouseRentPayment.RentCommision" class="text-danger small"></span>
            </div>
        </div>

        <div class="mh-form-actions">
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save payment</button>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
