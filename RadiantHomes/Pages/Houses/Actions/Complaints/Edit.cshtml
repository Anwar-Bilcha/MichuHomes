@page
@model RadiantHomes.Pages.Houses.Actions.Complaints.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1 class="mb-3">Edit Complaint</h1>

    <div class="card">
        <div class="card-header">
            Complaint Details
        </div>
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="IssueOrCompliant.IssueId" />

                <div class="mb-3">
                    <label asp-for="IssueOrCompliant.IssueName" class="form-label"></label>
                    <input asp-for="IssueOrCompliant.IssueName" class="form-control" />
                    <span asp-validation-for="IssueOrCompliant.IssueName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IssueOrCompliant.HouseId" class="form-label"></label>
                    <select asp-for="IssueOrCompliant.HouseId" class="form-select" asp-items="ViewBag.HouseId"></select>
                    <span asp-validation-for="IssueOrCompliant.HouseId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IssueOrCompliant.HouseOwnerId" class="form-label"></label>
                    <select asp-for="IssueOrCompliant.HouseOwnerId" class="form-select" asp-items="ViewBag.HouseOwnerId"></select>
                    <span asp-validation-for="IssueOrCompliant.HouseOwnerId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IssueOrCompliant.IssueCategory" class="control-label"></label>
                    <select asp-for="IssueOrCompliant.IssueCategory" class="form-control" asp-items="ViewBag.IssueCategories">
                        <option value="">-- Select Issue Category --</option>
                        <option>Incorrect Bed Rooms</option>
                        <option>Inaccurate Price</option>
                        <option>Fake Photo</option>
                        <option>House Not for Sale or Rent</option>
                        <option>Property Ownership is Mine</option>
                        <option>House has Legal Issues</option>
                        <option>Other</option>
                    </select>
                    <span asp-validation-for="IssueOrCompliant.IssueCategory" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IssueOrCompliant.SeverityLevel" class="control-label"></label>
                    <select asp-for="IssueOrCompliant.SeverityLevel" class="form-control" asp-items="ViewBag.SeverityLevels"></select>
                    <span asp-validation-for="IssueOrCompliant.SeverityLevel" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IssueOrCompliant.HowDoWeReachYou" class="control-label"></label>
                    <select asp-for="IssueOrCompliant.HowDoWeReachYou" class="form-control" asp-items="ViewBag.ContactMethods"></select>
                    <span asp-validation-for="IssueOrCompliant.HowDoWeReachYou" class="text-danger"></span>
                </div>


                <div class="mb-3">
                    <label asp-for="IssueOrCompliant.DetailedDescription" class="form-label"></label>
                    <input asp-for="IssueOrCompliant.DetailedDescription" class="form-control" />
                    <span asp-validation-for="IssueOrCompliant.DetailedDescription" class="text-danger"></span>
                </div>

                

                <div class="mb-3">
                    <label asp-for="IssueOrCompliant.SupportingEvidenceUrl" class="form-label"></label>
                    <input asp-for="IssueOrCompliant.SupportingEvidenceUrl" type="file" class="form-control" />
                    <span asp-validation-for="IssueOrCompliant.SupportingEvidenceUrl" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IssueOrCompliant.SupportingEvidence2Url" class="form-label"></label>
                    <input asp-for="IssueOrCompliant.SupportingEvidence2Url" type="file" class="form-control" />
                    <span asp-validation-for="IssueOrCompliant.SupportingEvidence2Url" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IssueOrCompliant.ComplainantFullName" class="form-label"></label>
                    <input asp-for="IssueOrCompliant.ComplainantFullName" class="form-control" />
                    <span asp-validation-for="IssueOrCompliant.ComplainantFullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IssueOrCompliant.HowDoWeReachYou" class="form-label"></label>
                    <input asp-for="IssueOrCompliant.HowDoWeReachYou" class="form-control" />
                    <span asp-validation-for="IssueOrCompliant.HowDoWeReachYou" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IssueOrCompliant.PhoneOrEmail" class="form-label"></label>
                    <input asp-for="IssueOrCompliant.PhoneOrEmail" class="form-control" />
                    <span asp-validation-for="IssueOrCompliant.PhoneOrEmail" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IssueOrCompliant.ComplainantAddress" class="form-label"></label>
                    <input asp-for="IssueOrCompliant.ComplainantAddress" class="form-control" />
                    <span asp-validation-for="IssueOrCompliant.ComplainantAddress" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
