@page
@model RadiantHomes.Pages.Houses.Actions.Complaints.DetailsModel

@{
    ViewData["Title"] = "Complaint Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="card shadow rounded-4">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Complaint Details</h3>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Issue Name</dt>
                <dd class="col-sm-8">@Model.IssueOrCompliant.IssueName</dd>

                <dt class="col-sm-4">House ID</dt>
                <dd class="col-sm-8">@Model.IssueOrCompliant.House?.Id</dd>

                <dt class="col-sm-4">House Owner ID</dt>
                <dd class="col-sm-8">@Model.IssueOrCompliant.HouseOwner?.Id</dd>

                <dt class="col-sm-4">Issue Category</dt>
                <dd class="col-sm-8">@Model.IssueOrCompliant.IssueCategory</dd>

                <dt class="col-sm-4">Detailed Description</dt>
                <dd class="col-sm-8 white-space-pre-wrap">@Model.IssueOrCompliant.DetailedDescription</dd>

                <dt class="col-sm-4">Severity Level</dt>
                <dd class="col-sm-8">@Model.IssueOrCompliant.SeverityLevel</dd>

                <dt class="col-sm-4">Evidence File 1</dt>
                <dd class="col-sm-8">
                    @if (!string.IsNullOrEmpty(Model.IssueOrCompliant.SupportingEvidenceUrl))
                    {
                        <a href="@Model.IssueOrCompliant.SupportingEvidenceUrl" class="link-primary" target="_blank">View Evidence</a>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Not Provided</span>
                    }
                </dd>

                <dt class="col-sm-4">Evidence File 2</dt>
                <dd class="col-sm-8">
                    @if (!string.IsNullOrEmpty(Model.IssueOrCompliant.SupportingEvidence2Url))
                    {
                        <a href="@Model.IssueOrCompliant.SupportingEvidence2Url" class="link-primary" target="_blank">View Evidence</a>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Not Provided</span>
                    }
                </dd>

                <dt class="col-sm-4">Complainant Name</dt>
                <dd class="col-sm-8">@Model.IssueOrCompliant.ComplainantFullName</dd>

                <dt class="col-sm-4">Preferred Contact Method</dt>
                <dd class="col-sm-8">@Model.IssueOrCompliant.HowDoWeReachYou</dd>

                <dt class="col-sm-4">Phone or Email</dt>
                <dd class="col-sm-8">@Model.IssueOrCompliant.PhoneOrEmail</dd>

                <dt class="col-sm-4">Complainant Address</dt>
                <dd class="col-sm-8">@Model.IssueOrCompliant.ComplainantAddress</dd>
            </dl>
        </div>
        <div class="card-footer bg-light d-flex justify-content-between">
            <a asp-page="./Edit" asp-route-id="@Model.IssueOrCompliant.IssueId" class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i> Edit
            </a>
            <a asp-page="./Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>
</div>
