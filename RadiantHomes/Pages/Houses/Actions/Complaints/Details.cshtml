@page
@model RadiantHomes.Pages.Houses.Actions.Complaints.DetailsModel

@{
    ViewData["Title"] = "Complaint details";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section PageActions {
    <a class="btn btn-secondary" asp-page="./Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list</a>
    @if (Model.CanChange)
    {
        <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.IssueOrCompliant.IssueId"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</a>
    }
}

<div class="card">
    <div class="card-body">
        <dl class="mh-dl">
            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.IssueName)</dt>
            <dd>@Model.IssueOrCompliant.IssueName</dd>

            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.House)</dt>
            <dd>
                @if (Model.IssueOrCompliant.House is not null)
                {
                    <a asp-page="/Houses/Details" asp-route-id="@Model.IssueOrCompliant.HouseId">@Model.IssueOrCompliant.House.Title</a>
                }
            </dd>

            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.HouseOwner)</dt>
            <dd>@DisplayText.PersonName(Model.IssueOrCompliant.HouseOwner)</dd>

            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.IssueCategory)</dt>
            <dd>@Model.IssueOrCompliant.IssueCategory</dd>

            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.DetailedDescription)</dt>
            <dd class="white-space-pre-wrap">@Model.IssueOrCompliant.DetailedDescription</dd>

            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.SeverityLevel)</dt>
            <dd>@Model.IssueOrCompliant.SeverityLevel</dd>

            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.SupportingEvidenceUrl)</dt>
            <dd>
                @if (!string.IsNullOrEmpty(Model.IssueOrCompliant.SupportingEvidenceUrl))
                {
                    <a href="@Model.IssueOrCompliant.SupportingEvidenceUrl" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> View Evidence</a>
                }
                else
                {
                    <span class="text-muted fst-italic">Not Provided</span>
                }
            </dd>

            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.SupportingEvidence2Url)</dt>
            <dd>
                @if (!string.IsNullOrEmpty(Model.IssueOrCompliant.SupportingEvidence2Url))
                {
                    <a href="@Model.IssueOrCompliant.SupportingEvidence2Url" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> View Evidence</a>
                }
                else
                {
                    <span class="text-muted fst-italic">Not Provided</span>
                }
            </dd>

            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.ComplainantFullName)</dt>
            <dd>@Model.IssueOrCompliant.ComplainantFullName</dd>

            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.HowDoWeReachYou)</dt>
            <dd>@Model.IssueOrCompliant.HowDoWeReachYou</dd>

            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.PhoneOrEmail)</dt>
            <dd>@Model.IssueOrCompliant.PhoneOrEmail</dd>

            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.ComplainantAddress)</dt>
            <dd>@Model.IssueOrCompliant.ComplainantAddress</dd>
        </dl>
    </div>
</div>
