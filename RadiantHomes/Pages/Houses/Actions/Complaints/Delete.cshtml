@page
@model RadiantHomes.Pages.Houses.Actions.Complaints.DeleteModel

@{
    ViewData["Title"] = "Delete complaint";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="card mh-confirm">
    <div class="card-header">
        <h2 class="mh-section-title text-reset"><i class="bi bi-exclamation-triangle text-reset" aria-hidden="true"></i> Are you sure you want to delete this complaint?</h2>
    </div>
    <div class="card-body">
        <p class="text-muted">This permanently removes the record below. It can't be undone.</p>
        <dl class="mh-dl">
            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.IssueName)</dt>
            <dd>@Html.DisplayFor(model => model.IssueOrCompliant.IssueName)</dd>
            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.House)</dt>
            <dd>@Model.IssueOrCompliant.House?.Title</dd>
            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.HouseOwner)</dt>
            <dd>@DisplayText.PersonName(Model.IssueOrCompliant.HouseOwner)</dd>
            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.IssueCategory)</dt>
            <dd>@Html.DisplayFor(model => model.IssueOrCompliant.IssueCategory)</dd>
            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.DetailedDescription)</dt>
            <dd>@Html.DisplayFor(model => model.IssueOrCompliant.DetailedDescription)</dd>
            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.SeverityLevel)</dt>
            <dd>@Html.DisplayFor(model => model.IssueOrCompliant.SeverityLevel)</dd>
            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.SupportingEvidenceUrl)</dt>
            <dd>@Html.DisplayFor(model => model.IssueOrCompliant.SupportingEvidenceUrl)</dd>
            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.SupportingEvidence2Url)</dt>
            <dd>@Html.DisplayFor(model => model.IssueOrCompliant.SupportingEvidence2Url)</dd>
            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.ComplainantFullName)</dt>
            <dd>@Html.DisplayFor(model => model.IssueOrCompliant.ComplainantFullName)</dd>
            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.HowDoWeReachYou)</dt>
            <dd>@Html.DisplayFor(model => model.IssueOrCompliant.HowDoWeReachYou)</dd>
            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.PhoneOrEmail)</dt>
            <dd>@Html.DisplayFor(model => model.IssueOrCompliant.PhoneOrEmail)</dd>
            <dt>@Html.DisplayNameFor(model => model.IssueOrCompliant.ComplainantAddress)</dt>
            <dd>@Html.DisplayFor(model => model.IssueOrCompliant.ComplainantAddress)</dd>
        </dl>

        <form method="post" class="mh-form-actions">
            <input type="hidden" asp-for="IssueOrCompliant.IssueId" />
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash" aria-hidden="true"></i> Delete complaint</button>
        </form>
    </div>
</div>
