@page
@model RadiantHomes.Pages.HouseOwner.IndexModel
@{
    ViewData["Title"] = "House Owners";
}

<h2 class="mt-3">House Owners</h2>
<a asp-page="Create" class="btn btn-primary mb-3">Register New House Owner</a>

<table class="table table-bordered table-responsive-md table-striped">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Customers)
        {
            <tr>
                <td>@item.FirstName @item.LastName</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Email</td>
                <td><span class="badge bg-secondary">@item.ProfileStatus</span></td>
                <td>
                    <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                    <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

