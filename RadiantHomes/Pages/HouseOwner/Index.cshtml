@page
@model RadiantHomes.Pages.HouseOwner.IndexModel
@{
    ViewData["Title"] = "House owners";
    var hasRows = Model.Customers is not null && Model.Customers.Any();
}

@section PageActions {
    <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Register New House Owner</a>
}

<div class="card">
    @if (!hasRows)
    {
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-people"></i></span>
            <h2>No house owners yet</h2>
            <p>House owners appear here once they register.</p>
            <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Register New House Owner</a>
        </div>
    }
    else
    {
        <div class="table-responsive position-relative">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Phone</th>
                        <th scope="col">Email</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Customers!)
                    {
                        var statusChip = (item.ProfileStatus ?? string.Empty).ToLowerInvariant() switch
                        {
                            "approved" => "mh-chip mh-chip--success",
                            "rejected" => "mh-chip mh-chip--danger",
                            "pending" => "mh-chip mh-chip--accent",
                            _ => "mh-chip"
                        };
                        <tr>
                            <td class="fw-semibold">@item.FirstName @item.LastName</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.Email</td>
                            <td><span class="@statusChip">@item.ProfileStatus</span></td>
                            <td class="text-end">
                                <div class="mh-row-actions">
                                    @* There are no HouseOwner Edit/Delete pages; details is the only row action. *@
                                    <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary btn-icon" title="View details" aria-label="View details of @item.FirstName @item.LastName"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
