@page
@model RadiantHomes.Pages.HouseOwner.DetailsModel

@{
    ViewData["Title"] = "House owner details";
    ViewData["PageWidth"] = "narrow";
}

@section PageActions {
    <a asp-page="./Index" class="btn btn-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to List</a>
}

<div class="card mb-4">
    <div class="card-header">
        <h2 class="mh-section-title"><i class="bi bi-person-fill" aria-hidden="true"></i> Personal Information</h2>
    </div>
    <div class="card-body">
        <div class="row g-4 align-items-start">
            <div class="col-md-8 order-2 order-md-1">
                <dl class="mh-dl">
                    <dt>Full Name</dt>
                    <dd>@Model.Customer.FirstName @Model.Customer.LastName</dd>
                    <dt>Phone Number</dt>
                    <dd>@Model.Customer.PhoneNumber</dd>
                    <dt>Email</dt>
                    <dd>@Model.Customer.Email</dd>
                    <dt>Category</dt>
                    <dd>@Model.Customer.CustomerCategory</dd>
                </dl>
            </div>
            <div class="col-md-4 order-1 order-md-2 text-center">
                <img src="@Model.Customer.CustomerPhotoUrl" class="img-fluid rounded-3 shadow-sm" style="max-height: 200px;" alt="Owner Photo"
                     onerror="this.onerror=null;this.src='/images/default-profile.png'" />
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="mh-section-title"><i class="bi bi-info-circle-fill" aria-hidden="true"></i> Other Details</h2>
    </div>
    <div class="card-body">
        <dl class="mh-dl">
            <dt>Document Used</dt>
            <dd>@Model.Customer.DocumentUsed</dd>
            <dt>Profile Status</dt>
            <dd>@Model.Customer.ProfileStatus</dd>
            <dt>Application Date</dt>
            <dd>@Model.Customer.ApplicationDate.ToShortDateString()</dd>
            <dt>Ranking</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Customer.Ranking?.RankName) ? "N/A" : Model.Customer.Ranking.RankName)</dd>
            <dt>Address</dt>
            <dd>
                @{
                    // Street, Woreda, Sub City, City, … — only the parts that are filled in.
                    var address = Model.Customer.Address?.FormattedAddressCompact;
                }
                @(string.IsNullOrWhiteSpace(address) ? "N/A" : address)
            </dd>
            <dt>ID Document</dt>
            <dd>
                @if (string.IsNullOrEmpty(Model.Customer.IdCardFileUrl))
                {
                    <span class="text-muted">Not uploaded</span>
                }
                else
                {
                    <a asp-page="/HouseOwner/IdDocument" asp-route-customerId="@Model.Customer.Id" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm"><i class="bi bi-file-earmark-pdf-fill" aria-hidden="true"></i> View ID Document</a>
                }
            </dd>
        </dl>
    </div>
</div>
