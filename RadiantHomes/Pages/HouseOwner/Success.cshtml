@page
@model RadiantHomes.Pages.HouseOwner.SuccessModel
@{
    ViewData["Title"] = "Registration successful";
    ViewData["PageWidth"] = "narrow";
}

<div class="card">
    <div class="card-body p-4 p-md-5 text-center">
        <span class="mh-empty-icon bg-success-subtle text-success" aria-hidden="true">
            <i class="bi bi-check-lg"></i>
        </span>
        <h2 class="h4 mb-3">Application Successful!</h2>

        <div class="text-start mx-auto" style="max-width: 60ch;">
            @if (string.IsNullOrWhiteSpace(Model.ApplicantName))
            {
                <p>Dear applicant,</p>
            }
            else
            {
                <p>Dear <b>@Model.ApplicantName</b>,</p>
            }

            <p>
                Thank you for your application.<br />
                We have received your Registration to Michu Homes Market and will review it shortly.
            </p>

            <p>You can expect to hear from us within @Model.DaysWait business days regarding the status of your application.</p>

            <p>If you have any questions, please feel free to contact us at @Model.companyEmail.</p>

            <p class="mb-0">For any update regarding your application we will contact you using <b>@Model.companyEmail</b></p>
        </div>

        <div class="mh-form-actions justify-content-center">
            <a asp-page="/index" class="btn btn-primary"><i class="bi bi-house" aria-hidden="true"></i> Back to Home</a>
        </div>
    </div>
</div>
