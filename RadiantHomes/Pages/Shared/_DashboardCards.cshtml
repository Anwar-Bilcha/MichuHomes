@using RadiantHomes.Services.AdminServices
@inject IAdminDashboard AdminDashboard
@* KPI tiles for the Michu admin dashboard (live counts). *@
@{
    var tiles = new[]
    {
        (Label: "Real estate companies", Value: AdminDashboard.GetHousingCompanies().Count, Icon: "bi-building", Accent: false),
        (Label: "Registered profiles", Value: AdminDashboard.GetAllCustomers().Count, Icon: "bi-people", Accent: false),
        (Label: "Apartments listed", Value: AdminDashboard.GetAllApartmentHouses().Count, Icon: "bi-house-door", Accent: false),
        (Label: "Apartment sales", Value: AdminDashboard.ApartmentHouseSaleTransactions(true).Count, Icon: "bi-cash-coin", Accent: true),
    };
}
<div class="row g-3 mb-4">
    @foreach (var tile in tiles)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card mh-stat">
                <div>
                    <p class="mh-stat-label">@tile.Label</p>
                    <p class="mh-stat-value">@tile.Value.ToString("N0")</p>
                </div>
                <span class="mh-stat-icon @(tile.Accent ? "mh-stat-icon--accent" : "")" aria-hidden="true"><i class="bi @tile.Icon"></i></span>
            </div>
        </div>
    }
</div>
