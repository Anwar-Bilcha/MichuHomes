@model string
@*
    Michu Homes logo, rendered inline so the wordmark uses the page's Montserrat web font.
    Usage (always pass a model, otherwise Razor hands this partial the page's own model):
        <partial name="_BrandLogo" model="@("color")" />      full colour logo (light backgrounds)
        <partial name="_BrandLogo" model="@("reversed")" />   white + orange (dark backgrounds)
        <partial name="_BrandLogo" model="@("mark")" />       icon only
    Navy parts use currentColor, so CSS (.mh-logo / .mh-logo--reversed) controls them.
    Source artwork: wwwroot/images/brand/michu-homes-logo.svg
*@
@{
    var variant = string.IsNullOrWhiteSpace(Model) ? "color" : Model;
}
@if (variant == "mark")
{
    <svg class="mh-logo-mark" xmlns="http://www.w3.org/2000/svg" viewBox="-12 -4 635 455" role="img" aria-label="Michu Homes" focusable="false">
        <path d="M105 365 V160 L250 68 V284 L188 327 V207 L166 222 V365 Z" fill="currentColor" />
        <path d="M305 240 V0 L492 115 V252 L431 215 V123 L367 84 V240 Z" fill="currentColor" />
        <path d="M130 365 L435 170 L590 280 V365 L435 258 L260 365 Z" fill="#FF850D" />
        <path d="M435 170 L495 210 L495 270 L435 229 Z" fill="#FF850D" />
        <g fill="currentColor">
            <rect x="385" y="300" width="34" height="34" />
            <rect x="430" y="300" width="34" height="34" />
            <rect x="385" y="344" width="34" height="34" />
            <rect x="430" y="344" width="34" height="34" />
        </g>
        <path d="M0 438 Q260 320 610 438" fill="none" stroke="currentColor" stroke-width="17" stroke-linecap="round" />
    </svg>
}
else
{
    <svg class="mh-logo @(variant == "reversed" ? "mh-logo--reversed" : "")" xmlns="http://www.w3.org/2000/svg" viewBox="48 96 1312 464" role="img" aria-label="Michu Homes" focusable="false">
        <g transform="translate(65 105)">
            <path d="M105 365 V160 L250 68 V284 L188 327 V207 L166 222 V365 Z" fill="currentColor" />
            <path d="M305 240 V0 L492 115 V252 L431 215 V123 L367 84 V240 Z" fill="currentColor" />
            <path d="M130 365 L435 170 L590 280 V365 L435 258 L260 365 Z" fill="#FF850D" />
            <path d="M435 170 L495 210 L495 270 L435 229 Z" fill="#FF850D" />
            <g fill="currentColor">
                <rect x="385" y="300" width="34" height="34" />
                <rect x="430" y="300" width="34" height="34" />
                <rect x="385" y="344" width="34" height="34" />
                <rect x="430" y="344" width="34" height="34" />
            </g>
            <path d="M0 438 Q260 320 610 438" fill="none" stroke="currentColor" stroke-width="17" stroke-linecap="round" />
        </g>
        <path d="M700 190 V535" stroke="currentColor" stroke-width="5" />
        <g font-family="Montserrat, Poppins, Arial, sans-serif">
            <text x="755" y="390" font-size="190" font-weight="750" letter-spacing="-8" fill="currentColor">michu</text>
            <circle cx="1070" cy="173" r="27" fill="#FF850D" />
            <text x="855" y="515" font-size="112" font-weight="400" letter-spacing="8" fill="#FF850D">Homes</text>
        </g>
    </svg>
}
