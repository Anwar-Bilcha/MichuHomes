@inject SignInManager<AppUser> SigninManager
@* Login dialog opened from the "Log in" buttons in both layouts. Standard modal anatomy (see michu-theme.css "Modals");
   sign-in dialogs use a full-width primary button like the Login page. *@
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="loginModalLabel"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Log in</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mh-modal-lead">Welcome back. Log in to manage your homes and listings.</p>

                <form method="post" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@returnUrl">
                    <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                    <div class="mb-3">
                        <label for="LoginModal_Email" class="form-label">Email address</label>
                        <input name="Input.Email" id="LoginModal_Email" type="email" class="form-control" autocomplete="username" required />
                    </div>
                    <div class="mb-3">
                        <label for="LoginModal_Password" class="form-label">Password</label>
                        <input name="Input.Password" id="LoginModal_Password" type="password" class="form-control" autocomplete="current-password" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Log in</button>
                </form>

                <div class="mh-auth-divider">or continue with</div>

                <form asp-area="Identity" asp-page="/Account/ExternalLogin" asp-route-returnUrl="/index" method="post" class="d-grid gap-2">
                    <button type="submit" class="btn btn-outline-secondary" name="provider" value="Google">
                        <i class="fa-brands fa-google" aria-hidden="true"></i> Google
                    </button>
                    <button type="submit" class="btn btn-outline-secondary" name="provider" value="Facebook">
                        <i class="fa-brands fa-facebook-f" aria-hidden="true"></i> Facebook
                    </button>
                </form>
            </div>
            <div class="modal-footer justify-content-center">
                <span class="text-muted small">New to Michu Homes?</span>
                <a class="small fw-semibold" asp-area="Identity" asp-page="/Account/Register">Create an account</a>
            </div>
        </div>
    </div>
</div>
