@inject SignInManager<AppUser> SigninManager
@* Login dialog opened from the "Log in" buttons in both layouts. *@
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 pb-4 pt-0">
                <div class="text-center mb-4">
                    <div class="d-inline-block mb-3" style="width: 180px"><partial name="_BrandLogo" model="@("color")" /></div>
                    <h2 class="modal-title fs-4" id="loginModalLabel">Welcome back</h2>
                    <p class="text-muted mb-0">Log in to manage your homes and listings.</p>
                </div>

                <form method="post" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@returnUrl">
                    <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                    <div class="mb-3">
                        <label for="Input_Email" class="form-label">Email address</label>
                        <input name="Input.Email" id="Input_Email" type="email" class="form-control" autocomplete="username" required />
                    </div>
                    <div class="mb-3">
                        <label for="Input_Password" class="form-label">Password</label>
                        <input name="Input.Password" id="Input_Password" type="password" class="form-control" autocomplete="current-password" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Log in</button>
                </form>

                <div class="mh-auth-divider">or continue with</div>

                <form asp-area="Identity" asp-page="/Account/ExternalLogin" asp-route-returnUrl="/index" method="post" class="d-grid gap-2">
                    <button type="submit" class="btn btn-outline-secondary" name="provider" value="Google">
                        <i class="fa-brands fa-google" aria-hidden="true"></i> Google
                    </button>
                    <button type="submit" class="btn btn-outline-secondary" name="provider" value="Facebook">
                        <i class="fa-brands fa-facebook-f" aria-hidden="true"></i> Facebook
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
