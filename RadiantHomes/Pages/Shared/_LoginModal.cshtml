@inject SignInManager<AppUser> SigninManager
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg rounded">
            <div class="lead modal-title">

                <div class="modal-header d-flex justify-content-between align-items-center bg-secondary">
                    <div class="modal-title text-white fw-bold">
                        Login to
                        <a class="navbar-brand" asp-page="/Index">
                            <i class="fa-solid fa-house-signal"></i> MICHU<sup><span style="color: brown;">HOMES</span></sup>
                        </a>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                
            </div>
            <br />

            <form method="post" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@returnUrl">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="Input_Email" style="font-size:14px">Email Address</label>
                        <input name="Input.Email" id="Input_Email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="Input_Password" style="font-size:14px">Password</label>
                        <input name="Input.Password" id="Input_Password" type="password" class="form-control" required />
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-primary login-links text-center w-50">Login</button>
                    </div>
                    <!-- 🔥 External login section -->
                    <div class="text-center modal-footer my-3">
                        <p class="text-body" style="font-size:14px; font-weight:800"> Or login with</p>
                       @*  @foreach (var provider in (await SigninManager.GetExternalAuthenticationSchemesAsync()))
                        {
                            <button type="submit" class="btn btn-outline-dark align-content-center" name="provider" value="Google">
                                <i class="bi bi-google"></i> Sign in with Google
                            </button>
                        } *@
                        
                    </div>
                </div>
               
            </form>
            
                <form asp-area="Identity" asp-page="/Account/ExternalLogin" asp-route-returnUrl="/index" method="post">
                <div class="modal-body">
                    <div class="login-links text-center">
                        <button type="submit" class="btn btn-outline-dark align-content-center" name="provider" value="Google">
                            <i class="bi bi-google w-50" style="font-size:2rem"></i> Sign in with Google
                        </button>
                    </div>
                    <div class="login-links text-center">
                        <button type="submit" class="btn btn-outline-primary mt-2 justify-content-center" name="provider" value="Facebook">
                            <i class="bi bi-facebook justify-content-center w-50" style="font-size:2rem"></i> Sign in with Facebook
                        </button>
                    </div>
                </div>
                </form>
            

        </div>
    </div>
</div>
