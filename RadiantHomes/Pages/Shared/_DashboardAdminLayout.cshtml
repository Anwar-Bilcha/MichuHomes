@using RadiantHomes.Services.AdminServices; 
@inject IAdminDashboard AdminDashboardService;
<!DOCTYPE html>
<html lang="en">
<head>
    @RenderSection("Styles", required: false)
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Tailwind CDN -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css" asp-append-version="true" /> @* Added asp-append-version *@
    <link rel="stylesheet" href="~/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/swiper-bundle.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/loader.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f7f6;
        }

        .sidebar::-webkit-scrollbar {
            width: 8px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: #e2e8f0;
            border-radius: 10px;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: #94a3b8;
            border-radius: 10px;
        }

            .sidebar::-webkit-scrollbar-thumb:hover {
                background: #64748b;
            }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <!-- Sidebar -->
    <aside class="w-64 bg-gray-800 text-white flex flex-col rounded-r-lg shadow-lg overflow-y-auto sidebar">
        <div class="p-6 border-b border-gray-700">
            <h1 class="text-2xl font-bold text-indigo-400">RadiantHomes Admin</h1>
        </div>
        <nav class="flex-grow p-4">
            <ul>
                <li class="mb-2">
                    <a asp-page="/AdminDashboard" class="flex items-center p-3 text-lg font-medium text-indigo-300 bg-gray-700 rounded-lg hover:bg-gray-600 transition duration-200 ease-in-out">
                        <!-- Dashboard icon -->
                        <svg class="w-6 h-6 mr-3" ...>...</svg>
                        Dashboard
                    </a>
                </li>
                <li class="mb-2">
                    <a asp-page="/Tenants/Index" class="flex items-center p-3 text-lg font-medium text-gray-300 hover:bg-gray-700 rounded-lg transition duration-200 ease-in-out">
                        <!-- Tenants icon -->
                        <svg class="w-6 h-6 mr-3" ...>...</svg>
                      @{ @AdminDashboardService.GetHousingCompanies().Count } RealEstates
                    </a>
                </li>
                <li class="mb-2">
                    <a asp-page="/Properties/Index" class="flex items-center p-3 text-lg font-medium text-gray-300 hover:bg-gray-700 rounded-lg transition duration-200 ease-in-out">
                        <!-- Properties icon -->
                        <svg class="w-6 h-6 mr-3" ...>...</svg>
                        Properties
                    </a>
                </li>
                <li class="mb-2">
                    <a asp-page="/Users/Index" class="flex items-center p-3 text-lg font-medium text-gray-300 hover:bg-gray-700 rounded-lg transition duration-200 ease-in-out">
                        <!-- Users icon -->
                        <svg class="w-6 h-6 mr-3" ...>...</svg>
                        Users
                    </a>
                </li>
                <li class="mb-2">
                    <a asp-page="/Settings" class="flex items-center p-3 text-lg font-medium text-gray-300 hover:bg-gray-700 rounded-lg transition duration-200 ease-in-out">
                        <!-- Settings icon -->
                        <svg class="w-6 h-6 mr-3" ...>...</svg>
                        Settings
                    </a>
                </li>
                <li class="mb-2">
                    <form method="post" asp-page="/Logout">
                        <button type="submit" class="w-full flex items-center p-3 text-lg font-medium text-gray-300 hover:bg-gray-700 rounded-lg transition duration-200 ease-in-out">
                            <!-- Logout icon -->
                            <svg class="w-6 h-6 mr-3" ...>...</svg>
                            Logout
                        </button>
                    </form>
                </li>
            </ul>
        </nav>
        <div class="p-6 border-t border-gray-700 text-sm text-gray-400">
            &copy; 2025 RadiantHomes. All rights reserved.
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Top Bar -->
        <header class="flex justify-between items-center p-6 bg-white border-b border-gray-200 shadow-md rounded-bl-lg">
            <h2 class="text-3xl font-semibold text-gray-800">Report Generator</h2>
            <div class="flex items-center space-x-4">
                <span class="text-gray-600 text-lg">Welcome, Admin!</span>
                <img class="h-10 w-10 rounded-full object-cover border-2 border-indigo-500" src="~/images/default-profile.png" alt="Admin Avatar">
            </div>
        </header>

        <!-- Dashboard Content -->
        <main class="flex-1 overflow-x-hidden overflow-y-auto p-6 bg-gray-50">
            <!-- Your Cards and Dashboard UI go here -->
            @* You can include your dashboard cards and sections here exactly as you wrote above *@
            @* Example: *@
            <partial name="_DashboardCards" />
            @RenderBody()
        </main>
    </div>
    @RenderSection("Scripts", required: false)

</body>
</html>
