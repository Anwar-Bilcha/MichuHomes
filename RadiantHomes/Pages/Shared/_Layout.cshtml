    <style>
        /* Define CSS Variables for consistent branding */
        :root {
            --primary-color: #007bff; /* Bootstrap primary blue */
            --secondary-color: #6c757d; /* Bootstrap secondary gray */
            --brand-color-michu: #f0ad4e; /* Brown for MICHU part */
            --text-color-light: #f8f9fa; /* For text on dark backgrounds */
            --text-color-dark: #343a40; /* For text on light backgrounds */
        }

        body {
            font-family: 'Roboto', sans-serif; /* Fallback fonts */
        }

        /* Navbar Customization */
        .navbar-brand .fa-house-signal {
            color: var(--primary-color);
        }

        .navbar-brand sup span {
            color: var(--brand-color-michu); /* Apply brown color via CSS */
        }

        .navbar-nav .nav-link {
            font-weight: 500;
            color: var(--text-color-dark) !important;
            transition: color 0.3s ease-in-out;
        }

            .navbar-nav .nav-link:hover {
                color: var(--primary-color) !important;
            }

        /* Language Selector Styling */
        .language-selector {
            border-radius: 0.25rem;
            margin-right: 1rem;
            border: 1px solid var(--secondary-color);
            background-color: var(--text-color-light); /* Light background for selector */
            color: var(--text-color-dark);
            padding: 0.375rem 0.75rem; /* Standard Bootstrap input padding */
        }

            .language-selector:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.25);
            }

        /* Footer Styling */
        footer {
            background-color: var(--text-color-light) !important; /* Ensure light background for footer */
            color: var(--text-color-dark) !important; /* Dark text for footer */
        }

            footer .navbar-brand .fa-house-signal {
                color: var(--primary-color);
            }

            footer .navbar-brand sup span {
                color: var(--brand-color-michu);
            }

            footer .text-secondary {
                color: var(--secondary-color) !important;
            }

            footer .list-unstyled a {
                color: var(--text-color-dark) !important;
                transition: color 0.3s ease-in-out;
            }

                footer .list-unstyled a:hover {
                    color: var(--primary-color) !important;
                    text-decoration: underline !important;
                }

            /* Fix for contact info icons in footer */
            footer .list-unstyled .bi {
                color: var(--primary-color) !important; /* Make icons visible */
                font-size: 1.2rem; /* Adjust icon size if needed */
            }

            footer .form-control.bg-dark {
                background-color: var(--text-color-dark) !important; /* Darker background for input */
                border-color: var(--secondary-color) !important;
                color: var(--text-color-light) !important;
            }

            footer .btn-dark {
                background-color: var(--primary-color) !important;
                border-color: var(--primary-color) !important;
                color: var(--text-color-light) !important;
            }

                footer .btn-dark:hover {
                    opacity: 0.9;
                }

        /* Loader Styling (moved from inline) */
        #pageLoader {
            display: none; /* Controlled by JS */
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.7); /* Slightly more opaque */
            z-index: 9999;
            display: flex; /* Use flexbox for centering */
            align-items: center;
            justify-content: center;
        }

        /* Optional: Add a class for scrolled body */
        body.scrolled .navbar {
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        /* Hover underline for quick links */
        .hover-underline:hover {
            text-decoration: underline !important;
        }

        /* Responsive adjustments for overall layout */
        @@media (max-width: 991.98px) { /* Bootstrap's lg breakpoint */
            .navbar-collapse

        {
            background-color: white; /* Ensure menu is readable on small screens */
            border-top: 1px solid #eee;
            padding: 1rem;
        }

        .navbar-nav {
            margin-bottom: 1rem;
        }

        .language-selector {
            margin-right: 0;
            margin-bottom: 1rem;
        }

        .d-flex.align-items-center {
            flex-direction: column;
            align-items: flex-start !important; /* Align items to start for better stacking */
        }

            .d-flex.align-items-center > * {
                width: 100%; /* Make login button and selector full width */
                margin-bottom: 0.5rem;
            }

        }
    </style>

