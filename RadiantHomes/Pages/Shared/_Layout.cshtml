@using RadiantHomes.Utilities
@*
    Public layout (visitors, buyers, house owners).
    Page contract: see Pages/Shared/_PageHeader.cshtml.
*@
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? string.Empty;
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    ViewData["MhTitle"] = PageChrome.ResolveTitle(ViewData["Title"] as string, currentPage, area);

    var showHeader = (ViewData["PageHeader"] as bool?) ?? true;
    var width = (ViewData["PageWidth"] as string ?? string.Empty).ToLowerInvariant();
    var bodyContainer = width switch
    {
        "full" => null,
        "narrow" => "container mh-container-narrow",
        _ => "container"
    };
    var headerContainer = width == "narrow" ? "container mh-container-narrow" : "container";

    // Highlights the nav item for the current section (e.g. /ApartmentHouses/Details → Apartments)
    string Active(string section) =>
        area.Length == 0 && (section == "/Index"
            ? currentPage.Equals("/Index", StringComparison.OrdinalIgnoreCase)
            : currentPage.StartsWith(section + "/", StringComparison.OrdinalIgnoreCase))
            ? "active-link" : string.Empty;
}
<!DOCTYPE html>
<html lang="@System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName">
<head>
    <partial name="_HeadAssets" />
    @RenderSection("Styles", required: false)
</head>
<body class="mh-public">
    <a class="visually-hidden-focusable position-absolute top-0 start-0 m-2 btn btn-primary btn-sm" style="z-index:2100" href="#main-content">Skip to content</a>

    <div id="pageLoader" class="mh-loader" aria-hidden="true">
        <div class="dot-loader"><div></div><div></div><div></div></div>
    </div>

    <nav class="navbar navbar-expand-lg fixed-top mh-navbar" aria-label="Main navigation">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-page="/Index" aria-label="Michu Homes — home">
                <partial name="_BrandLogo" model="@("color")" />
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto mb-0 align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link @Active("/Index")" asp-area="" asp-page="/Index" data-translate="homePage">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("/HouseOwner")" asp-area="" asp-page="/HouseOwner/Create" data-translate="registerPage">Create Account</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("/ApartmentHouses")" asp-area="" asp-page="/ApartmentHouses/Index" data-translate="apartmentsPage">Apartments</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("/RealEstates")" asp-area="" asp-page="/RealEstates/Index" data-translate="realEstatePage">Real Estates</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("/Projects")" asp-area="" asp-page="/Projects/Index" data-translate="ProjectsPage">Projects</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center ms-lg-3 gap-2 mh-nav-tools">
                    <select class="form-select form-select-sm language-selector" onchange="loadLanguage(this.value)" aria-label="Language">
                        <option value="en">English</option>
                        <option value="am">አማርኛ</option>
                        <option value="or">Afaan Oromoo</option>
                        <option value="tg">ትግርኛ</option>
                    </select>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <partial name="_LoginPartial" />
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#loginModal">
                            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Log in
                        </button>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main id="main-content" role="main">
        @if (showHeader)
        {
            <header class="mh-page-header">
                <div class="@headerContainer mh-page-header__inner">
                    <partial name="_PageHeader" />
                    @if (IsSectionDefined("PageActions"))
                    {
                        <div class="mh-page-actions">@RenderSection("PageActions")</div>
                    }
                </div>
            </header>
        }
        else if (IsSectionDefined("PageActions"))
        {
            IgnoreSection("PageActions");
        }

        @if (bodyContainer is null)
        {
            @RenderBody()
        }
        else
        {
            <div class="@bodyContainer mh-page-body @(showHeader ? "" : "pt-4")">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="mh-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6">
                    <a asp-area="" asp-page="/Index" class="d-inline-block mb-3" aria-label="Michu Homes — home">
                        <partial name="_BrandLogo" model="@("reversed")" />
                    </a>
                    <p class="mb-0" style="max-width: 34ch">A trusted Ethiopian housing platform where your next home awaits.</p>
                    <div class="mh-footer-social">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook" aria-hidden="true"></i></a>
                        <a href="#" aria-label="X (Twitter)"><i class="bi bi-twitter-x" aria-hidden="true"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram" aria-hidden="true"></i></a>
                        <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin" aria-hidden="true"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h2>Explore</h2>
                    <ul>
                        <li><a asp-area="" asp-page="/Index">Home</a></li>
                        <li><a asp-area="" asp-page="/ApartmentHouses/Index">Apartments</a></li>
                        <li><a asp-area="" asp-page="/RealEstates/Index">Real estates</a></li>
                        <li><a asp-area="" asp-page="/Projects/Index">Projects</a></li>
                        <li><a asp-area="" asp-page="/Privacy">Privacy</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h2>Contact</h2>
                    <ul>
                        <li><i class="bi bi-telephone" aria-hidden="true"></i>+251-900-000-000</li>
                        <li><i class="bi bi-envelope" aria-hidden="true"></i><a href="mailto:info@michuhomes.et">info@michuhomes.et</a></li>
                        <li><i class="bi bi-geo-alt" aria-hidden="true"></i>Bole, Addis Ababa</li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h2>Stay updated</h2>
                    <form asp-page-handler="SubscribeUser" method="post" data-no-loader>
                        <label for="footerSubscribeEmail" class="visually-hidden">Email address</label>
                        <div class="input-group">
                            <input id="footerSubscribeEmail" type="email" name="Email" class="form-control" placeholder="Your email address" required />
                            <button type="submit" class="btn btn-accent">Subscribe</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mh-footer-bottom">
                <span>&copy; @DateTime.Now.Year Michu Homes. All rights reserved.</span>
                <a asp-area="" asp-page="/Privacy">Privacy policy</a>
            </div>
        </div>
    </footer>

    <partial name="_CoreScripts" />

    @* Tawk.to live chat *@
    <script>
        var Tawk_API = Tawk_API || {}, Tawk_LoadStart = new Date();
        (function () {
            var s1 = document.createElement("script"), s0 = document.getElementsByTagName("script")[0];
            s1.async = true;
            s1.src = 'https://embed.tawk.to/67f2f12ee46ec81909b862f4/1io6fs85n';
            s1.charset = 'UTF-8';
            s1.setAttribute('crossorigin', '*');
            s0.parentNode.insertBefore(s1, s0);
        })();
    </script>

    @RenderSection("Scripts", required: false)
    <partial name="_LoginModal" />
</body>
</html>
