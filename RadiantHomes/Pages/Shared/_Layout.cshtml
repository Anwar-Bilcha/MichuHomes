    <script type="text/javascript">
        function loadLanguage(language) {
            localStorage.setItem('selectedLanguage', language);
            fetch(`/locales/${language}.json`)
                .then(response => {
                    if (!response.ok) {
                        // Fallback to English if specified language file not found
                        console.warn(`Language file for '${language}' not found, falling back to English.`);
                        return fetch(`/locales/en.json`);
                    }
                    return response.json();
                })
                .then(data => {
                    for (const key in data) {
                        if (data.hasOwnProperty(key)) {
                            const elements = document.querySelectorAll(`[data-translate="${key}"]`);
                            elements.forEach(element => {
                                element.innerText = data[key];
                            });
                        }
                    }
                })
                .catch(error => console.error("Error loading language file:", error));
        }

        document.addEventListener('DOMContentLoaded', function () {
            let userLang = localStorage.getItem('selectedLanguage') || navigator.language.slice(0, 2);
            // Ensure the language selector defaults to the actual current culture of the application if possible
            // or to the user's preferred language.
            const currentCulture = "@System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName";
            const selector = document.querySelector('.language-selector');

            if (selector) {
                // If there's a stored language, use it. Otherwise, use the server's current culture.
                selector.value = localStorage.getItem('selectedLanguage') || currentCulture;
                loadLanguage(selector.value); // Load initial language based on selector value
            } else {
                 loadLanguage(userLang); // If no selector, just load based on userLang
            }
        });
    </script>

