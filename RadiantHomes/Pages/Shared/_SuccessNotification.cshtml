@model string

@if (!string.IsNullOrWhiteSpace(Model))
{
    @* SweetAlert2 is loaded by the layout (_CoreScripts); this runs after DOMContentLoaded. *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: 'success',
                title: @Html.Raw(Json.Serialize(Model)),
                showConfirmButton: false,
                timer: 10000,
                timerProgressBar: true,
                willClose: () => {
                    window.location.href = '@Url.Page("./Index")';
                }
            });
        });
    </script>
}
