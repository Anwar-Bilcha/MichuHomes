    <div class="sidebar-overlay d-lg-none"></div>

    <main class="main-content col-lg-9 col-12 flex-grow-1">
        @if (User.Identity.IsAuthenticated)
        {
            var currentUser = await userManager.GetUserAsync(User);
            var currentUserId = currentUser?.CustomerId;
            Customer? customerProfile = null;
            if (currentUserId != null && currentUserId != Guid.Empty) // Ensure it's not null or empty GUID
            {
                customerProfile = _context.UserProfiles.FirstOrDefault(u => u.Id == currentUserId);
            }
            var notifications = new List<RadiantHomes.Models.Notification>();

            // Only try to get notifications if customerProfile is found
            if (customerProfile?.CompanyId != null)
            {
                notifications = (await NotificationService.GetAllNotifications(customerProfile.CompanyId.Value)).ToList();
            }


            var userName = "Dear User";
            var userEmail = User.Identity?.Name;

            if (customerProfile != null)
            {
                userName = $"{customerProfile.FirstName} {customerProfile.LastName}";
            }
            else if (!string.IsNullOrEmpty(userEmail))
            {
                // Fallback if profile not found but user is authenticated
                userName = userEmail;
            }

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <p class="mb-0 fs-5 text-dark">Welcome, <span class="fw-semibold">@userName</span></p>
                </div>
                <div class="dropdown">
                    <a class="btn btn-light position-relative dropdown-toggle" href="#" id="notificationsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-bell fs-4"></i>
                        @if (notifications.Any(n => !n.IsRead))
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                @notifications.Count(n => !n.IsRead)
                                <span class="visually-hidden">unread notifications</span>
                            </span>
                        }
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="notificationsDropdown" style="width: 300px; max-height: 400px; overflow-y: auto;">
                        @if (!notifications.Any())
                        {
                            <li><span class="dropdown-item text-muted">No new notifications</span></li>
                        }
                        else
                        {
                            @foreach (var note in notifications.OrderByDescending(n => n.CreatedAt).Take(10))
                            {
                                <li class="notification-item @(!note.IsRead ? "unread" : "")">
                                    <a class="dropdown-item" href="@note.RedirectUrl">
                                        <strong class="d-block text-truncate">@note.Title</strong>
                                        <small class="text-muted d-block text-truncate">@note.Message</small>
                                        <small class="text-muted d-block text-end fst-italic">@note.CreatedAt.ToShortDateString()</small>
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item text-center fw-bold" asp-page="/Admin/Notifications/NotificationsAll">View All Notifications</a></li>
                        }
                    </ul>
                </div>
            </div>
        }

        @RenderBody()

        @if (User.IsInRole(MichuHomesRoles.MichuAdmin))
        {
            <div class="modal fade" id="createAdminModal" tabindex="-1" aria-labelledby="createAdminModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content shadow">
                        <div class="modal-header">
                            <h5 class="modal-title" id="createAdminModalLabel">Create Real Estate Admin Profile</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form>
                                <p class="text-muted">Select a housing company to pre-create a profile.</p>
                                @{
                                    var companies = _context.HousingCompanies.ToList();
                                }
                                <div class="mb-3">
                                    <label for="companySelectAdminLayout" class="form-label fw-semibold">Housing Company</label>
                                    <select id="companySelectAdminLayout" class="form-select">
                                        <option value="">-- Select a Company --</option>
