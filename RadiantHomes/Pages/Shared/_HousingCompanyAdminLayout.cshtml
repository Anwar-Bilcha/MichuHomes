@using Microsoft.AspNetCore.Identity
@using RadiantHomes.DAL
@using RadiantHomes.Models
@using RadiantHomes.Models.HousingCompanies
@using RadiantHomes.Services.NotificationService
@using RadiantHomes.Utilities
@inject INotificationService NotificationService
@inject UserManager<AppUser> userManager
@inject ApplicationDbContext _context
@*
    Admin layout (Michu admins and real-estate company admins): sidebar + top bar + page header.
    Page contract: see Pages/Shared/_PageHeader.cshtml.
*@
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? string.Empty;
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    ViewData["MhTitle"] = PageChrome.ResolveTitle(ViewData["Title"] as string, currentPage, area);

    var showHeader = (ViewData["PageHeader"] as bool?) ?? true;
    var width = (ViewData["PageWidth"] as string ?? string.Empty).ToLowerInvariant();
    var isMichuAdmin = User.IsInRole(MichuHomesRoles.MichuAdmin);

    // Sidebar highlighting: "section" items match every page in the folder except Create,
    // "exact" items match one page.
    string Section(string folder) =>
        currentPage.StartsWith(folder + "/", StringComparison.OrdinalIgnoreCase)
        && !currentPage.EndsWith("/Create", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    string Exact(string page) =>
        currentPage.Equals(page, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    string Current(string cssClass) => cssClass == "active" ? "page" : "false";

    // Signed-in user + notifications (same data as before the redesign)
    var userName = "Dear User";
    var notifications = new List<RadiantHomes.Models.Notification>();
    if (User.Identity?.IsAuthenticated == true)
    {
        var currentUser = await userManager.GetUserAsync(User);
        var currentCustomerId = currentUser?.CustomerId;
        Customer? customerProfile = null;
        if (currentCustomerId != null && currentCustomerId != Guid.Empty)
        {
            customerProfile = _context.UserProfiles.FirstOrDefault(u => u.Id == currentCustomerId);
        }

        if (customerProfile?.CompanyId != null)
        {
            notifications = (await NotificationService.GetAllNotifications(customerProfile.CompanyId.Value)).ToList();
        }

        if (customerProfile != null)
        {
            userName = $"{customerProfile.FirstName} {customerProfile.LastName}";
        }
        else if (!string.IsNullOrEmpty(User.Identity?.Name))
        {
            userName = User.Identity.Name;
        }
    }
    var unreadCount = notifications.Count(n => !n.IsRead);
}
<!DOCTYPE html>
<html lang="@System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName">
<head>
    <partial name="_HeadAssets" />
    @RenderSection("Styles", required: false)
</head>
<body class="mh-admin-body">
    <a class="visually-hidden-focusable position-absolute top-0 start-0 m-2 btn btn-primary btn-sm" style="z-index:2100" href="#main-content">Skip to content</a>

    <div id="pageLoader" class="mh-loader" aria-hidden="true">
        <div class="dot-loader"><div></div><div></div><div></div></div>
    </div>

    <div class="mh-admin">
        <aside class="mh-sidebar-wrap">
            <div class="offcanvas-lg offcanvas-start mh-sidebar" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
                <div class="offcanvas-header d-lg-none">
                    <span id="adminSidebarLabel" class="visually-hidden">Admin navigation</span>
                    <partial name="_BrandLogo" model="@("reversed")" />
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Close navigation"></button>
                </div>

                <div class="offcanvas-body">
                    <a class="mh-sidebar-brand d-none d-lg-block" asp-area="" asp-page="/Index" aria-label="Michu Homes — home">
                        <partial name="_BrandLogo" model="@("reversed")" />
                    </a>

                    <nav class="mh-sidenav" aria-label="Admin">
                        @if (isMichuAdmin)
                        {
                            <div class="mh-sidenav-label">Overview</div>
                            <ul>
                                <li><a class="nav-link @Exact("/Admin/Dashboard/AdminDashboard")" aria-current="@Current(Exact("/Admin/Dashboard/AdminDashboard"))" asp-area="" asp-page="/Admin/Dashboard/AdminDashboard"><i class="bi bi-speedometer2" aria-hidden="true"></i>Dashboard</a></li>
                                <li><a class="nav-link @Exact("/Admin/Reports/AdminReports")" aria-current="@Current(Exact("/Admin/Reports/AdminReports"))" asp-area="" asp-page="/Admin/Reports/AdminReports"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i>Reports</a></li>
                            </ul>
                        }

                        <div class="mh-sidenav-label">Company</div>
                        <ul>
                            <li><a class="nav-link @Exact("/RealEstates/OnBoarding/CompanyProfile")" aria-current="@Current(Exact("/RealEstates/OnBoarding/CompanyProfile"))" asp-area="" asp-page="/RealEstates/OnBoarding/CompanyProfile"><i class="bi bi-building" aria-hidden="true"></i>Company profile</a></li>
                            <li><a class="nav-link @Exact("/Admin/Notifications/NotificationsAll")" aria-current="@Current(Exact("/Admin/Notifications/NotificationsAll"))" asp-area="" asp-page="/Admin/Notifications/NotificationsAll"><i class="bi bi-bell" aria-hidden="true"></i>Approve notifications @if (unreadCount > 0) { <span class="badge bg-warning ms-auto">@unreadCount</span> }</a></li>
                        </ul>

                        <div class="mh-sidenav-label">Projects</div>
                        <ul>
                            <li><a class="nav-link @Section("/Projects")" aria-current="@Current(Section("/Projects"))" asp-page="/Projects/Index"><i class="bi bi-kanban" aria-hidden="true"></i>All projects</a></li>
                            <li><a class="nav-link @Exact("/Projects/Create")" aria-current="@Current(Exact("/Projects/Create"))" asp-page="/Projects/Create"><i class="bi bi-plus-square" aria-hidden="true"></i>New project</a></li>
                        </ul>

                        <div class="mh-sidenav-label">Buildings</div>
                        <ul>
                            <li><a class="nav-link @Section("/Buildings")" aria-current="@Current(Section("/Buildings"))" asp-page="/Buildings/Index"><i class="bi bi-buildings" aria-hidden="true"></i>All buildings</a></li>
                            <li><a class="nav-link @Exact("/Buildings/Create")" aria-current="@Current(Exact("/Buildings/Create"))" asp-page="/Buildings/Create"><i class="bi bi-plus-square" aria-hidden="true"></i>New building</a></li>
                        </ul>

                        <div class="mh-sidenav-label">Apartments</div>
                        <ul>
                            <li><a class="nav-link @Section("/ApartmentHouses")" aria-current="@Current(Section("/ApartmentHouses"))" asp-page="/ApartmentHouses/Index"><i class="bi bi-house-door" aria-hidden="true"></i>All apartments</a></li>
                            <li><a class="nav-link @Exact("/ApartmentHouses/Create")" aria-current="@Current(Exact("/ApartmentHouses/Create"))" asp-page="/ApartmentHouses/Create"><i class="bi bi-plus-square" aria-hidden="true"></i>New apartment</a></li>
                        </ul>

                        <div class="mh-sidenav-label">Testimonials</div>
                        <ul>
                            <li><a class="nav-link @Section("/RealEstates/Testimonials")" aria-current="@Current(Section("/RealEstates/Testimonials"))" asp-area="" asp-page="/RealEstates/Testimonials/Index"><i class="bi bi-chat-quote" aria-hidden="true"></i>All testimonials</a></li>
                            <li><a class="nav-link @Exact("/RealEstates/Testimonials/Create")" aria-current="@Current(Exact("/RealEstates/Testimonials/Create"))" asp-area="" asp-page="/RealEstates/Testimonials/Create"><i class="bi bi-plus-square" aria-hidden="true"></i>New testimonial</a></li>
                        </ul>
                    </nav>

                    <div class="mh-sidebar-footer">
                        @if (isMichuAdmin)
                        {
                            <button type="button" class="btn btn-accent btn-sm mb-3" data-bs-toggle="modal" data-bs-target="#createAdminModal">
                                <i class="bi bi-person-plus" aria-hidden="true"></i> Create admin
                            </button>
                        }
                        <div>&copy; @DateTime.Now.Year Michu Homes</div>
                    </div>
                </div>
            </div>
        </aside>

        <div class="mh-admin-main">
            <header class="mh-topbar">
                <button class="mh-icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Open navigation">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
                <a class="d-lg-none" asp-area="" asp-page="/Index" aria-label="Michu Homes — home">
                    <partial name="_BrandLogo" model="@("mark")" />
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <p class="mh-topbar-title d-none d-md-block text-truncate">Welcome back, <strong>@userName</strong></p>
                }

                <div class="mh-topbar-tools">
                    <a class="btn btn-outline-secondary btn-sm d-none d-md-inline-flex" asp-area="" asp-page="/Index">
                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> View site
                    </a>

                    <select class="form-select form-select-sm language-selector d-none d-sm-block" onchange="loadLanguage(this.value)" aria-label="Language">
                        <option value="en">English</option>
                        <option value="am">አማርኛ</option>
                        <option value="or">Afaan Oromoo</option>
                        <option value="tg">ትግርኛ</option>
                    </select>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="mh-icon-btn" type="button" id="notificationsDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications@(unreadCount > 0 ? $", {unreadCount} unread" : "")">
                                <i class="bi bi-bell" aria-hidden="true"></i>
                                @if (unreadCount > 0)
                                {
                                    <span class="badge rounded-pill" aria-hidden="true">@unreadCount</span>
                                }
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end mh-notifications" aria-labelledby="notificationsDropdown">
                                <li><h2 class="dropdown-header">Notifications</h2></li>
                                @if (!notifications.Any())
                                {
                                    <li><span class="dropdown-item-text text-muted">No new notifications</span></li>
                                }
                                else
                                {
                                    @foreach (var note in notifications.OrderByDescending(n => n.CreatedAt).Take(10))
                                    {
                                        <li class="notification-item @(!note.IsRead ? "unread" : "")">
                                            <a class="dropdown-item" href="@note.RedirectUrl">
                                                <strong class="d-block text-truncate">@note.Title</strong>
                                                <small class="text-muted d-block text-truncate">@note.Message</small>
                                                <small class="text-muted d-block text-end">@note.CreatedAt.ToShortDateString()</small>
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item text-center fw-semibold" asp-area="" asp-page="/Admin/Notifications/NotificationsAll">View all notifications</a></li>
                                }
                            </ul>
                        </div>

                        <partial name="_LoginPartial" />
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#loginModal">
                            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Log in
                        </button>
                    }
                </div>
            </header>

            <main id="main-content" class="mh-admin-content" role="main">
                @if (showHeader)
                {
                    <header class="mh-page-header">
                        <div class="mh-page-header__inner">
                            <partial name="_PageHeader" />
                            @if (IsSectionDefined("PageActions"))
                            {
                                <div class="mh-page-actions">@RenderSection("PageActions")</div>
                            }
                        </div>
                    </header>
                }
                else if (IsSectionDefined("PageActions"))
                {
                    IgnoreSection("PageActions");
                }

                @if (width == "full")
                {
                    @RenderBody()
                }
                else
                {
                    <div class="mh-page-body @(width == "narrow" ? "mh-container-narrow" : "")">
                        @RenderBody()
                    </div>
                }
            </main>

            <footer class="mh-admin-footer">
                <span>&copy; @DateTime.Now.Year Michu Homes. All rights reserved.</span>
                <span><a asp-area="" asp-page="/Privacy">Privacy</a> · <a href="mailto:info@michuhomes.et">info@michuhomes.et</a></span>
            </footer>
        </div>
    </div>

    @if (isMichuAdmin)
    {
        var companies = _context.HousingCompanies.ToList();
        var curUser = await userManager.GetUserAsync(User);
        <div class="modal fade" id="createAdminModal" tabindex="-1" aria-labelledby="createAdminModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header mh-modal-header--brand">
                        <h2 class="modal-title fs-5" id="createAdminModalLabel">Create real estate admin profile</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form>
                            <p class="text-muted">Select a housing company to pre-create a profile.</p>
                            <div class="mb-3">
                                <label for="companySelectAdminLayout" class="form-label">Housing company</label>
                                <select id="companySelectAdminLayout" class="form-select">
                                    <option value="">-- Select a company --</option>
                                    @foreach (var company in companies)
                                    {
                                        <option value="@company.CompanyId">@company.Name</option>
                                    }
                                </select>
                            </div>
                            <button id="createContactPersonBtnAdminLayout" type="button" class="btn btn-primary w-100">
                                <i class="bi bi-person-plus" aria-hidden="true"></i> Proceed to create profile
                            </button>
                            <input type="hidden" id="UserId" value="@curUser?.Id" />
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    <partial name="_CoreScripts" />
    @RenderSection("Scripts", required: false)
    <partial name="_LoginModal" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Michu admin: pre-create a real estate admin profile for the selected company
            const proceedButton = document.getElementById('createContactPersonBtnAdminLayout');
            const companySelect = document.getElementById('companySelectAdminLayout');
            if (proceedButton && companySelect) {
                proceedButton.addEventListener('click', function () {
                    const companyId = companySelect.value;
                    if (!companyId) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Selection required',
                            text: 'Please select a housing company to proceed.',
                            confirmButtonText: 'OK',
                            customClass: { confirmButton: 'btn btn-primary' },
                            buttonsStyling: false
                        });
                        return;
                    }
                    const userId = document.getElementById('UserId').value;
                    window.location.href = `/HouseOwner/Create?ProposedContactPersonId=${userId}&TargetCompanyId=${companyId}`;
                });
            }
        });
    </script>
</body>
</html>
