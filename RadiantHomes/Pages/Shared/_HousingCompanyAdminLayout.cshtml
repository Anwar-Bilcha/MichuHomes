    @RenderSection("Scripts", required: false)
    @await Html.PartialAsync("_LoginModal")

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Sidebar collapse arrow rotation
            var collapses = document.querySelectorAll('.sidebar [data-bs-toggle="collapse"]');

            collapses.forEach(function (toggle) {
                var arrowIcon = toggle.querySelector('.toggle-arrow');
                var targetId = toggle.getAttribute('href') || toggle.getAttribute('data-bs-target');
                var collapseTarget = document.querySelector(targetId);

                if (collapseTarget) {
                    // Initial state check for 'show' class
                    if (collapseTarget.classList.contains('show')) {
                        if (arrowIcon) {
                            arrowIcon.classList.remove('bi-chevron-right');
                            arrowIcon.classList.add('bi-chevron-down');
                            arrowIcon.style.transform = 'rotate(90deg)'; // Ensure initial rotation
                        }
                    }

                    collapseTarget.addEventListener('show.bs.collapse', function () {
                        if (arrowIcon) {
                            arrowIcon.classList.remove('bi-chevron-right');
                            arrowIcon.classList.add('bi-chevron-down');
                            arrowIcon.style.transform = 'rotate(90deg)';
                        }
                    });

                    collapseTarget.addEventListener('hide.bs.collapse', function () {
                        if (arrowIcon) {
                            arrowIcon.classList.remove('bi-chevron-down');
                            arrowIcon.classList.add('bi-chevron-right');
                            arrowIcon.style.transform = 'rotate(0deg)';
                        }
                    });
                }
            });

            // Toggle sidebar for small screens
            const sidebar = document.querySelector('.sidebar');
            const sidebarToggle = document.querySelector('.sidebar-header .btn-outline-secondary');
            const sidebarNav = document.getElementById('sidebarNav');
            const sidebarOverlay = document.querySelector('.sidebar-overlay');

            if (sidebarToggle && sidebarNav && sidebarOverlay) {
                sidebarNav.addEventListener('show.bs.collapse', function () {
                    sidebar.classList.add('show');
                    sidebarOverlay.style.display = 'block';
                });

                sidebarNav.addEventListener('hide.bs.collapse', function () {
                    sidebar.classList.remove('show');
                    sidebarOverlay.style.display = 'none';
                });

                sidebarOverlay.addEventListener('click', function () {
                    if (sidebarNav.classList.contains('show')) {
                        new bootstrap.Collapse(sidebarNav).hide();
                    }
                });
            }


            // Dinar Admin Company Selection Logic
            const createContactPersonBtnAdminLayout = document.getElementById('createContactPersonBtnAdminLayout');
            const companySelectAdminLayout = document.getElementById('companySelectAdminLayout');

            if (createContactPersonBtnAdminLayout && companySelectAdminLayout) {
                createContactPersonBtnAdminLayout.addEventListener('click', function () {
                    const companyId = companySelectAdminLayout.value;

                    if (!companyId) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Selection Required',
                            text: 'Please select a housing company to proceed.',
                            confirmButtonText: 'OK',
                            customClass: {
                                confirmButton: 'btn btn-primary'
                            },
                            buttonsStyling: false
                        });
                        return;
                    }

                    const UserId = document.getElementById('UserId').value;
                    const redirectUrl = `/HouseOwner/Create?ProposedContactPersonId=${UserId}&TargetCompanyId=${companyId}`;
                    window.location.href = redirectUrl;
                });
            }
        });
    </script>
    </body>
