@using Microsoft.AspNetCore.Identity
@using RadiantHomes.DAL
@using RadiantHomes.Models
@using RadiantHomes.Models.HousingCompanies
@using RadiantHomes.Services.NotificationService
@inject INotificationService NotificationService
@inject UserManager<AppUser> userManager
@inject ApplicationDbContext _context
@using System.Linq
@using System.Security.Claims

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RadiantHomes Admin</title>
    <link rel="manifest" href="~/manifest.json">
    <meta name="theme-color" content="#1e3a8a">

    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/all.min.css" /> 
    <link rel="stylesheet" href="~/css/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/css/loader.css" /> 
    <link rel="stylesheet" href="~/css/site.css" /> 

    <style>
        :root {
            --primary-color-dark: #1e3a8a; /* Example, adjust to your brand */
            --secondary-color-light: #f7fafc; /* Example, adjust to your brand */
            --sidebar-bg: #e9ecef; /* Light grey for sidebar */
            --text-dark: #343a40; /* Dark text color */
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            /* Consider removing or carefully managing overflow-x: hidden; */
            /* If elements are genuinely overflowing, it's better to fix the layout rather than hiding */
            /* overflow-x: hidden; */
        }

        .main-wrapper {
            flex: 1; /* Allows main content to grow and push footer down */
        }

        /* Navbar Customization */
        .navbar-brand .fa-house-signal {
            color: var(--secondary-color-light);
        }

        .navbar-brand span {
            color: white;
        }

        .navbar-brand sup span {
            color: var(--secondary-color-light); /* Or a brand accent color */
        }

        .nav-link-custom {
            color: rgba(255, 255, 255, 0.75); /* Lighter white for non-active */
            transition: color 0.3s ease-in-out;
        }

            .nav-link-custom:hover {
                color: white;
            }

        .nav-link-custom.active-link {
            color: white;
            font-weight: bold;
            border-bottom: 2px solid white; /* A subtle indicator */
        }

        /* Sidebar Customization */
        .sidebar {
            background-color: var(--sidebar-bg) !important; /* Ensure it overrides bootstrap */
            border-right: 1px solid rgba(0, 0, 0, 0.1);
            padding-top: 2rem;
        }

        .sidebar .nav-link {
            color: var(--text-dark);
            padding: 0.75rem 1rem;
            transition: background-color 0.2s ease-in-out, color 0.2s ease-in-out;
        }

            .sidebar .nav-link:hover {
                background-color: rgba(0, 0, 0, 0.05);
                color: var(--primary-color-dark);
            }

            .sidebar .nav-link.active,
            .sidebar .nav-link[aria-expanded="true"] {
                font-weight: bold;
                background-color: rgba(0, 0, 0, 0.1);
                color: var(--primary-color-dark);
            }

        .sidebar .toggle-arrow {
            transition: transform 0.2s ease-in-out;
        }

        .sidebar .nav-link[aria-expanded="true"] .toggle-arrow {
            transform: rotate(90deg); /* Rotate arrow when expanded */
        }

        .sidebar-header {
            padding: 1rem 0 1rem 1rem; /* Adjust padding for admin title */
        }

        /* Main Content Area */
        .main-content {
            padding: 1rem 1.5rem; /* More generous padding */
            background-color: white; /* Ensure clear background */
        }

        /* Notifications Dropdown */
        #notificationsDropdown {
            margin-left: 0; /* Remove inline style */
            background-color: transparent;
            border: none;
            color: var(--text-dark); /* Match surrounding text color */
        }

        #notificationsDropdown .bi-bell {
            vertical-align: middle; /* Align icon vertically */
        }

        .notification-item {
            border-bottom: 1px solid #eee;
        }

            .notification-item:last-child {
                border-bottom: none;
            }

        .notification-item.unread {
            background-color: #f8f9fa; /* Slightly different background for unread */
            font-weight: bold;
        }

        /* Footer Customization */
        footer {
            background-color: var(--sidebar-bg) !important; /* Consistent light grey */
            color: var(--text-dark) !important;
            border-top: 1px solid rgba(0, 0, 0, 0.1);
        }

        footer a {
            color: var(--text-dark);
            transition: color 0.3s ease-in-out;
        }

            footer a:hover {
                color: var(--primary-color-dark);
            }

        footer .navbar-brand sup span {
            color: brown; /* Keep your existing color if desired */
        }


        /* Responsive Adjustments */
        @@media (max-width: 991.98px) { /* Medium devices and down */
            .sidebar {
                position: fixed; /* Fix sidebar on smaller screens */
                top: 60px; /* Below the fixed navbar */
                left: 0;
                height: calc(100vh - 60px); /* Full height minus navbar */
                z-index: 1020; /* Above main content, below navbar */
                transform: translateX(-100%); /* Hide off-screen by default */
                transition: transform 0.3s ease-in-out;
            }

            .sidebar.show {
                transform: translateX(0); /* Show on toggle */
            }

            .main-content {
                margin-left: 0; /* No margin when sidebar is hidden */
            }

            /* Overlay for when sidebar is open */
            .sidebar-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.5);
                z-index: 1010;
                display: none;
            }

            .sidebar.show + .sidebar-overlay {
                display: block;
            }

            .navbar-toggler-icon {
                color: white !important; /* Ensure toggler icon is visible */
            }
        }

        @@media (min-width: 992px) { /* Large devices and up */
            .sidebar {
                position: sticky; /* Keep sidebar in flow for large screens */
                top: 70px; /* Offset for fixed navbar */
                height: calc(100vh - 70px); /* Adjust height */
            }
        }

        /* Modal specific styling for create admin */
        #createAdminModal .modal-header {
            background-color: var(--primary-color-dark);
            color: white;
            border-bottom: none;
        }

        #createAdminModal .modal-title {
            color: white !important;
        }

        #createAdminModal .btn-close {
            filter: invert(1); /* Make close button white */
        }
    </style>
</head>
<body class="d-flex flex-column">

