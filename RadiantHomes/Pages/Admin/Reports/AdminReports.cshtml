@page
@model RadiantHomes.Pages.Admin.Reports.AdminReportsModel
@{
    Layout = "~/Pages/Shared/_DashboardAdminLayout.cshtml";
    ViewData["Title"] = "Reports";
    ViewData["Subtitle"] = "Generate a report, then download it as PDF or Excel.";
}

@* Results of the previous action are shown as toasts by _FlashMessages. *@

<div class="card mb-4">
    <div class="card-header">
        <h2 class="mh-section-title"><i class="bi bi-graph-up" aria-hidden="true"></i> Generate Reports</h2>
    </div>
    <div class="card-body">
        <form method="post" id="reportForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-lg-6">
                    <label for="reportType" class="form-label">Select Report Type:</label>
                    <select class="form-select" id="reportType" name="ReportType" onchange="toggleDatePickers()" asp-for="ReportType">
                        <option value="">-- Select a Report --</option>
                        <option value="ApartmentHouseSaleTransactions">Apartment/House Sale Transactions</option>
                        <option value="AllApartmentHouses">All Apartment Houses</option>
                        <option value="AllCustomers">All Customers</option>
                        <option value="AllUsers">All Users (Agents)</option>
                        <option value="HousingCompanies">Housing Companies</option>
                        <option value="SoldHousesByDateRange">Sold Houses (by Date Range)</option>
                    </select>
                    <span asp-validation-for="ReportType" class="text-danger"></span>
                </div>
            </div>

            <div id="dateRangeFields" class="mt-3" style="display: @(Model.ReportType == "SoldHousesByDateRange" ? "block" : "none");">
                <div class="row g-3">
                    <div class="col-md-6 col-lg-3">
                        <label for="startDate" class="form-label">Start Date:</label>
                        <input type="date" class="form-control" id="startDate" name="StartDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))">
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <label for="endDate" class="form-label">End Date:</label>
                        <input type="date" class="form-control" id="endDate" name="EndDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))">
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mh-form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-play-fill" aria-hidden="true"></i> Generate Report
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Report is { } report)
{
    <div class="card mb-4">
        <div class="card-header">
            <h2 class="mh-section-title"><i class="bi @report.Icon" aria-hidden="true"></i> Report Results: @report.Title</h2>
            @if (!string.IsNullOrEmpty(report.Subtitle))
            {
                <p class="text-muted small mb-0">@report.Subtitle</p>
            }
        </div>
        @if (report.Rows.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            @foreach (var column in report.Columns)
                            {
                                <th scope="col" class="@(column.AlignEnd ? "text-end" : null)">@column.Header</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in report.Rows)
                        {
                            <tr>
                                @for (var c = 0; c < report.Columns.Count; c++)
                                {
                                    <td class="@(report.Columns[c].AlignEnd ? "text-end" : null)">@report.Columns[c].Format(row[c])</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer mh-form-actions">
                <a asp-page-handler="Download" asp-route-report="@report.Key" asp-route-format="pdf"
                   asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                   class="btn btn-outline-primary" data-no-loader>
                    <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Download PDF
                </a>
                <a asp-page-handler="Download" asp-route-report="@report.Key" asp-route-format="xlsx"
                   asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                   class="btn btn-outline-primary" data-no-loader>
                    <i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Download Excel
                </a>
            </div>
        }
        else
        {
            <div class="card-body">
                <p class="text-muted text-center py-4 mb-0">No data available for the selected report.</p>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function toggleDatePickers() {
            var reportType = document.getElementById('reportType').value;
            var dateRangeFields = document.getElementById('dateRangeFields');

            if (reportType === 'SoldHousesByDateRange') {
                dateRangeFields.style.display = 'block';
                document.getElementById('startDate').setAttribute('required', 'required');
                document.getElementById('endDate').setAttribute('required', 'required');
            } else {
                dateRangeFields.style.display = 'none';
                document.getElementById('startDate').removeAttribute('required');
                document.getElementById('endDate').removeAttribute('required');
                document.getElementById('startDate').value = '';
                document.getElementById('endDate').value = '';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            toggleDatePickers();
        });
    </script>
}
