@page
@model RadiantHomes.Pages.Admin.Dashboard.AdminDashboardModel
@{
    Layout = "~/Pages/Shared/_DashboardAdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = "Live platform totals and shortcuts to common admin tasks.";

    // Same destinations as the admin sidebar
    var quickLinks = new[]
    {
        (Title: "Reports", Text: "Generate sales, apartment, customer and company reports and export them to PDF or Excel.", Icon: "bi-file-earmark-bar-graph", Page: "/Admin/Reports/AdminReports"),
        (Title: "Notifications", Text: "Review admin notifications and mark them as read.", Icon: "bi-bell", Page: "/Admin/Notifications/NotificationsAll"),
        (Title: "Projects", Text: "Housing development projects run by real estate companies.", Icon: "bi-kanban", Page: "/Projects/Index"),
        (Title: "Buildings", Text: "Buildings within each housing project.", Icon: "bi-buildings", Page: "/Buildings/Index"),
        (Title: "Apartments", Text: "Apartment houses listed on Michu Homes.", Icon: "bi-house-door", Page: "/ApartmentHouses/Index"),
    };
}

<h2 class="mh-section-title mb-3">Quick links</h2>
<div class="row g-3">
    @foreach (var link in quickLinks)
    {
        <div class="col-12 col-md-6 col-xl-4">
            <a class="card mh-media-card h-100 text-decoration-none" asp-area="" asp-page="@link.Page">
                <div class="card-body d-flex align-items-start gap-3">
                    <span class="mh-stat-icon" aria-hidden="true"><i class="bi @link.Icon"></i></span>
                    <div class="flex-grow-1">
                        <h3 class="h6 mb-1 text-navy">@link.Title</h3>
                        <p class="small text-muted mb-0">@link.Text</p>
                    </div>
                    <i class="bi bi-arrow-right-short fs-4 text-muted" aria-hidden="true"></i>
                </div>
            </a>
        </div>
    }
</div>
