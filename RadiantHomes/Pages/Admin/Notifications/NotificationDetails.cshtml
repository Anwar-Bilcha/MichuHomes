@page "{notificationId:int?}"
@model RadiantHomes.Pages.Admin.Notifications.NotificationDetailsModel

@{
    ViewData["Title"] = "Notification details";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

@section PageActions {
    <a asp-page="./NotificationsAll" class="btn btn-secondary">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Notifications
    </a>
}

@* Results (TempData SuccessMessage/ErrorMessage) are shown as toasts by _FlashMessages. *@

@if (Model.Notification == null)
{
    <div class="card">
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-bell-slash"></i></span>
            <h2>Notification not found</h2>
            <p>It doesn't exist, or the link has an invalid id.</p>
            <a asp-page="./NotificationsAll" class="btn btn-primary">Back to notifications</a>
        </div>
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">@Model.Notification.Message</h2>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <span class="text-muted"><i class="bi bi-clock me-1" aria-hidden="true"></i> @Model.Notification.CreatedAt.ToString("g")</span>

                <span class="badge bg-info"><i class="bi bi-info-circle me-1" aria-hidden="true"></i> Type: @Model.Notification.Datatype</span>
                @if (Model.Notification.IsRead)
                {
                    <span class="badge bg-secondary"><i class="bi bi-check-circle me-1" aria-hidden="true"></i> Status: Read</span>
                }
                else
                {
                    <span class="badge bg-warning"><i class="bi bi-envelope-open me-1" aria-hidden="true"></i> Status: Unread</span>
                }
                @if (Model.Approval.IsApplicable)
                {
                    <span class="@Model.Approval.BadgeClass"><i class="bi bi-patch-check me-1" aria-hidden="true"></i> Approval: @Model.Approval.Label</span>
                }
                <span class="text-muted text-break"><i class="bi bi-key me-1" aria-hidden="true"></i> Data Key: @Model.Notification.DataKey</span>
            </div>
        </div>
        @if (Model.CanApproveHouses)
        {
            <div class="card-footer">
                <form method="post" asp-page-handler="ApproveNotification" class="d-flex justify-content-end"
                      data-confirm-title="Approve these houses?"
                      data-confirm="Houses still awaiting approval become “Approved” and appear in the public listing. Houses that are already approved, reserved, sold, rented or hidden are left unchanged."
                      data-confirm-ok="Approve"
                      data-confirm-variant="primary">
                    <input type="hidden" name="notificationId" value="@Model.Notification.Id" />
                    <button type="submit" class="btn btn-primary" id="approveButton">
                        <i class="bi bi-check-lg" aria-hidden="true"></i> Approve
                    </button>
                </form>
            </div>
        }
    </div>

    <h2 class="mh-section-title mb-3"><i class="bi bi-houses" aria-hidden="true"></i> Associated Items</h2>

    @if (Model.HousesCreated != null && Model.HousesCreated.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var house in Model.HousesCreated)
            {
                <div class="col">
                    <div class="card mh-media-card h-100">
                        @if (house.Photos.Any())
                        {
                            <img src="@house.Photos.First().PhotoPath" class="card-img-top" alt="Image of @house.Title">
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center text-muted fs-1" aria-hidden="true">
                                <i class="bi bi-image"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h3 class="card-title h6">@house.Title</h3>
                            <ul class="list-unstyled small mb-0">
                                <li class="mb-1"><span class="text-muted me-2">Price:</span> @RadiantHomes.Pages.Admin.Notifications.NotificationDetailsModel.FormatPrice(house)</li>
                                <li class="mb-1"><span class="text-muted me-2">Bedrooms:</span> @house.Bedrooms</li>
                                <li class="mb-1"><span class="text-muted me-2">Bathrooms:</span> @house.Bathrooms</li>
                                <li>
                                    <span class="text-muted me-2">Status:</span>
                                    <span class="@RadiantHomes.Pages.Admin.Notifications.NotificationDetailsModel.HouseStatusBadgeClass(house.Status)">
                                        @house.Status
                                    </span>
                                </li>
                            </ul>
                        </div>
                        <div class="card-footer d-flex flex-wrap gap-2">
                            <a asp-page="/ApartmentHouses/Details" asp-route-id="@house.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye" aria-hidden="true"></i> View
                            </a>
                            <a asp-page="/ApartmentHouses/Edit" asp-route-id="@house.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                            </a>
                            <a asp-page="/ApartmentHouses/Delete" asp-route-id="@house.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash" aria-hidden="true"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card">
            <div class="mh-empty">
                <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-houses"></i></span>
                <p class="mb-0">No associated houses found for this notification.</p>
            </div>
        </div>
    }
}

@section Scripts {
    @* The Approve form uses the standard data-confirm dialog (wwwroot/js/michu-dialogs.js). *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
