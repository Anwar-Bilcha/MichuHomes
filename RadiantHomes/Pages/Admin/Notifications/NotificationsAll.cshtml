@page
@model RadiantHomes.Pages.Admin.Notifications.NotificationsAllModel
@{
    ViewData["Title"] = "All notifications";
    ViewData["Subtitle"] = "Review admin notifications, mark them as read or delete them.";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<div class="card">
    @if (Model.Notifications == null || !Model.Notifications.Any())
    {
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-bell"></i></span>
            <h2>No notifications found.</h2>
            <p>New notifications for admins appear here.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Title</th>
                        <th scope="col">Message</th>
                        <th scope="col">Created Date</th>
                        <th scope="col">Read Status</th>
                        <th scope="col">Approval Status</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var notification in Model.Notifications.OrderByDescending(n => n.CreatedAt))
                    {
                        <tr class="@(notification.IsRead ? "text-muted" : "fw-bold")">
                            <td>@notification.Title</td>
                            <td>@notification.Message</td>
                            <td class="text-nowrap">@notification.CreatedAt.ToShortDateString() @notification.CreatedAt.ToShortTimeString()</td>
                            <td>
                                @if (notification.IsRead)
                                {
                                    <span class="badge bg-secondary">Read</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Unread</span>
                                }
                            </td>
                            <td>
                                @{ var approval = Model.ApprovalFor(notification); }
                                @if (approval.IsApplicable)
                                {
                                    <span class="@approval.BadgeClass text-nowrap">@approval.Label</span>
                                }
                                else
                                {
                                    <span class="text-muted" title="Nothing to approve" aria-hidden="true">—</span><span class="visually-hidden">Nothing to approve</span>
                                }
                            </td>
                            <td class="text-end">
                                <form method="post" class="mh-row-actions notification-action-form">
                                    <input type="hidden" name="notificationId" value="@notification.Id" />
                                    <a asp-page="./NotificationDetails" asp-route-notificationId="@notification.Id" class="btn btn-sm btn-outline-secondary btn-icon" title="View details" aria-label="View details">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </a>
                                    @if (notification.IsRead)
                                    {
                                        <button type="submit" asp-page-handler="MarkAsUnread" class="btn btn-sm btn-outline-secondary btn-icon" title="Mark as unread" aria-label="Mark as unread">
                                            <i class="bi bi-envelope-open-fill" aria-hidden="true"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" asp-page-handler="MarkAsRead" class="btn btn-sm btn-outline-primary btn-icon" title="Mark as read" aria-label="Mark as read">
                                            <i class="bi bi-envelope-fill" aria-hidden="true"></i>
                                        </button>
                                    }
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-sm btn-outline-danger btn-icon" title="Delete notification" aria-label="Delete notification"
                                            data-confirm-title="Delete this notification?"
                                            data-confirm="“@notification.Title” will be removed permanently. This can't be undone."
                                            data-confirm-ok="Delete"
                                            data-confirm-variant="danger">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* Delete uses the standard data-confirm dialog (wwwroot/js/michu-dialogs.js); results are shown as toasts by _FlashMessages. *@
