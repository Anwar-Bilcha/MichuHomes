@page
@model RadiantHomes.Pages.Projects.CreateModel

@{
    ViewData["Title"] = "New project";
    ViewData["Subtitle"] = string.IsNullOrWhiteSpace(Model.Company?.Name)
        ? "Fields marked * are required. The preview updates as you type."
        : $"For {Model.Company.Name}. Fields marked * are required. The preview updates as you type.";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <form method="post" id="projectForm" class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                @* Hidden fields *@
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="PickCompany" />
                @if (!Model.PickCompany)
                {
                    <input type="hidden" asp-for="CompanyId" />
                }

                <div class="row g-3">
                    @if (Model.PickCompany)
                    {
                        <div class="col-12">
                            <label asp-for="CompanyId" class="form-label">Company <span class="text-danger">*</span></label>
                            <select asp-for="CompanyId" class="form-select" asp-items="Model.CompanySelectList" id="projectCompany">
                                <option value="">-- Select Company --</option>
                            </select>
                            <span asp-validation-for="CompanyId" class="text-danger small"></span>
                        </div>
                    }
                    else
                    {
                        <span asp-validation-for="CompanyId" class="text-danger small"></span>
                    }
                    <div class="col-12">
                        <label asp-for="HouseProject.ProjectName" class="form-label">Project Name <span class="text-danger">*</span></label>
                        <input asp-for="HouseProject.ProjectName" class="form-control" id="projectName" />
                        <span asp-validation-for="HouseProject.ProjectName" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="HouseProject.AddressId" class="form-label">Address <span class="text-danger">*</span></label>
                        <select asp-for="HouseProject.AddressId" class="form-select" asp-items="Model.AddressSelectList" id="projectAddress">
                            <option value="">-- Select Address --</option>
                        </select>
                        <span asp-validation-for="HouseProject.AddressId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HouseProject.Location" class="form-label">Location <span class="text-danger">*</span></label>
                        <input asp-for="HouseProject.Location" class="form-control" id="projectLocation" />
                        <span asp-validation-for="HouseProject.Location" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HouseProject.TotalArea" class="form-label">Total Area (sqm) <span class="text-danger">*</span></label>
                        <input asp-for="HouseProject.TotalArea" class="form-control" id="projectArea" />
                        <span asp-validation-for="HouseProject.TotalArea" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="HouseProject.Description" class="form-label">Description <span class="text-danger">*</span></label>
                        <textarea asp-for="HouseProject.Description" class="form-control" rows="3" id="projectDescription"></textarea>
                        <span asp-validation-for="HouseProject.Description" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HouseProject.StartDate" class="form-label">Start Date</label>
                        <input asp-for="HouseProject.StartDate" class="form-control" type="date" id="projectStartDate" />
                        <span asp-validation-for="HouseProject.StartDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HouseProject.EndDate" class="form-label">End Date</label>
                        <input asp-for="HouseProject.EndDate" class="form-control" type="date" id="projectEndDate" />
                        <span asp-validation-for="HouseProject.EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mh-form-actions">
                    <a href="@Model.DoneUrl" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save project</button>
                </div>
            </div>
        </form>
    </div>

    @* Live preview *@
    <div class="col-12 col-lg-5">
        <div class="card mh-preview-card">
            <div class="card-header">
                <h2 class="mh-section-title"><i class="bi bi-eye" aria-hidden="true"></i> Project preview</h2>
            </div>
            <div class="card-body" id="previewPanel">
                <dl class="mh-dl">
                    <dt>Company</dt>
                    <dd><span id="previewCompany">@(string.IsNullOrWhiteSpace(Model.Company?.Name) ? "—" : Model.Company.Name)</span></dd>
                    <dt>Project Name</dt>
                    <dd><span id="previewName">—</span></dd>
                    <dt>Location</dt>
                    <dd><span id="previewLocation">—</span></dd>
                    <dt>Description</dt>
                    <dd><span id="previewDescription">—</span></dd>
                    <dt>Start Date</dt>
                    <dd><span id="previewStartDate">—</span></dd>
                    <dt>End Date</dt>
                    <dd><span id="previewEndDate">—</span></dd>
                    <dt>Total Area</dt>
                    <dd><span id="previewArea">—</span> sqm</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        @@media (min-width: 576px) {
            .mh-preview-card .mh-dl { grid-template-columns: minmax(110px, 140px) 1fr; }
        }
        @@media (min-width: 992px) {
            .mh-preview-card { position: sticky; top: calc(var(--mh-topbar-h) + 1rem); }
        }
    </style>
}

@section Scripts {
    <partial name="_Select2" />
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {
            $('#projectAddress').select2({ placeholder: (window.MichuI18n ? MichuI18n.t : (s => s))("-- Select Address --"), allowClear: true });
            $('#projectCompany').on('change', function () {
                $('#previewCompany').text(this.value ? $(this).find('option:selected').text() : '—');
            });
        });
    </script>

    <script>
        function updatePreview(id, previewId) {
            const input = document.getElementById(id);
            const preview = document.getElementById(previewId);
            if (input && preview) {
                const show = () => { preview.textContent = input.value || '—'; };
                input.addEventListener('input', show);
                show(); // fields can be prefilled (start date = today, or values kept after a validation error)
            }
        }

        ['projectName', 'projectLocation', 'projectDescription', 'projectStartDate', 'projectEndDate', 'projectArea']
            .forEach(field => updatePreview(field, 'preview' + field.replace('project', '')));

        // The end date can't be before the start date (also checked on the server).
        (function () {
            const start = document.getElementById('projectStartDate');
            const end = document.getElementById('projectEndDate');
            if (!start || !end) return;
            const sync = () => { end.min = start.value || ''; };
            start.addEventListener('input', sync);
            sync();
        })();

    </script>
}
