@page
@model RadiantHomes.Pages.Projects.DeleteModel

@{
    ViewData["Title"] = "Delete project";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<div class="card mh-confirm">
    <div class="card-header">
        <h2 class="mh-section-title text-reset"><i class="bi bi-exclamation-triangle text-reset" aria-hidden="true"></i> Are you sure you want to delete this project?</h2>
    </div>
    <div class="card-body">
        <p class="text-muted">This permanently removes the record below. It can't be undone.</p>
        <dl class="mh-dl">
            <dt>@Html.DisplayNameFor(model => model.HouseProject.Company)</dt>
            <dd>@Html.DisplayFor(model => model.HouseProject.Company!.Name)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseProject.ProjectName)</dt>
            <dd>@Html.DisplayFor(model => model.HouseProject.ProjectName)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseProject.Location)</dt>
            <dd>@Html.DisplayFor(model => model.HouseProject.Location)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseProject.Description)</dt>
            <dd>@Html.DisplayFor(model => model.HouseProject.Description)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseProject.StartDate)</dt>
            <dd>@Html.DisplayFor(model => model.HouseProject.StartDate)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseProject.EndDate)</dt>
            <dd>@Html.DisplayFor(model => model.HouseProject.EndDate)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseProject.TotalArea)</dt>
            <dd>@Html.DisplayFor(model => model.HouseProject.TotalArea)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseProject.CreatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.HouseProject.CreatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseProject.CreatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.HouseProject.CreatedOn)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseProject.UpdatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.HouseProject.UpdatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.HouseProject.UpdatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.HouseProject.UpdatedOn)</dd>
        </dl>

        <form method="post" class="mh-form-actions">
            <input type="hidden" asp-for="HouseProject.ProjectId" />
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash" aria-hidden="true"></i> Delete project</button>
        </form>
    </div>
</div>
