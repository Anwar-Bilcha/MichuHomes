@page "{id:guid?}"
@using RadiantHomes.DAL
@model RadiantHomes.Pages.Projects.DetailsModel

@{
    var companyName = Model.HouseProject?.Company?.Name;
    ViewData["Title"] = Model.HouseProject?.ProjectName ?? "Project details";
    ViewData["Subtitle"] = string.IsNullOrWhiteSpace(companyName) ? null : $"A housing project by {companyName}.";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section PageActions {
    <a asp-page="./Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to projects
    </a>
    @if (User.IsInRole(MichuHomesRoles.MichuAdmin) || User.IsInRole(MichuHomesRoles.RealEstateAdmin))
    {
        <a asp-page="./Edit" asp-route-id="@Model.HouseProject?.ProjectId" class="btn btn-primary">
            <i class="bi bi-pencil" aria-hidden="true"></i> Edit project
        </a>
    }
}

<div class="row g-4 mb-4">
    @* Project photos (gallery with lightbox) *@
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="mh-section-title"><i class="bi bi-images" aria-hidden="true"></i> The Housing Project Sample Views</h2>
            </div>
            @if (Model.ProjectPhotoUrls != null && Model.ProjectPhotoUrls.Any())
            {
                <div class="card-body">
                    <div class="gallery-container">
                        @foreach (var photoUrl in Model.ProjectPhotoUrls)
                        {
                            <a href="@photoUrl" class="gallery-item">
                                <img src="@photoUrl" alt="Project Photo" loading="lazy" />
                            </a>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="mh-empty">
                    <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-image"></i></span>
                    <h3>No photos yet</h3>
                    <p>No photos available for this project yet.</p>
                </div>
            }
        </div>
    </div>

    @* Project overview *@
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="mh-section-title"><i class="bi bi-info-circle" aria-hidden="true"></i> Project Overview</h2>
            </div>
            <div class="card-body">
                <dl class="mh-dl mh-dl--compact">
                    <dt>Company</dt>
                    <dd>@(Model.HouseProject?.Company?.Name ?? "N/A")</dd>

                    <dt>Location</dt>
                    <dd><i class="bi bi-geo-alt text-accent me-1" aria-hidden="true"></i>@(Model.HouseProject?.Location ?? "N/A")</dd>

                    <dt>Description</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.HouseProject?.Description) ? "No description provided." : Model.HouseProject.Description)</dd>

                    <dt>Total Area</dt>
                    <dd>@(Model.HouseProject?.TotalArea.ToString("N2") ?? "N/A") sqm</dd>

                    <dt>Start Date</dt>
                    <dd>@(Model.HouseProject?.StartDate.ToString("yyyy-MM-dd") ?? "N/A")</dd>

                    <dt>End Date</dt>
                    <dd>@(Model.HouseProject?.EndDate?.ToString("yyyy-MM-dd") ?? "Ongoing")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@* Key figures *@
<div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4 mh-project-stats">
    <div class="col">
        <div class="card mh-stat">
            <div>
                <p class="mh-stat-label">Total Houses</p>
                <p class="mh-stat-value">@(Model.TotalHouses.ToString())</p>
            </div>
            <span class="mh-stat-icon" aria-hidden="true"><i class="bi bi-house-door"></i></span>
        </div>
    </div>
    <div class="col">
        <div class="card mh-stat">
            <div>
                <p class="mh-stat-label">Avg. Sale Price</p>
                <p class="mh-stat-value">@(string.IsNullOrEmpty(Model.AverageSalePriceText) ? "N/A" : Model.AverageSalePriceText)</p>
            </div>
            <span class="mh-stat-icon mh-stat-icon--accent" aria-hidden="true"><i class="bi bi-cash-coin"></i></span>
        </div>
    </div>
    <div class="col">
        <div class="card mh-stat">
            <div>
                <p class="mh-stat-label">Residential Houses</p>
                <p class="mh-stat-value">@(Model.NumberOfResidentialHouses.ToString())</p>
            </div>
            <span class="mh-stat-icon" aria-hidden="true"><i class="bi bi-building-check"></i></span>
        </div>
    </div>
    <div class="col">
        <div class="card mh-stat">
            <div>
                <p class="mh-stat-label">Commercial Houses</p>
                <p class="mh-stat-value">@(Model.NumberOfCommercialHouses.ToString())</p>
            </div>
            <span class="mh-stat-icon" aria-hidden="true"><i class="bi bi-shop"></i></span>
        </div>
    </div>
    <div class="col">
        <div class="card mh-stat">
            <div>
                <p class="mh-stat-label">Houses Sold Recently</p>
                <p class="mh-stat-value">@(Model.NumberOfHousesSoldRecently.ToString())</p>
            </div>
            <span class="mh-stat-icon mh-stat-icon--accent" aria-hidden="true"><i class="bi bi-graph-up-arrow"></i></span>
        </div>
    </div>
</div>

@* Buildings section *@
<section class="mb-4" aria-labelledby="projectBuildingsTitle">
    <h2 class="mh-section-title mb-3" id="projectBuildingsTitle"><i class="bi bi-buildings" aria-hidden="true"></i> Buildings in this Project</h2>
    @if (Model.HouseProject?.Buildings != null && Model.HouseProject.Buildings.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
            @foreach (var building in Model.HouseProject.Buildings)
            {
                <div class="col">
                    <a asp-page="/Buildings/Details" asp-route-id="@building.Id" class="card mh-media-card h-100 text-decoration-none">
                        @if (building.Photos != null && building.Photos.Any())
                        {
                            <img src="@building.Photos.First().PhotoPath" class="card-img-top" alt="@building.BuildingName Image" loading="lazy" />
                        }
                        else
                        {
                            <div class="card-img-top mh-media-placeholder" aria-hidden="true"><i class="bi bi-image"></i></div>
                        }
                        <div class="card-body">
                            <h3 class="h5 card-title mb-1">@building.BuildingName</h3>
                            <p class="card-text text-muted mb-0"><i class="bi bi-layers me-1" aria-hidden="true"></i> Floors: @building.NumberOfFloors</p>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card">
            <div class="mh-empty">
                <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-buildings"></i></span>
                <h3>No buildings yet</h3>
                <p>No buildings associated with this project yet.</p>
            </div>
        </div>
    }
</section>

@* Auditing information *@
<div class="card">
    <div class="card-header">
        <h2 class="mh-section-title"><i class="bi bi-clock-history" aria-hidden="true"></i> Auditing Information</h2>
    </div>
    <div class="card-body">
        <dl class="mh-dl">
            <dt>Created By</dt>
            <dd>@(Model.HouseProject?.CreatedBy ?? "N/A")</dd>

            <dt>Created On</dt>
            <dd>@(Model.HouseProject?.CreatedOn.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</dd>

            <dt>Last Updated By</dt>
            <dd>@(Model.HouseProject?.UpdatedBy ?? "N/A")</dd>

            <dt>Last Updated On</dt>
            <dd>@(Model.HouseProject?.UpdatedOn?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</dd>
        </dl>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/simplelightbox/2.14.2/simple-lightbox.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        /* Photo gallery: first photo large, the rest as thumbnails */
        .gallery-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: .75rem; }
        .gallery-container .gallery-item { display: block; overflow: hidden; border-radius: var(--mh-radius-sm); background: var(--mh-surface-3); }
        .gallery-container .gallery-item img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform .2s ease; }
        .gallery-container .gallery-item:hover img { transform: scale(1.03); }
        .gallery-container .gallery-item:first-child { grid-column: 1 / -1; }
        .gallery-container .gallery-item:first-child img { aspect-ratio: 16 / 9; }

        @@media (min-width: 576px) { .mh-dl--compact { grid-template-columns: minmax(110px, 150px) 1fr; } }

        .mh-project-stats .mh-stat-value { font-size: clamp(1.2rem, 1rem + .6vw, 1.6rem); overflow-wrap: anywhere; }

        .mh-media-placeholder { display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 3; background: var(--mh-surface-3); color: var(--mh-ink-3); font-size: 2rem; }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/simplelightbox/2.14.2/simple-lightbox.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            new SimpleLightbox('.gallery-container a', {
                animationSlide: true,
                disableScroll: true,
                history: false
            });
        });
    </script>
}
