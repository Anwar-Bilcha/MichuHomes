@page
@using RadiantHomes.DAL
@model RadiantHomes.Pages.Projects.IndexModel

@{
    ViewData["Title"] = "Projects";
    // The list is public (navbar "Projects"); creating, editing and deleting are for administrators only,
    // so visitors get the public layout instead of the admin sidebar.
    var canManage = User.IsInRole(MichuHomesRoles.MichuAdmin) || User.IsInRole(MichuHomesRoles.RealEstateAdmin);
    Layout = canManage ? "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml" : "~/Pages/Shared/_Layout.cshtml";
}

@if (canManage)
{
    @section PageActions {
        <a class="btn btn-primary" asp-page="Create">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New project
        </a>
    }
}

<div class="card">
    @if (Model.HouseProject?.Any() == true)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Project</th>
                        <th scope="col">Company</th>
                        <th scope="col">Location</th>
                        <th scope="col">Start</th>
                        <th scope="col">End</th>
                        <th scope="col" class="text-end">Total area</th>
                        <th scope="col" class="text-end position-relative"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var project in Model.HouseProject)
                    {
                        <tr>
                            <td class="mh-project-cell">
                                <a class="fw-semibold text-decoration-none" asp-page="./Details" asp-route-id="@project.ProjectId">@project.ProjectName</a>
                                @if (!string.IsNullOrWhiteSpace(project.Description))
                                {
                                    <div class="small text-muted text-truncate">@project.Description</div>
                                }
                            </td>
                            <td>@project.Company?.Name</td>
                            <td>@project.Location</td>
                            <td class="text-nowrap">@project.StartDate.ToShortDateString()</td>
                            <td class="text-nowrap">@project.EndDate?.ToShortDateString()</td>
                            <td class="text-end text-nowrap">@project.TotalArea m²</td>
                            <td class="text-end">
                                <div class="mh-row-actions">
                                    <a class="btn btn-sm btn-outline-secondary btn-icon" asp-page="./Details" asp-route-id="@project.ProjectId" title="View details" aria-label="View details of @project.ProjectName"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                    @if (canManage)
                                    {
                                        <a class="btn btn-sm btn-outline-primary btn-icon" asp-page="./Edit" asp-route-id="@project.ProjectId" title="Edit" aria-label="Edit @project.ProjectName"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                        <a class="btn btn-sm btn-outline-danger btn-icon" asp-page="./Delete" asp-route-id="@project.ProjectId" title="Delete" aria-label="Delete @project.ProjectName"><i class="bi bi-trash" aria-hidden="true"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.NoCompany)
    {
        <partial name="~/Areas/HousingCompanyAdmin/Pages/_NoCompanyNotice.cshtml" />
    }
    else
    {
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-kanban"></i></span>
            <h2>No projects found</h2>
            <p>Housing projects appear here, with their buildings and apartments.</p>
            @if (canManage)
            {
                <a class="btn btn-primary" asp-page="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> New project</a>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        .mh-project-cell { min-width: 12rem; }
        .mh-project-cell .text-truncate { max-width: 18rem; }
    </style>
}
