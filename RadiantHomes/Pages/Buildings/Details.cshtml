@page "{id:guid?}"
@using RadiantHomes.Models.Shared
@model RadiantHomes.Pages.Buildings.DetailsModel

@{
    ViewData["Title"] = "Building Details: ";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml"; // Ensure this layout path is correct
}

<style>
    /* Hero Section Styles (Adapted from Project Details) */
    .hero-section {
    background-color: #f8f9fa; /* Fallback color */
    background-size: cover;
    background-position: center;
    position: relative;
    color: white;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.6);
    padding: 5rem 0;
    margin-bottom: 3rem; /* Space below hero section */
    min-height: 300px; /* Adjusted minimum height for buildings */
    display: flex;
    align-items: center;
    justify-content: center; /* Center content horizontally if narrow */
    text-align: center; /* Center text within hero */
    border-radius: 0.5rem; /* Rounded corners for the container */
    overflow: hidden; /* Ensure background doesn't leak */
    }

    .hero-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5); /* Dark overlay for text readability */
    z-index: 1;
    }

    .hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px; /* Limit content width */
    margin: 0 auto;
    padding: 0 1rem;
    }

    .hero-content h1 {
    font-size: 2.5rem; /* Adjusted font size for building name */
    font-weight: bold;
    margin-bottom: 0.5rem;
    }

    .hero-content p {
    font-size: 1.2rem; /* Adjusted font size for subtitle */
    opacity: 0.9;
    margin-bottom: 1.5rem;
    }

    /* Adjust hero text for smaller screens */
    @@media (max-width: 767.98px) {
    .hero-section {
    min-height: 200px;
    padding: 2rem 0;
    }

    .hero-content h1 {
    font-size: 2rem;
    }

    .hero-content p {
    font-size: 1rem;
    }
    }

    /* General Card Styles */
    .card {
    border-radius: 0.75rem !important; /* Slightly more rounded corners for cards */
    border: none; /* Remove default card border */
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important; /* Stronger, softer shadow */
    }

    .card-header {
    border-bottom: none !important; /* Remove border below header */
    border-top-left-radius: calc(0.75rem - 1px) !important;
    border-top-right-radius: calc(0.75rem - 1px) !important;
    padding: 1rem 1.5rem; /* Adjust padding */
    }

    /* Building Details Specifics */
    .building-details-card .card-header {
    background-color: var(--bs-primary) !important; /* Use primary color for building details */
    color: white;
    }

    /* Houses in Building Section */
    .houses-in-building .card-header {
    background-color: var(--bs-info) !important; /* Use info color for houses section */
    color: white;
    }

    /* Image Gallery Styles (Reused) */
    .gallery-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); /* Smaller thumbnails for buildings */
    gap: 0.75rem;
    padding: 0.75rem;
    background-color: var(--bs-light);
    border-bottom-left-radius: calc(0.75rem - 1px);
    border-bottom-right-radius: calc(0.75rem - 1px);
    }

    .gallery-item img {
    width: 100%;
    height: 120px; /* Adjusted thumbnail height */
    object-fit: cover;
    border-radius: 0.5rem;
    box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

    .gallery-item img:hover {
    transform: scale(1.03);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.2);
    }

    .no-photos-placeholder {
    min-height: 150px; /* Adjusted height */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--bs-light);
    color: var(--bs-secondary-text-emphasis);
    padding: 1.5rem; /* Adjusted padding */
    border-bottom-left-radius: calc(0.75rem - 1px);
    border-bottom-right-radius: calc(0.75rem - 1px);
    }

    /* House Card Image (in Buildings Detail) */
    .house-card-img {
    max-height: 150px; /* Adjusted max height */
    object-fit: cover;
    width: 100%;
    border-bottom-left-radius: calc(0.75rem - 1px);
    border-bottom-right-radius: calc(0.75rem - 1px);
    }

    /* Button Styling */
    .btn-primary {
    background-color: var(--bs-primary);
    border-color: var(--bs-primary);
    }
</style>

<div class="hero-section" style="background-image:url('~/wwwroot/images/building1.jpg'); background-color: #6c757d;">
    <div class="hero-content">
        <h1 class="display-4 fw-bold mb-2">
            @(Model.Building?.BuildingName ?? "Building Details")
        </h1>
        @if (Model.Building?.Project != null)
        {
            <p class="lead mb-4">
                Part of Project: <a asp-page="/Projects/Details" asp-route-id="@Model.Building.Project.ProjectId" class="text-white text-decoration-underline">@Model.Building.Project.ProjectName</a>
            </p>
        }
        <div class="hero-buttons d-flex justify-content-center gap-3">
            <a asp-page="./Edit" asp-route-id="@Model.Building?.Id" class="btn btn-primary btn-lg">
                <i class="bi bi-pencil-square me-2"></i> Edit Building
            </a>
            <a asp-page="./Index" class="btn btn-outline-light btn-lg">
                <i class="bi bi-arrow-left-circle me-2"></i> Back to Buildings
            </a>
        </div>
    </div>
</div>

<div class="container py-4">
    @* Building Details Section *@
    <div class="card building-details-card shadow-sm rounded-4 mb-5">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-building me-2"></i> Building Information</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-md-3 col-sm-4 fw-semibold text-dark"><i class="bi bi-tag me-2"></i> Name</dt>
                <dd class="col-md-9 col-sm-8 text-muted">@(Model.Building?.BuildingName ?? "N/A")</dd>

                <dt class="col-md-3 col-sm-4 fw-semibold text-dark"><i class="bi bi-list-ol me-2"></i> Number of Floors</dt>
                <dd class="col-md-9 col-sm-8 text-muted">@(Model.Building?.NumberOfFloors.ToString() ?? "N/A")</dd>

                <dt class="col-md-3 col-sm-4 fw-semibold text-dark"><i class="bi bi-bricks me-2"></i> Type</dt>
                <dd class="col-md-9 col-sm-8 text-muted">@(Model.Building?.BuildingType ?? "N/A")</dd>

                <dt class="col-md-3 col-sm-4 fw-semibold text-dark"><i class="bi bi-wrench-adjustable me-2"></i> Construction Status</dt>
                <dd class="col-md-9 col-sm-8 text-muted">@(Model.Building?.ConstructionStatus ?? "N/A")</dd>

                <dt class="col-md-3 col-sm-4 fw-semibold text-dark"><i class="bi bi-link-45deg me-2"></i> Associated Project</dt>
                <dd class="col-md-9 col-sm-8 text-muted">
                    @if (Model.Building?.Project != null)
                    {
                        <a asp-page="/Projects/Details" asp-route-id="@Model.Building.Project.ProjectId">
                            Project #@Model.Building.Project.ProjectId: @Model.Building.Project.ProjectName
                        </a>
                    }
                    else
                    {
                        <span>N/A</span>
                    }
                </dd>

                <dt class="col-md-3 col-sm-4 fw-semibold text-dark"><i class="bi bi-person me-2"></i> Created By</dt>
                <dd class="col-md-9 col-sm-8 text-muted">@(Model.Building?.CreatedBy ?? "N/A")</dd>

                <dt class="col-md-3 col-sm-4 fw-semibold text-dark"><i class="bi bi-calendar-plus me-2"></i> Created On</dt>
                <dd class="col-md-9 col-sm-8 text-muted">@(Model.Building?.CreatedOn.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</dd>

                <dt class="col-md-3 col-sm-4 fw-semibold text-dark"><i class="bi bi-person-check me-2"></i> Updated By</dt>
                <dd class="col-md-9 col-sm-8 text-muted">@(Model.Building?.UpdatedBy ?? "N/A")</dd>

                <dt class="col-md-3 col-sm-4 fw-semibold text-dark"><i class="bi bi-calendar-check me-2"></i> Updated On</dt>
                <dd class="col-md-9 col-sm-8 text-muted">@(Model.Building?.UpdatedOn?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</dd>
            </dl>
        </div>
    </div>

    @* Building Photos Section (Gallery with Lightbox) *@
    @if (Model.Building?.Photos != null && Model.Building.Photos.Any())
    {
        <div class="card shadow-lg rounded-4 mb-5">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0"><i class="bi bi-images me-2"></i> Building Photos</h5>
            </div>
            <div class="gallery-container">
                @foreach (var photo in Model.Building.Photos)
                {
                    <a href="@photo.PhotoPath" class="gallery-item">
                        <img src="@photo.PhotoPath" alt="Building Photo" loading="lazy" />
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="no-photos-placeholder text-center shadow-sm rounded-4 mb-5">
            <i class="bi bi-image-fill fs-1 mb-3"></i>
            <p class="lead">No photos available for this building yet.</p>
        </div>
    }

    @* Houses in the Building Section *@
    @if (Model.Building?.Houses != null && Model.Building.Houses.Any())
    {
        <div class="card houses-in-building shadow-sm rounded-4 mb-5">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-house-fill me-2"></i> Houses in this Building</h5>
            </div>
            <div class="card-body">
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                    @foreach (var house in Model.Building.Houses)
                    {
                        <div class="col">
                            <a asp-page="/ApartmentHouses/Details" asp-route-id="@house.Id" class="card h-100 shadow-sm text-decoration-none border rounded-3 overflow-hidden d-block">
                                <div class="card-body">
                                    <h5 class="card-title text-primary mb-1"><i class="bi bi-key-fill me-2"></i> @house.Title</h5>
                                    <p class="card-text text-muted mb-0"><i class="bi bi-sort-numeric-up me-2"></i> Floor: @house.FloorNumber</p>
                                    <p class="card-text text-muted mb-0"><i class="bi bi-fullscreen me-2"></i> Area: @(house.Area.ToString("N2") ?? "N/A") sqm</p>
                                    <p class="card-text text-muted mb-0"><i class="bi bi-cash-coin me-2"></i> Price: @(house.SalePrice.ToString("C") ?? "N/A")</p>
                                </div>
                                
                                
                                    <img src="@Url.Content("./images/Villa1.jpg") class="house-card-img" alt="@house.Title Image" loading="lazy" />
                               
                                
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center shadow-sm rounded-4 p-4">
            <i class="bi bi-info-circle-fill fs-4 me-2"></i> No houses associated with this building yet.
        </div>
    }

    <div class="mt-4 d-flex gap-3">
        <a asp-page="./Edit" asp-route-id="@Model.Building?.Id" class="btn btn-primary">
            <i class="bi bi-pencil-square me-2"></i> Edit
        </a>
        <a asp-page="./Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left-circle me-2"></i> Back to Buildings
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/simplelightbox/2.14.2/simple-lightbox.min.js" integrity="sha512-RzU6j8f5T+4Tf0m0x9G4r0h7LwM/n5lF+w6qQ/1d7M5tG6f3s9V0f2/V+4W8bQ/4b2G5/z+G9/6V1Q+Q/5t+Q=" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var gallery = new SimpleLightbox('.gallery-container a', {
                animationSlide: true,
                disableScroll: true,
                history: false
            });
        });
    </script>
}