@page "{id:guid?}"
@using RadiantHomes.Models.Shared
@model RadiantHomes.Pages.Buildings.DetailsModel

@{
    ViewData["Title"] = "Building details";
    ViewData["Subtitle"] = Model.Building?.Project != null
        ? $"{Model.Building.BuildingName} is part of the {Model.Building.Project.ProjectName} project."
        : null;
    // Visitors can browse; creating, editing and deleting are for administrators only.
    var access = await HttpContext.AccessAsync();
    var canManage = access.HasAny(Perm.BuildingsCreate, Perm.BuildingsUpdate, Perm.BuildingsDelete);
    // Visitors (e.g. from a public project page) get the public layout rather than the admin sidebar.
    Layout = canManage ? "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml" : "~/Pages/Shared/_Layout.cshtml";
}

@section PageActions {
    <a asp-page="./Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list
    </a>
    @if (canManage)
    {
        <a mh-permission="buildings.update" asp-page="./Edit" asp-route-id="@Model.Building?.Id" class="btn btn-primary">
            <i class="bi bi-pencil" aria-hidden="true"></i> Edit building
        </a>
    }
}

@* Building details *@
<div class="card mb-4">
    <div class="card-header">
        <h2 class="mh-section-title"><i class="bi bi-building" aria-hidden="true"></i> Building Information</h2>
    </div>
    <div class="card-body">
        <dl class="mh-dl">
            <dt>Name</dt>
            <dd>@(Model.Building?.BuildingName ?? "N/A")</dd>

            <dt>Number of Floors</dt>
            <dd>@(Model.Building?.NumberOfFloors.ToString() ?? "N/A")</dd>

            <dt>Type</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Building?.BuildingType) ? "N/A" : BuildingOptions.TypeName(Model.Building.BuildingType))</dd>

            <dt>Construction Status</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Building?.ConstructionStatus) ? "N/A" : BuildingOptions.StatusName(Model.Building.ConstructionStatus))</dd>

            <dt>Associated Project</dt>
            <dd>
                @if (Model.Building?.Project != null)
                {
                    <a asp-page="/Projects/Details" asp-route-id="@Model.Building.Project.ProjectId">
                        @Model.Building.Project.ProjectName
                    </a>
                }
                else
                {
                    <span>N/A</span>
                }
            </dd>

            <dt>Created By</dt>
            <dd>@(Model.Building?.CreatedBy ?? "N/A")</dd>

            <dt>Created On</dt>
            <dd>@(Model.Building?.CreatedOn.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</dd>

            <dt>Updated By</dt>
            <dd>@(Model.Building?.UpdatedBy ?? "N/A")</dd>

            <dt>Updated On</dt>
            <dd>@(Model.Building?.UpdatedOn?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</dd>
        </dl>
    </div>
</div>

@* Building photos (gallery with lightbox) *@
<div class="card mb-4">
    <div class="card-header">
        <h2 class="mh-section-title"><i class="bi bi-images" aria-hidden="true"></i> Building Photos</h2>
    </div>
    @if (Model.Building?.Photos != null && Model.Building.Photos.Any())
    {
        <div class="card-body">
            <div class="gallery-container">
                @foreach (var photo in Model.Building.Photos)
                {
                    <a href="@photo.PhotoPath" class="gallery-item">
                        <img src="@photo.PhotoPath" alt="@(string.IsNullOrWhiteSpace(photo.Name) ? "Building photo" : photo.Name)" loading="lazy" />
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-image"></i></span>
            <h3>No photos yet</h3>
            <p>No photos available for this building yet.</p>
        </div>
    }
</div>

@* Houses in the building *@
<div class="card">
    <div class="card-header">
        <h2 class="mh-section-title"><i class="bi bi-house-door" aria-hidden="true"></i> Houses in this Building</h2>
    </div>
    @if (Model.Building?.Houses != null && Model.Building.Houses.Any())
    {
        <div class="card-body">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-4">
                @foreach (var house in Model.Building.Houses)
                {
                    <div class="col">
                        <a asp-page="/ApartmentHouses/Details" asp-route-id="@house.Id" class="card mh-media-card h-100 text-decoration-none">
                            <img src="@Url.Content("~/images/Villa1.jpg")" class="card-img-top" alt="@house.Title Image" loading="lazy" />
                            <div class="card-body">
                                <h3 class="h5 card-title mb-2">@house.Title</h3>
                                <ul class="list-unstyled small text-muted mb-0">
                                    <li><i class="bi bi-sort-numeric-up me-2" aria-hidden="true"></i>Floor: @house.FloorNumber</li>
                                    <li><i class="bi bi-arrows-fullscreen me-2" aria-hidden="true"></i>Area: @(house.Area > 0 ? house.Area.ToString("N0") + " m²" : "N/A")</li>
                                </ul>
                                <p class="fw-bold text-navy mt-2 mb-0">@RadiantHomes.Pages.ApartmentHouses.ApartmentHouseForm.Price(house.SalePrice, house.Currency)</p>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-house-door"></i></span>
            <h3>No houses yet</h3>
            <p>No houses associated with this building yet.</p>
            @if (canManage)
            {
                <a mh-permission="houses.create" class="btn btn-primary" asp-page="/ApartmentHouses/Create" asp-route-id="@Model.Building?.Id"><i class="bi bi-house-add" aria-hidden="true"></i> Register houses</a>
            }
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/simplelightbox/2.14.2/simple-lightbox.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        .gallery-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: .75rem; }
        .gallery-container .gallery-item { display: block; overflow: hidden; border-radius: var(--mh-radius-sm); background: var(--mh-surface-3); }
        .gallery-container .gallery-item img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform .2s ease; }
        .gallery-container .gallery-item:hover img { transform: scale(1.03); }
        @@media (min-width: 768px) {
            .gallery-container { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
        }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/simplelightbox/2.14.2/simple-lightbox.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var gallery = new SimpleLightbox('.gallery-container a', {
                animationSlide: true,
                disableScroll: true,
                history: false
            });
        });
    </script>
}
