@page
@model RadiantHomes.Pages.Buildings.IndexModel

@{
    ViewData["Title"] = "Buildings";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<div class="container-fluid px-3 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">🏢 Buildings List</h2>
        <a class="btn btn-success shadow-sm" asp-page="Create">
            <i class="bi bi-plus-circle me-1"></i> Create New Building
        </a>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-bordered table-hover align-middle text-nowrap">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Building[0].BuildingName)</th>
                    <th>@Html.DisplayNameFor(model => model.Building[0].NumberOfFloors)</th>
                    <th>@Html.DisplayNameFor(model => model.Building[0].BuildingType)</th>
                    <th>@Html.DisplayNameFor(model => model.Building[0].ConstructionStatus)</th>
                    <th>@Html.DisplayNameFor(model => model.Building[0].Project)</th>
                    <th>@Html.DisplayNameFor(model => model.Building[0].CreatedBy)</th>
                    <th>@Html.DisplayNameFor(model => model.Building[0].CreatedOn)</th>
                    <th>@Html.DisplayNameFor(model => model.Building[0].UpdatedBy)</th>
                    <th>@Html.DisplayNameFor(model => model.Building[0].UpdatedOn)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Building)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.BuildingName)</td>
                        <td>@Html.DisplayFor(modelItem => item.NumberOfFloors)</td>
                        <td>@Html.DisplayFor(modelItem => item.BuildingType)</td>
                        <td>@Html.DisplayFor(modelItem => item.ConstructionStatus)</td>
                        <td>@Html.DisplayFor(modelItem => item.Project.ProjectName)</td>
                        <td>@Html.DisplayFor(modelItem => item.CreatedBy)</td>
                        <td>@item.CreatedOn.ToString("yyyy-MM-dd")</td>
                        <td>@Html.DisplayFor(modelItem => item.UpdatedBy)</td>
                        <td>@item.UpdatedOn?.ToString("yyyy-MM-dd")</td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <a class="btn btn-outline-primary" asp-page="./Edit" asp-route-id="@item.Id">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a class="btn btn-outline-info" asp-page="./Details" asp-route-id="@item.Id">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="btn btn-outline-danger" asp-page="./Delete" asp-route-id="@item.Id">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
