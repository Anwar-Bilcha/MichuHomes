@page
@model RadiantHomes.Pages.Buildings.IndexModel

@{
    ViewData["Title"] = "Buildings";
    var hasRows = Model.Building is not null && Model.Building.Any();
    // Visitors can browse; creating, editing and deleting are for administrators only.
    var access = await HttpContext.AccessAsync();
    var canManage = access.HasAny(Perm.BuildingsCreate, Perm.BuildingsUpdate, Perm.BuildingsDelete);
    // Visitors (e.g. from a public project page) get the public layout rather than the admin sidebar.
    Layout = canManage ? "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml" : "~/Pages/Shared/_Layout.cshtml";
}

@if (canManage)
{
    @section PageActions {
        <a mh-permission="buildings.create" class="btn btn-primary" asp-page="Create">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New building
        </a>
    }
}

@* Results of the previous action are shown as toasts by _FlashMessages. *@

<div class="card">
    @if (Model.NoCompany)
    {
        <partial name="~/Areas/HousingCompanyAdmin/Pages/_NoCompanyNotice.cshtml" />
    }
    else if (!hasRows)
    {
        <div class="mh-empty">
            <span class="mh-empty-icon" aria-hidden="true"><i class="bi bi-buildings"></i></span>
            <h2>No buildings yet</h2>
            <p>Buildings appear here once they are added to a project.</p>
            @if (canManage)
            {
                <a mh-permission="buildings.create" class="btn btn-primary" asp-page="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> New building</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-nowrap">
                <thead>
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(model => model.Building[0].BuildingName)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Building[0].NumberOfFloors)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Building[0].BuildingType)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Building[0].ConstructionStatus)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Building[0].Project)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Building[0].CreatedBy)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Building[0].CreatedOn)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Building[0].UpdatedBy)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Building[0].UpdatedOn)</th>
                        <th scope="col" class="text-end position-relative"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Building!)
                    {
                        <tr>
                            <td class="fw-semibold">@Html.DisplayFor(modelItem => item.BuildingName)</td>
                            <td>@Html.DisplayFor(modelItem => item.NumberOfFloors)</td>
                            <td>@BuildingOptions.TypeName(item.BuildingType)</td>
                            <td>@BuildingOptions.StatusName(item.ConstructionStatus)</td>
                            <td>@Html.DisplayFor(modelItem => item.Project.ProjectName)</td>
                            <td>@Html.DisplayFor(modelItem => item.CreatedBy)</td>
                            <td>@item.CreatedOn.ToString("yyyy-MM-dd")</td>
                            <td>@Html.DisplayFor(modelItem => item.UpdatedBy)</td>
                            <td>@item.UpdatedOn?.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <div class="mh-row-actions">
                                    <a class="btn btn-sm btn-outline-secondary btn-icon" asp-page="./Details" asp-route-id="@item.Id" title="View details" aria-label="View details"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                    @if (canManage)
                                    {
                                        <a mh-permission="buildings.update" class="btn btn-sm btn-outline-primary btn-icon" asp-page="./Edit" asp-route-id="@item.Id" title="Edit" aria-label="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                        <a mh-permission="buildings.delete" class="btn btn-sm btn-outline-danger btn-icon" asp-page="./Delete" asp-route-id="@item.Id" title="Delete" aria-label="Delete"><i class="bi bi-trash" aria-hidden="true"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
