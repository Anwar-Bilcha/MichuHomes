@page
@model RadiantHomes.Pages.Buildings.DeleteModel

@{
    ViewData["Title"] = "Delete building";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

<div class="card mh-confirm">
    <div class="card-header">
        <h2 class="mh-section-title text-reset"><i class="bi bi-exclamation-triangle text-reset" aria-hidden="true"></i> Are you sure you want to delete this building?</h2>
    </div>
    <div class="card-body">
        <p class="text-muted">This permanently removes the record below. It can't be undone.</p>
        <dl class="mh-dl">
            <dt>@Html.DisplayNameFor(model => model.Building.BuildingName)</dt>
            <dd>@Html.DisplayFor(model => model.Building.BuildingName)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.NumberOfFloors)</dt>
            <dd>@Html.DisplayFor(model => model.Building.NumberOfFloors)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.BuildingType)</dt>
            <dd>@BuildingOptions.TypeName(Model.Building.BuildingType)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.ConstructionStatus)</dt>
            <dd>@BuildingOptions.StatusName(Model.Building.ConstructionStatus)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.Project)</dt>
            <dd>@Html.DisplayFor(model => model.Building.Project!.ProjectName)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.CreatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.Building.CreatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.CreatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.Building.CreatedOn)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.UpdatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.Building.UpdatedBy)</dd>
            <dt>@Html.DisplayNameFor(model => model.Building.UpdatedOn)</dt>
            <dd>@Html.DisplayFor(model => model.Building.UpdatedOn)</dd>
        </dl>

        <form method="post" class="mh-form-actions">
            <input type="hidden" asp-for="Building.Id" />
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash" aria-hidden="true"></i> Delete building</button>
        </form>
    </div>
</div>
