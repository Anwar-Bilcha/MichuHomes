@page
@model RadiantHomes.Pages.Buildings.EditModel
@{
    ViewData["Title"] = "Edit building";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
}

@section PageActions {
    <a asp-page="/ApartmentHouses/Create" asp-route-id="@Model.Building.Id" class="btn btn-outline-primary">
        <i class="bi bi-house-add" aria-hidden="true"></i> Register houses
    </a>
}

<form method="post" class="card needs-validation" novalidate>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        @if (!string.IsNullOrEmpty(Model.UnknownValuesNote))
        {
            <div class="alert alert-warning" role="status"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i> @Model.UnknownValuesNote</div>
        }
        <input type="hidden" asp-for="Building.Id" />

        <div class="mh-fieldset">
            <h2 class="mh-fieldset-title">Building</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Building.ProjectId" class="form-label">Project</label>
                    <select asp-for="Building.ProjectId" class="form-select" asp-items="ViewBag.ProjectId">
                        <option value="">-- Select project --</option>
                    </select>
                    <span asp-validation-for="Building.ProjectId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Building.BuildingName" class="form-label">Building Name</label>
                    <input asp-for="Building.BuildingName" class="form-control" />
                    <span asp-validation-for="Building.BuildingName" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Building.NumberOfFloors" class="form-label">Floors</label>
                    <input asp-for="Building.NumberOfFloors" class="form-control" type="number" min="1" max="200" step="1"
                           data-val-range="Number of floors must be between 1 and 200." data-val-range-min="1" data-val-range-max="200" />
                    <span asp-validation-for="Building.NumberOfFloors" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Building.BuildingType" class="form-label">Type</label>
                    <select asp-for="Building.BuildingType" class="form-select" asp-items="@(BuildingOptions.Items<BuildingTypes>())">
                        <option value="">-- Select type --</option>
                    </select>
                    <span asp-validation-for="Building.BuildingType" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Building.ConstructionStatus" class="form-label">Status</label>
                    <select asp-for="Building.ConstructionStatus" class="form-select" asp-items="@(BuildingOptions.Items<ConstructionStatuses>())">
                        <option value="">-- Select status --</option>
                    </select>
                    <span asp-validation-for="Building.ConstructionStatus" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mh-form-actions">
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save changes</button>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
