@page
@model RadiantHomes.Pages.Buildings.CreateModel

@{
    ViewData["Title"] = "New building";
    ViewData["Subtitle"] = "Add one building by hand, or many at once from an Excel file.";
    ViewData["PageWidth"] = "narrow";
    Layout = "~/Pages/Shared/_HousingCompanyAdminLayout.cshtml";
    var showUpload = Model.UploadErrors.Count > 0; // reopen the Excel tab to show what was wrong with the file
}

@section PageActions {
    <a asp-page="Index" class="btn btn-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list</a>
}

<!-- Tabs for Manual vs Bulk Upload -->
<ul class="nav nav-tabs mb-4" id="buildingTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(showUpload ? null : "active")" id="manual-tab" data-bs-toggle="tab" data-bs-target="#manual" type="button" role="tab" aria-controls="manual" aria-selected="@(showUpload ? "false" : "true")">
            <i class="bi bi-pencil-square me-1" aria-hidden="true"></i> Manual Entry
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(showUpload ? "active" : null)" id="bulk-tab" data-bs-toggle="tab" data-bs-target="#bulk" type="button" role="tab" aria-controls="bulk" aria-selected="@(showUpload ? "true" : "false")">
            <i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i> Bulk Upload (Excel)
        </button>
    </li>
</ul>

<div class="tab-content" id="buildingTabContent">
    <!-- Manual Entry Form -->
    <div class="tab-pane fade @(showUpload ? null : "show active")" id="manual" role="tabpanel" aria-labelledby="manual-tab">
        <form method="post" class="card needs-validation" novalidate>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mh-fieldset">
                    <h2 class="mh-fieldset-title">Building</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Building.ProjectId" class="form-label"></label>
                            <select asp-for="Building.ProjectId" class="form-select" asp-items="ViewBag.ProjectId">
                                <option value="">-- Select project --</option>
                            </select>
                            <span asp-validation-for="Building.ProjectId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Building.BuildingName" class="form-label"></label>
                            <input asp-for="Building.BuildingName" class="form-control" />
                            <span asp-validation-for="Building.BuildingName" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Building.NumberOfFloors" class="form-label"></label>
                            <input type="number" asp-for="Building.NumberOfFloors" class="form-control" min="1" max="200" step="1"
                                   data-val-range="Number of floors must be between 1 and 200." data-val-range-min="1" data-val-range-max="200" />
                            <span asp-validation-for="Building.NumberOfFloors" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Building.BuildingType" class="form-label"></label>
                            <select asp-for="Building.BuildingType" class="form-select" asp-items="@(BuildingOptions.Items<BuildingTypes>())">
                                <option value="">-- Select type --</option>
                            </select>
                            <span asp-validation-for="Building.BuildingType" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Building.ConstructionStatus" class="form-label"></label>
                            <select asp-for="Building.ConstructionStatus" class="form-select" asp-items="@(BuildingOptions.Items<ConstructionStatuses>())">
                                <option value="">-- Select status --</option>
                            </select>
                            <span asp-validation-for="Building.ConstructionStatus" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mh-form-actions">
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save building</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Bulk Upload Tab -->
    <div class="tab-pane fade @(showUpload ? "show active" : null)" id="bulk" role="tabpanel" aria-labelledby="bulk-tab">
        <div class="card">
            <div class="card-header">
                <h2 class="mh-section-title"><i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i> Bulk Upload Buildings</h2>
            </div>
            <div class="card-body">
                <p class="text-muted mb-2">Follow these steps to upload buildings in bulk:</p>
                <ol class="mb-4">
                    <li>Click the <strong>Download Template</strong> button to get the Excel file format.</li>
                    <li>Fill in building details in the template. Required fields: Project, Building Name, Floors, etc.</li>
                    <li>Save the file (must be <code>.xlsx</code> format).</li>
                    <li>Upload the completed file using the form below.</li>
                    <li>Click <strong>Upload</strong> to process the buildings.</li>
                </ol>

                @if (showUpload)
                {
                    <div class="alert alert-danger" role="alert">
                        <p class="mb-2"><strong>Nothing was uploaded.</strong> Please correct the file and upload it again:</p>
                        <ul class="mb-0">
                            @foreach (var error in Model.UploadErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }
                <form method="post" enctype="multipart/form-data" asp-page-handler="UploadBuildings">
                    @Html.AntiForgeryToken()
                    <label asp-for="file" class="form-label">Select Excel File</label>
                    <input type="file" name="file" asp-for="file" class="form-control" accept=".xlsx" required />

                    <div class="mh-form-actions">
                        <a class="btn btn-outline-primary me-auto" asp-page-handler="DownloadTemplate" data-no-loader><i class="bi bi-download" aria-hidden="true"></i> Download Template</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-upload" aria-hidden="true"></i> Upload</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
