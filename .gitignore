## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
out/
bin/
obj/

# Uncomment if you have tasks that create the project's static files outside wwwroot
#wwwroot/lib/

# Auto-generated files
*.log
*.tlog
*.cache
*.dbmdl
*.pidb
*.svclog
*.ide

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# DotCover
*.dotCover

# NCrunch
*.ncrunch*
.*crunch*.local.xml

# Sonarqube
.sonar/

# Dotnet tools
.tool/

# NuGet
*.nupkg
# The packages folder can be ignored because of PackageReference
**/packages/*
!**/packages/build/
!**/packages/repositories.config

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# VS for Mac
.vscode/
.idea/
.vs/
*.csproj.user

# macOS
.DS_Store
/node_modules
# Logs
*.log

# Others
*.vspscc
*.vssscc

# Application logs (Serilog writes RadiantHomes/Logs/log-YYYYMMDD.txt)
RadiantHomes/Logs/

# Server-only settings with real values (template: RadiantHomes/appsettings.Production.example.json)
RadiantHomes/appsettings.Production.json

# Data protection keys and other runtime data (Program.cs keeps the keys in App_Data/keys)
RadiantHomes/App_Data/
